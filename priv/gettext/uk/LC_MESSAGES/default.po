msgid "%{provider} secret cannot be only whitespace"
msgstr "Секрет %{provider} не може складатися лише з пробілів"

#: lib/phoenix_kit/users/oauth_config.ex:354
msgid "%{provider} secret looks too short to be real (%{length} characters, expected at least %{min}) — double-check you copied the whole value"
msgstr "Секрет %{provider} здається занадто коротким для справжнього (%{length} символів, очікується щонайменше %{min}) — перевірте, чи скопійовано значення повністю"

