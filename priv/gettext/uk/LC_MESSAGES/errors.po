#: lib/phoenix_kit/users/auth/user.ex:763
#, elixir-autogen, elixir-format
msgid "cannot reference self"
msgstr "не може посилатися на себе"

#: lib/phoenix_kit/users/auth/user.ex:448
#, elixir-autogen, elixir-format
msgid "did not change"
msgstr "не змінилося"

#: lib/phoenix_kit/users/auth/user.ex:468
#, elixir-autogen, elixir-format
msgid "does not match password"
msgstr "не збігається з паролем"

#: lib/phoenix_kit/users/auth/user.ex:568
#, elixir-autogen, elixir-format
msgid "is not valid"
msgstr "недійсне"

#: lib/phoenix_kit/users/auth/user.ex:1247
#, elixir-autogen, elixir-format
msgid "must be a timezone identifier"
msgstr "має бути ідентифікатором часового поясу"

#: lib/phoenix_kit/users/auth/user.ex:1265
#, elixir-autogen, elixir-format
msgid "must be a timezone identifier like Europe/Warsaw"
msgstr "має бути ідентифікатором часового поясу, наприклад Europe/Warsaw"

#: lib/phoenix_kit/users/auth/user.ex:1199
#, elixir-autogen, elixir-format
msgid "must be a valid country code"
msgstr "має бути дійсним кодом країни"

#: lib/phoenix_kit/users/auth/user.ex:300
#, elixir-autogen, elixir-format
msgid "must be a valid email address"
msgstr "має бути дійсною адресою електронної пошти"

#: lib/phoenix_kit/users/auth/user.ex:700
#: lib/phoenix_kit/users/auth/user.ex:1289
#, elixir-autogen, elixir-format
msgid "must be a valid map"
msgstr "має бути дійсним словником"

#: lib/phoenix_kit/users/auth/user.ex:581
#, elixir-autogen, elixir-format
msgid "must be different from current password"
msgstr "має відрізнятися від поточного пароля"

#: lib/phoenix_kit/users/auth/user.ex:389
#, elixir-autogen, elixir-format
msgid "must contain at least one digit"
msgstr "має містити щонайменше одну цифру"

#: lib/phoenix_kit/users/auth/user.ex:380
#, elixir-autogen, elixir-format
msgid "must contain at least one lowercase character"
msgstr "має містити щонайменше одну малу літеру"

#: lib/phoenix_kit/users/auth/user.ex:371
#, elixir-autogen, elixir-format
msgid "must contain at least one uppercase character"
msgstr "має містити щонайменше одну велику літеру"

#: lib/phoenix_kit/users/auth/user.ex:254
#: lib/phoenix_kit/users/auth/user.ex:314
#, elixir-autogen, elixir-format
msgid "must have the @ sign and no spaces"
msgstr "має містити символ @ і не містити пробілів"

#: lib/phoenix_kit/users/auth/user.ex:1012
#, elixir-autogen, elixir-format
msgid "must start with a letter and contain only letters, numbers, and underscores"
msgstr "має починатися з літери та містити лише літери, цифри та підкреслення"

#: lib/phoenix_kit/users/auth.ex:483
#, elixir-autogen, elixir-format
msgid "This email domain cannot receive mail. Please check the address."
msgstr "Цей поштовий домен не може приймати листи. Перевірте адресу."

#: lib/phoenix_kit/users/auth.ex:494
#, elixir-autogen, elixir-format
msgid "Too many registration attempts. Please try again later."
msgstr "Забагато спроб реєстрації. Спробуйте ще раз пізніше."
