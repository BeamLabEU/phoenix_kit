<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={gettext("Media")}
  page_section={gettext("Settings")}
  page_section_path={PhoenixKit.Utils.Routes.path("/admin/settings")}
  page_subtitle={gettext("Storage buckets and file processing")}
  current_path={@current_path}
  current_locale={@current_locale}
  project_title={@project_title}
>
  <div class="px-4 py-8">
    <%!-- Missing external tools — one line, not tab-scoped; the details
         are on the External libraries tab. --%>
    <.missing_tools_banner tools={missing_tools(@external_tools, @tile_generation_enabled)} />

    <.nav_tabs
      active_tab={@active_tab}
      variant={:border}
      tabs={UrlTabs.patch_links(tabs(), "/admin/settings/media")}
    />

    <div id="media-tab-buckets" class={@active_tab != "buckets" && "hidden"}>
      <%!-- Media Buckets --%>
      <div class="card bg-base-100 shadow-xl mb-6 mt-6">
        <div class="card-body">
          <div class="flex justify-between items-center mb-4">
            <h2 class="card-title text-lg">
              <.icon name="hero-inbox-stack" class="w-6 h-6 mr-2" /> {gettext("Media Buckets")}
            </h2>
            <.link
              navigate={PhoenixKit.Utils.Routes.path("/admin/settings/media/buckets/new")}
              class="btn btn-primary"
            >
              <.icon name="hero-plus" class="w-4 h-4 mr-1" /> {gettext("Add Bucket")}
            </.link>
          </div>

          <%= if Enum.empty?(@buckets) do %>
            <div class="alert alert-warning">
              <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
              <div>
                <h3 class="font-bold">{gettext("No Media Buckets Configured")}</h3>
                <p class="text-sm">
                  {gettext(
                    "You need to create at least one media bucket before files can be uploaded."
                  )}
                  {gettext(
                    "Buckets can be local directories or cloud storage providers (AWS S3, Backblaze B2, Cloudflare R2)."
                  )}
                </p>
                <div class="mt-3">
                  <.link
                    navigate={PhoenixKit.Utils.Routes.path("/admin/settings/media/buckets/new")}
                    class="btn btn-warning btn-sm"
                  >
                    <.icon name="hero-plus" class="w-4 h-4 mr-1" /> {gettext(
                      "Create Your First Bucket"
                    )}
                  </.link>
                </div>
              </div>
            </div>
          <% else %>
            <%= if legacy_bucket_count(@buckets) > 0 do %>
              <div id="legacy-keys-notice" class="alert alert-warning mb-4">
                <.icon name="hero-key" class="w-5 h-5" />
                <div class="flex-1">
                  <p class="font-semibold">
                    {ngettext(
                      "%{count} bucket uses keys saved on the bucket itself.",
                      "%{count} buckets use keys saved on the bucket itself.",
                      legacy_bucket_count(@buckets)
                    )}
                  </p>
                  <p class="text-sm">
                    {gettext(
                      "They keep working. Move the keys into an integration to rotate or revoke them in one place."
                    )}
                  </p>
                </div>
                <%= if can_manage_integrations?(assigns) do %>
                  <button
                    type="button"
                    phx-click="move_all_credentials"
                    data-confirm={
                      gettext("Move the keys of every such bucket into integrations?")
                    }
                    class="btn btn-sm btn-warning"
                  >
                    {gettext("Move all to integrations")}
                  </button>
                <% end %>
              </div>
            <% end %>
            <.table_default
              id="buckets-table"
              variant="zebra"
              toggleable={true}
              items={@buckets}
              card_title={fn bucket -> bucket.name end}
              card_fields={
                fn bucket ->
                  [
                    %{
                      label: gettext("Type"),
                      value:
                        [bucket_type(bucket), bucket_service(bucket, @bucket_connections)]
                        |> Enum.reject(&is_nil/1)
                        |> Enum.join(" · ")
                    },
                    %{
                      label: gettext("Priority"),
                      value:
                        if(bucket.priority == 0,
                          do: gettext("Random"),
                          else: to_string(bucket.priority)
                        )
                    },
                    %{
                      label: gettext("Used by"),
                      value:
                        case Map.get(@bucket_usage, to_string(bucket.uuid), []) do
                          [] -> gettext("Not used")
                          usage -> BucketUsage.used_by_text(usage)
                        end
                    },
                    %{
                      label: gettext("Files"),
                      value: "#{totals_for(@bucket_totals, bucket).files}"
                    },
                    %{
                      label: gettext("Objects"),
                      value: "#{totals_for(@bucket_totals, bucket).objects}"
                    },
                    %{
                      label: gettext("Size"),
                      value: format_bytes(totals_for(@bucket_totals, bucket).bytes)
                    },
                    %{
                      label: gettext("Status"),
                      value: if(bucket.enabled, do: gettext("Enabled"), else: gettext("Disabled"))
                    }
                  ]
                end
              }
            >
              <.table_default_header>
                <.table_default_row>
                  <.table_default_header_cell>{gettext("Name")}</.table_default_header_cell>
                  <.table_default_header_cell>{gettext("Type")}</.table_default_header_cell>
                  <.table_default_header_cell>{gettext("Priority")}</.table_default_header_cell>
                  <.table_default_header_cell>{gettext("Used by")}</.table_default_header_cell>
                  <.table_default_header_cell class="text-right">
                    {gettext("Files")}
                  </.table_default_header_cell>
                  <.table_default_header_cell class="text-right">
                    {gettext("Objects")}
                  </.table_default_header_cell>
                  <.table_default_header_cell class="text-right">
                    {gettext("Size")}
                  </.table_default_header_cell>
                  <.table_default_header_cell>{gettext("Status")}</.table_default_header_cell>
                  <.table_default_header_cell>{gettext("Actions")}</.table_default_header_cell>
                </.table_default_row>
              </.table_default_header>
              <.table_default_body>
                <%= for bucket <- @buckets do %>
                  <.table_default_row>
                    <.table_default_cell>
                      <div class="flex items-center gap-2">
                        <%= case bucket.provider do %>
                          <% "local" -> %>
                            <.icon name="hero-folder" class="w-5 h-5 text-primary" />
                          <% "s3" -> %>
                            <.icon name="hero-cloud" class="w-5 h-5 text-warning" />
                          <% "b2" -> %>
                            <.icon name="hero-cube" class="w-5 h-5 text-info" />
                          <% "r2" -> %>
                            <.icon name="hero-cloud-arrow-up" class="w-5 h-5 text-accent" />
                          <% "tigris" -> %>
                            <.icon name="hero-globe-alt" class="w-5 h-5 text-secondary" />
                          <% _ -> %>
                            <.icon name="hero-server" class="w-5 h-5 text-base-content/50" />
                        <% end %>
                        <div>
                          <.pk_link
                            navigate={"/admin/settings/media/buckets/#{bucket.uuid}"}
                            class="font-bold link link-hover"
                          >
                            {bucket.name}
                          </.pk_link>
                          <div class="text-xs text-base-content/60 font-mono">
                            {bucket_location(bucket)}
                          </div>
                        </div>
                      </div>
                    </.table_default_cell>
                    <.table_default_cell>
                      <span class="badge badge-ghost badge-sm h-auto">
                        {bucket_type(bucket)}
                      </span>
                      <span
                        :if={bucket_service(bucket, @bucket_connections)}
                        class="badge badge-outline badge-sm h-auto"
                      >
                        {bucket_service(bucket, @bucket_connections)}
                      </span>
                      <%= if BucketCredentials.legacy?(bucket) do %>
                        <span class="badge badge-warning badge-soft badge-sm h-auto">
                          {gettext("Keys on bucket")}
                        </span>
                      <% end %>
                    </.table_default_cell>
                    <.table_default_cell>
                      <%= if bucket.priority == 0 do %>
                        <span class="text-xs text-base-content/60">{gettext("Random")} (0)</span>
                      <% else %>
                        <span class="font-semibold">{bucket.priority}</span>
                      <% end %>
                    </.table_default_cell>
                    <.table_default_cell>
                      <BucketUsage.usage_cell usage={
                        Map.get(@bucket_usage, to_string(bucket.uuid), [])
                      } />
                    </.table_default_cell>
                    <% totals = totals_for(@bucket_totals, bucket) %>
                    <.table_default_cell class="text-right tabular-nums">
                      {totals.files}
                    </.table_default_cell>
                    <.table_default_cell class="text-right tabular-nums">
                      {totals.objects}
                    </.table_default_cell>
                    <.table_default_cell class="text-right tabular-nums">
                      {format_bytes(totals.bytes)}
                    </.table_default_cell>
                    <.table_default_cell>
                      <%= if bucket.enabled do %>
                        <span class="badge badge-success badge-sm h-auto">
                          {gettext("Enabled")}
                        </span>
                      <% else %>
                        <span class="badge badge-error badge-sm h-auto">
                          {gettext("Disabled")}
                        </span>
                      <% end %>
                    </.table_default_cell>
                    <.table_default_cell>
                      <.table_row_menu
                        id={"bucket-menu-#{bucket.uuid}"}
                        label={gettext("Bucket actions")}
                      >
                        <.table_row_menu_link
                          navigate={
                            PhoenixKit.Utils.Routes.path(
                              "/admin/settings/media/buckets/#{bucket.uuid}"
                            )
                          }
                          icon="hero-eye"
                          label={gettext("Details")}
                        />
                        <.table_row_menu_link
                          navigate={
                            PhoenixKit.Utils.Routes.path(
                              "/admin/settings/media/buckets/#{bucket.uuid}/edit"
                            )
                          }
                          icon="hero-pencil"
                          label={gettext("Edit bucket")}
                        />
                        <.table_row_menu_button
                          phx-click="toggle_bucket"
                          phx-value-id={bucket.uuid}
                          icon={if bucket.enabled, do: "hero-eye-slash", else: "hero-eye"}
                          label={
                            if bucket.enabled, do: gettext("Disable"), else: gettext("Enable")
                          }
                        />
                        <.table_row_menu_button
                          phx-click="delete_bucket"
                          phx-value-id={bucket.uuid}
                          data-confirm={gettext("Delete bucket \"%{name}\"?", name: bucket.name)}
                          icon="hero-trash"
                          label={gettext("Delete bucket")}
                          class="text-error"
                        />
                      </.table_row_menu>
                    </.table_default_cell>
                  </.table_default_row>
                <% end %>
              </.table_default_body>

              <:card_actions :let={bucket}>
                <.link
                  navigate={
                    PhoenixKit.Utils.Routes.path("/admin/settings/media/buckets/#{bucket.uuid}")
                  }
                  class="btn btn-xs btn-outline"
                >
                  <.icon name="hero-eye" class="w-3 h-3" /> {gettext("Details")}
                </.link>
                <.link
                  navigate={
                    PhoenixKit.Utils.Routes.path(
                      "/admin/settings/media/buckets/#{bucket.uuid}/edit"
                    )
                  }
                  class="btn btn-xs btn-outline btn-info"
                >
                  <.icon name="hero-pencil" class="w-3 h-3" /> {gettext("Edit")}
                </.link>
                <button
                  phx-click="toggle_bucket"
                  phx-value-id={bucket.uuid}
                  class="btn btn-xs btn-outline"
                >
                  {if bucket.enabled, do: gettext("Disable"), else: gettext("Enable")}
                </button>
                <button
                  phx-click="delete_bucket"
                  phx-value-id={bucket.uuid}
                  data-confirm={gettext("Delete bucket \"%{name}\"?", name: bucket.name)}
                  class="btn btn-xs btn-outline btn-error"
                >
                  <.icon name="hero-trash" class="w-3 h-3" /> {gettext("Delete")}
                </button>
              </:card_actions>
            </.table_default>

            <div class="stats stats-vertical lg:stats-horizontal shadow mt-6">
              <div class="stat">
                <div class="stat-title">{gettext("Total Buckets")}</div>
                <div class="stat-value text-2xl">{length(@buckets)}</div>
                <div class="stat-desc">{gettext("Configured media locations")}</div>
              </div>

              <% enabled_count = Enum.count(@buckets, & &1.enabled) %>
              <% in_profile_count =
                Enum.count(@buckets, &Map.has_key?(@bucket_usage, to_string(&1.uuid))) %>
              <div class="stat">
                <div class="stat-title">{gettext("Enabled")}</div>
                <div class="stat-value text-2xl">{enabled_count}</div>
                <div class="stat-desc">
                  {gettext("%{count} disabled", count: length(@buckets) - enabled_count)}
                </div>
              </div>

              <div class="stat">
                <div class="stat-title">{gettext("In a storage profile")}</div>
                <div class="stat-value text-2xl text-success">{in_profile_count}</div>
                <div class="stat-desc">
                  {gettext("%{count} in none, so they store and serve nothing",
                    count: length(@buckets) - in_profile_count
                  )}
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div id="media-tab-profiles" class={@active_tab != "profiles" && "hidden"}>
      <.live_component
        module={PhoenixKitWeb.Live.Modules.Storage.ProfilesComponent}
        id="media-profiles"
        scope={assigns[:phoenix_kit_current_scope]}
      />
    </div>

    <div id="media-tab-history" class={@active_tab != "history" && "hidden"}>
      <.live_component
        module={PhoenixKitWeb.Live.Modules.Storage.HistoryComponent}
        id="media-history"
        scope={assigns[:phoenix_kit_current_scope]}
        active={@active_tab == "history"}
      />
    </div>

    <div id="media-tab-libraries" class={@active_tab != "libraries" && "hidden"}>
      <.live_component
        module={PhoenixKitWeb.Live.Modules.Storage.LibrariesComponent}
        id="media-libraries"
        scope={assigns[:phoenix_kit_current_scope]}
      />
    </div>

    <div id="media-tab-configuration" class={@active_tab != "configuration" && "hidden"}>
      <%!-- Media Configuration --%>
      <div class="card bg-base-100 shadow-xl mb-6 mt-6">
        <div class="card-body">
          <h2 class="card-title text-lg mb-4">
            <.icon name="hero-cog-6-tooth" class="w-6 h-6 mr-2" /> {gettext("Media Configuration")}
          </h2>

          <.form
            for={%{}}
            id="storage-media-config-form"
            phx-change="update_storage_form"
            class="grid grid-cols-1 md:grid-cols-2 gap-6"
          >
            <%!-- Copies, sizes and tiles are set where they apply, not here. --%>
            <div class="md:col-span-2 rounded-box bg-base-200 p-4 text-sm">
              <p class="font-semibold">
                {gettext("Copies, sizes and tiles are set per library")}
              </p>
              <ul class="mt-1 list-disc pl-5 text-base-content/70">
                <li>
                  {gettext("How many copies of each file are kept, and where:")}
                  <.link
                    patch={PhoenixKit.Utils.Routes.path("/admin/settings/media?tab=profiles")}
                    class="link link-primary"
                  >
                    {gettext("Storage profiles")}
                  </.link>
                </li>
                <li>
                  {gettext("Which sizes are made automatically, and whether deep-zoom tiles are:")}
                  <.link
                    navigate={PhoenixKit.Utils.Routes.path("/admin/settings/media/dimensions")}
                    class="link link-primary"
                  >
                    {gettext("Variant sets")}
                  </.link>
                </li>
                <li>
                  {gettext("Which profile and variant set a library uses:")}
                  <.link
                    patch={PhoenixKit.Utils.Routes.path("/admin/settings/media?tab=libraries")}
                    class="link link-primary"
                  >
                    {gettext("Libraries")}
                  </.link>
                </li>
              </ul>
            </div>

            <%!-- Annotated Thumbnails --%>
            <div class="fieldset">
              <.checkbox
                name="form_annotated_thumbnails_enabled"
                checked={@form_annotated_thumbnails_enabled}
                phx-click="toggle_form_annotated_thumbnails"
                label={gettext("Annotated Thumbnails")}
              >
                <:description>
                  {gettext(
                    "Bake Etcher annotation shapes (rectangles, marker strokes, etc.) into a file's grid thumbnail, regenerated in the background when annotations change. With this off the grid shows the plain thumbnail and no annotated variant is generated. ImageMagick is required when enabled."
                  )}
                  {gettext(
                    "This is the site default; a library can choose otherwise on the Libraries tab."
                  )}
                </:description>
              </.checkbox>
            </div>

            <%!-- Image Editing --%>
            <div class="fieldset">
              <div class="mb-2">
                <span class="fieldset-legend font-semibold">{gettext("Image Editing")}</span>
                <span class="block text-xs text-base-content/60">
                  {gettext(
                    "What saving an edited image (crop, turn, redaction…) does with the original."
                  )}
                </span>
              </div>
              <label class="label cursor-pointer justify-start gap-3 py-1">
                <input
                  type="radio"
                  name="form_image_edit_mode"
                  value="keep_original"
                  checked={@form_image_edit_mode == "keep_original"}
                  class="radio radio-sm"
                />
                <span class="flex flex-col">
                  <span class="text-sm">{gettext("Keep the original (recommended)")}</span>
                  <span class="text-xs text-base-content/60 whitespace-normal">
                    {gettext(
                      "The unedited image is kept privately, so an edit can be changed or undone. Owners can delete it themselves."
                    )}
                  </span>
                </span>
              </label>
              <label class="label cursor-pointer justify-start gap-3 py-1">
                <input
                  type="radio"
                  name="form_image_edit_mode"
                  value="replace_original"
                  checked={@form_image_edit_mode == "replace_original"}
                  class="radio radio-sm"
                />
                <span class="flex flex-col">
                  <span class="text-sm">{gettext("Replace the original")}</span>
                  <span class="text-xs text-base-content/60 whitespace-normal">
                    {gettext(
                      "Every save overwrites the image for good. Nothing can be undone, and redacted areas are gone from storage."
                    )}
                  </span>
                </span>
              </label>
            </div>

            <%!-- Max Upload Size --%>
            <div class="fieldset">
              <div class="mb-2">
                <span class="fieldset-legend font-semibold">{gettext("Max Upload Size (MB)")}</span>
                <span class="block text-xs text-base-content/60">
                  {gettext("Maximum file size allowed per upload")}
                </span>
              </div>
              <.input
                type="number"
                name="form_max_upload_size_mb"
                value={@form_max_upload_size_mb}
                min="1"
              />
              <p class="text-xs text-base-content/70 mt-1">
                {gettext("Current limit: %{size} MB", size: @form_max_upload_size_mb)}
              </p>
            </div>
          </.form>

          <%!-- Apply Button --%>
          <% storage_form_clean =
            @form_annotated_thumbnails_enabled == @annotated_thumbnails_enabled and
              @form_image_edit_mode == @image_edit_mode and
              @form_max_upload_size_mb == @max_upload_size_mb %>
          <div class="fieldset mt-4">
            <button
              type="button"
              phx-click="apply_storage_settings"
              disabled={storage_form_clean}
              phx-disable-with={gettext("Applying...")}
              class="btn btn-primary"
            >
              <.icon name="hero-check" class="w-4 h-4 mr-2" /> {gettext("Apply Changes")}
            </button>
            <span class="fieldset-label text-xs ml-2">
              <%= if storage_form_clean do %>
                {gettext("No changes to apply")}
              <% else %>
                {gettext("Changes will be saved immediately")}
              <% end %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div id="media-tab-tools" class={@active_tab != "tools" && "hidden"}>
      <div class="card bg-base-100 shadow-xl mb-6 mt-6">
        <div class="card-body">
          <%!--
          Each action is wrapped in a daisyUI tooltip (rather than putting the
          tooltip on the button) so the hover description also works on the
          disabled "Media Stats" button — a disabled button has
          `pointer-events: none` and would otherwise swallow hover. Each button
          also carries a trailing info icon as the visible "what does this do?"
          affordance.
        --%>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <%!-- Variant sets --%>
            <div
              class="tooltip tooltip-bottom"
              data-tip={
                gettext(
                  "Create and edit variant sets: the image and video sizes each library's uploads get."
                )
              }
            >
              <.link
                navigate={PhoenixKit.Utils.Routes.path("/admin/settings/media/dimensions")}
                class="btn btn-outline w-full"
              >
                <.icon name="hero-photo" class="w-4 h-4 mr-2" /> {gettext("Variant sets")}
                <.icon name="hero-information-circle" class="w-4 h-4 ml-1 opacity-50" />
              </.link>
            </div>

            <%!-- Media Stats (coming soon) --%>
            <div
              class="tooltip tooltip-bottom"
              data-tip={gettext("View storage usage and media statistics. Coming soon.")}
            >
              <button class="btn btn-outline w-full" disabled>
                <.icon name="hero-chart-bar" class="w-4 h-4 mr-2" /> {gettext("Media Stats")}
                <span class="badge badge-xs ml-1">{gettext("Soon")}</span>
                <.icon name="hero-information-circle" class="w-4 h-4 ml-1 opacity-50" />
              </button>
            </div>

            <%!-- Sync Files / Health dashboard --%>
            <div
              class="tooltip tooltip-bottom"
              data-tip={
                gettext(
                  "Open the media health dashboard: the files not yet stored or sized as their library wants."
                )
              }
            >
              <.link
                navigate={PhoenixKit.Utils.Routes.path("/admin/settings/media/health")}
                class="btn btn-outline w-full"
              >
                <.icon name="hero-arrow-path" class="w-4 h-4 mr-2" /> {gettext("Health")}
                <.icon name="hero-information-circle" class="w-4 h-4 ml-1 opacity-50" />
              </.link>
            </div>

            <%!-- Find Orphaned Files --%>
            <div
              class="tooltip tooltip-bottom"
              data-tip={
                gettext(
                  "Browse files no longer attached to any record (orphaned media) so you can review or delete them."
                )
              }
            >
              <.link
                navigate={PhoenixKit.Utils.Routes.path("/admin/media") <> "?orphaned=1"}
                class="btn btn-outline w-full"
              >
                <.icon name="hero-funnel" class="w-4 h-4 mr-2" /> {gettext("Find Orphaned Files")}
                <.icon name="hero-information-circle" class="w-4 h-4 ml-1 opacity-50" />
              </.link>
            </div>

            <%!-- Repair Media Module --%>
            <div
              class="tooltip tooltip-bottom"
              data-tip={
                gettext(
                  "Put back what storage needs: a bucket, a writable bucket in the Default profile, a copy count its buckets can hold. Resets the default dimensions. Keeps your buckets, redundancy and files."
                )
              }
            >
              <button
                phx-click="repair_storage_module"
                data-confirm={
                  gettext(
                    "This resets the default dimensions and fixes missing bucket setup. Buckets, redundancy and uploaded files are kept. Continue?"
                  )
                }
                class="btn btn-outline btn-warning w-full"
              >
                <.icon name="hero-wrench-screwdriver" class="w-4 h-4 mr-2" /> {gettext(
                  "Repair Media Module"
                )}
                <.icon name="hero-information-circle" class="w-4 h-4 ml-1 opacity-50" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="media-tab-external-libraries" class={@active_tab != "external_libraries" && "hidden"}>
      <div class="card bg-base-100 shadow-xl mb-6 mt-6">
        <div class="card-body">
          <div class="flex items-center justify-between gap-4">
            <p class="text-sm text-base-content/70">
              {gettext("Programs on this server that media processing runs.")}
            </p>
            <button
              type="button"
              phx-click="recheck_external_tools"
              class="btn btn-ghost btn-sm"
            >
              <.icon name="hero-arrow-path" class="w-4 h-4" /> {gettext("Check again")}
            </button>
          </div>

          <.table_default id="external-libraries-table" size="sm">
            <.table_default_header>
              <.table_default_row>
                <.table_default_header_cell>{gettext("Tool")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Used for")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Status")}</.table_default_header_cell>
              </.table_default_row>
            </.table_default_header>
            <.table_default_body>
              <.table_default_row :for={tool <- @external_tools}>
                <.table_default_cell>
                  <div class="font-medium">{tool.name}</div>
                  <code class="text-xs text-base-content/60">{tool.command}</code>
                </.table_default_cell>
                <.table_default_cell class="text-sm">
                  {tool_purpose(tool.used_for)}
                </.table_default_cell>
                <.table_default_cell>
                  <%= case tool.status do %>
                    <% {:ok, version} -> %>
                      <span class="badge badge-success badge-soft gap-1">
                        <.icon name="hero-check" class="w-3 h-3" /> {version}
                      </span>
                    <% _ -> %>
                      <span class="badge badge-error badge-soft gap-1">
                        <.icon name="hero-x-mark" class="w-3 h-3" /> {gettext("Missing")}
                      </span>
                  <% end %>
                </.table_default_cell>
              </.table_default_row>
            </.table_default_body>
          </.table_default>
        </div>
      </div>
    </div>
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
