<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_section={gettext("Settings")}
  page_section_path={PhoenixKit.Utils.Routes.path("/admin/settings")}
  page_crumbs={[
    %{label: gettext("Media"), path: PhoenixKit.Utils.Routes.path("/admin/settings/media")}
  ]}
  page_subtitle={gettext("Configure storage provider settings")}
  current_path={@current_path}
  current_locale={@current_locale}
  project_title={@project_title}
>
  <div class="mx-auto px-4 py-8 max-w-3xl">
    <.form
      id="bucket-form"
      for={@changeset}
      phx-change="validate"
      phx-submit="save"
      class="space-y-6"
    >
      <%!-- Basic Information --%>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-lg">
            <.icon name="hero-server" class="w-5 h-5" /> {gettext("Basic Information")}
          </h2>

          <fieldset class="fieldset">
            <legend class="fieldset-legend font-semibold">{gettext("Name")} *</legend>
            <.input
              type="text"
              name="bucket[name]"
              value={Ecto.Changeset.get_field(@changeset, :name)}
              class={input_class(@changeset, :name)}
              placeholder={gettext("e.g., Production Media, Backup Storage")}
              required
            />
            <p class="text-xs text-base-content/50 mt-1">
              {gettext(
                "A name for this storage location in PhoenixKit — not the bucket's name on the storage service."
              )}
            </p>
          </fieldset>

          <%!-- The provider is worked out from the type and, for cloud storage,
               from the integration picked below; it travels as a hidden field
               because the changeset is rebuilt from the form on every change. --%>
          <input type="hidden" name="bucket[provider]" value={@current_provider} />

          <%= if @mode == :new do %>
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-semibold">{gettext("Type")} *</legend>
              <.select
                name="bucket[storage_type]"
                required
                value={storage_type(@current_provider)}
                prompt={gettext("Select type...")}
                options={[
                  {gettext("Local Filesystem"), "local"},
                  {gettext("Cloud storage (S3-compatible)"), "cloud"}
                ]}
              />
            </fieldset>
          <% else %>
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-semibold">{gettext("Type")}</legend>
              <div class="flex items-center gap-2">
                <span class="badge badge-lg badge-outline">
                  {provider_label(
                    @current_provider,
                    selected_service(@connections, @selected_connection_uuid)
                  )}
                </span>
                <span class="text-xs text-base-content/40">{gettext("Cannot be changed")}</span>
              </div>
            </fieldset>
          <% end %>
        </div>
      </div>

      <%!-- Local Provider Settings --%>
      <%= if @current_provider == "local" do %>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <h2 class="card-title text-lg">
              <.icon name="hero-folder" class="w-5 h-5" /> {gettext("Local Storage")}
            </h2>

            <fieldset class="fieldset">
              <legend class="fieldset-legend font-semibold">{gettext("Storage Path")} *</legend>
              <.input
                type="text"
                name="bucket[endpoint]"
                value={Ecto.Changeset.get_field(@changeset, :endpoint)}
                class={input_class(@changeset, :endpoint)}
                placeholder="priv/media"
                required
              />
              <p class="text-xs text-base-content/50 mt-1">
                {gettext(
                  "Use an absolute path, or one relative to the folder the application runs from, such as priv/media."
                )}
              </p>
              <%= case @path_status do %>
                <% {:ok, path} -> %>
                  <p class="text-xs text-success mt-2 flex items-start gap-1.5">
                    <.icon name="hero-check-circle" class="w-4 h-4 shrink-0" />
                    <span>
                      {gettext("Files are stored in")}
                      <code class="break-all font-semibold">{path}</code>
                    </span>
                  </p>
                <% {:missing, path} -> %>
                  <p class="text-xs text-warning mt-2 flex items-start gap-1.5">
                    <.icon name="hero-exclamation-triangle" class="w-4 h-4 shrink-0" />
                    <span>
                      <code class="break-all font-semibold">{path}</code>
                      {gettext(
                        "does not exist yet. You will be asked to create it when you save."
                      )}
                    </span>
                  </p>
                <% {:not_directory, path} -> %>
                  <p class="text-xs text-error mt-2 flex items-start gap-1.5">
                    <.icon name="hero-x-circle" class="w-4 h-4 shrink-0" />
                    <span>
                      <code class="break-all font-semibold">{path}</code>
                      {gettext("is a file, not a folder.")}
                    </span>
                  </p>
                <% {:not_writable, path} -> %>
                  <p class="text-xs text-error mt-2 flex items-start gap-1.5">
                    <.icon name="hero-x-circle" class="w-4 h-4 shrink-0" />
                    <span>
                      {gettext("The application cannot write to")}
                      <code class="break-all font-semibold">{path}</code>
                    </span>
                  </p>
                <% nil -> %>
              <% end %>
            </fieldset>
          </div>
        </div>
      <% end %>

      <%!-- Cloud storage: pick an integration, then say which bucket on it --%>
      <%= if cloud_provider?(@current_provider) do %>
        <% service = selected_service(@connections, @selected_connection_uuid) %>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <h2 class="card-title text-lg">
              <.icon name="hero-cloud" class="w-5 h-5" /> {gettext("Cloud storage")}
            </h2>

            <fieldset class="fieldset">
              <legend class="fieldset-legend font-semibold">
                {gettext("Storage integration")}
                <%= unless legacy_bucket?(@bucket) do %>
                  *
                <% end %>
              </legend>
              <.select
                name="bucket[integration_uuid]"
                value={@selected_connection_uuid}
                prompt={gettext("Select an integration...")}
                options={
                  Enum.map(@connections, fn connection ->
                    label =
                      if connection.service,
                        do: "#{connection.name} — #{Services.name(connection.service)}",
                        else: connection.name

                    {label, connection.uuid}
                  end)
                }
              />
              <p class="text-xs text-base-content/50 mt-1">
                {gettext("The keys and endpoint come from an Object Storage integration.")}
                <%= if can_manage_integrations?(assigns) do %>
                  <a
                    href={
                      PhoenixKit.Utils.Routes.path(
                        "/admin/settings/integrations/new?provider=object_storage"
                      )
                    }
                    target="_blank"
                    rel="noopener"
                    class="link link-primary"
                  >
                    {gettext("Add a connection")}
                  </a>
                <% end %>
              </p>
              <%= if @connections == [] do %>
                <p class="text-xs text-warning mt-1">
                  {gettext("No Object Storage connection exists yet.")}
                  <%= unless can_manage_integrations?(assigns) do %>
                    {gettext("Ask an administrator to add one.")}
                  <% end %>
                </p>
              <% end %>
            </fieldset>

            <%= if legacy_bucket?(@bucket) and is_nil(@selected_connection_uuid) do %>
              <div class="alert alert-warning">
                <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
                <div class="flex-1">
                  <p class="font-semibold">
                    {gettext("This bucket uses keys saved on the bucket itself.")}
                  </p>
                  <p class="text-sm">
                    {gettext(
                      "It keeps working. Move the keys into an integration to manage them in one place."
                    )}
                    <span class="font-mono">{@bucket.access_key_id}</span>
                  </p>
                </div>
                <%= if can_manage_integrations?(assigns) do %>
                  <button
                    type="button"
                    phx-click="move_credentials"
                    data-confirm={
                      gettext(
                        "Move this bucket's keys into an integration? The bucket keeps working."
                      )
                    }
                    class="btn btn-sm btn-warning"
                  >
                    {gettext("Move keys to an integration")}
                  </button>
                <% end %>
              </div>
            <% end %>

            <%= if cloud_details?(assigns) do %>
              <%!-- The service says what else is asked: only Amazon (and a bucket
                   with no integration yet) has a region to pick here, and only
                   "other" an endpoint to type. The rest is the integration's own,
                   kept in hidden fields because the changeset is rebuilt from the
                   form on every change. --%>
              <%= if service do %>
                <p class="text-sm">
                  <span class="badge badge-outline">{Services.name(service)}</span>
                  <span
                    :if={Ecto.Changeset.get_field(@changeset, :endpoint) not in [nil, ""]}
                    class="text-xs text-base-content/50 ml-1"
                  >
                    {Ecto.Changeset.get_field(@changeset, :endpoint)}
                  </span>
                </p>
              <% end %>

              <%= if region_select?(@current_provider, service) do %>
                <.live_component
                  module={PhoenixKitWeb.Live.Components.SearchableSelect}
                  id="bucket-region-select"
                  name="bucket[region]"
                  value={Ecto.Changeset.get_field(@changeset, :region)}
                  label={"#{gettext("Region")} *"}
                  placeholder={gettext("Search regions...")}
                  required={true}
                  grouped_options={
                    Enum.map(AwsRegions.group_by_continent(), fn {continent, regions} ->
                      {continent,
                       Enum.map(regions, fn r -> {"#{r.name} — #{r.code}", r.code} end)}
                    end)
                  }
                />
              <% else %>
                <input
                  type="hidden"
                  name="bucket[region]"
                  value={Ecto.Changeset.get_field(@changeset, :region)}
                />
              <% end %>

              <fieldset class="fieldset">
                <legend class="fieldset-legend font-semibold">
                  {if service,
                    do: gettext("Bucket name on %{service}", service: Services.name(service)),
                    else: gettext("Bucket Name")} *
                </legend>
                <.input
                  type="text"
                  name="bucket[bucket_name]"
                  value={Ecto.Changeset.get_field(@changeset, :bucket_name)}
                  class={input_class(@changeset, :bucket_name)}
                  placeholder="e.g., my-app-files"
                  required
                />
                <p class="text-xs text-base-content/50 mt-1">
                  {gettext(
                    "The bucket's own name on the storage service, as its console shows it."
                  )}
                </p>
              </fieldset>

              <%= if endpoint_input?(service) do %>
                <fieldset class="fieldset">
                  <legend class="fieldset-legend font-semibold">{gettext("Endpoint")}</legend>
                  <.input
                    type="text"
                    name="bucket[endpoint]"
                    value={Ecto.Changeset.get_field(@changeset, :endpoint)}
                    class={input_class(@changeset, :endpoint)}
                    placeholder="e.g., minio.example.com:9000"
                  />
                  <p class="text-xs text-base-content/50 mt-1">
                    {gettext(
                      "Leave empty for AWS S3. Set it for an S3-compatible service such as MinIO, Wasabi or DigitalOcean Spaces."
                    )}
                  </p>
                </fieldset>
              <% else %>
                <input
                  type="hidden"
                  name="bucket[endpoint]"
                  value={Ecto.Changeset.get_field(@changeset, :endpoint)}
                />
              <% end %>

              <fieldset class="fieldset">
                <legend class="fieldset-legend font-semibold">
                  {gettext("Public URL (CDN)")}
                </legend>
                <.input
                  type="text"
                  name="bucket[cdn_url]"
                  value={Ecto.Changeset.get_field(@changeset, :cdn_url)}
                  class={input_class(@changeset, :cdn_url)}
                  placeholder="https://cdn.example.com"
                />
                <p class="text-xs text-base-content/50 mt-1">
                  <%= if @current_provider == "r2" do %>
                    {gettext(
                      "The bucket's r2.dev or custom domain. Without one, files are served through this server."
                    )}
                  <% else %>
                    {gettext(
                      "Files are served from this address instead of the bucket's own URL. Optional."
                    )}
                  <% end %>
                </p>
              </fieldset>

              <%!-- Test Connection --%>
              <div class="pt-2">
                <button
                  type="button"
                  phx-click="test_connection"
                  class={"btn btn-outline btn-sm #{if @connection_status == :success, do: "btn-success", else: ""}"}
                  disabled={@testing_connection or connection_missing?(@changeset, @bucket)}
                >
                  <%= if @testing_connection do %>
                    <span class="loading loading-spinner loading-xs"></span>
                    {gettext("Testing...")}
                  <% else %>
                    <.icon name="hero-signal" class="w-4 h-4" />
                    {gettext("Test Connection")}
                  <% end %>
                </button>

                <%= if @connection_status == :success do %>
                  <span class="text-sm text-success ml-2">
                    <.icon name="hero-check-circle" class="w-4 h-4 inline" />
                    {gettext("The bucket can be read, written to and deleted from")}
                  </span>
                <% end %>
                <%= if @connection_status == :failed do %>
                  <div class="mt-2 text-sm text-error">
                    <.icon name="hero-x-circle" class="w-4 h-4 inline" />
                    {gettext("Connection failed")}
                    <%= if @connection_error do %>
                      : {@connection_error}
                    <% end %>
                  </div>
                <% end %>
                <p class="text-xs text-base-content/50 mt-2">
                  {gettext(
                    "The test saves and removes a small file. It is optional: a bucket can be saved without it."
                  )}
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%!-- Settings --%>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-lg">
            <.icon name="hero-cog-6-tooth" class="w-5 h-5" /> {gettext("Settings")}
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%= if cloud_provider?(@current_provider) do %>
              <fieldset class="fieldset">
                <legend class="fieldset-legend font-semibold">{gettext("Access Type")}</legend>
                <.select
                  name="bucket[access_type]"
                  value={Ecto.Changeset.get_field(@changeset, :access_type)}
                  options={[
                    {gettext("Public (direct URL)"), "public"},
                    {gettext("Signed (short-lived link)"), "signed"},
                    {gettext("Private (proxied)"), "private"}
                  ]}
                />
              </fieldset>
            <% end %>

            <fieldset class="fieldset">
              <legend class="fieldset-legend font-semibold">{gettext("Priority")}</legend>
              <.input
                type="number"
                name="bucket[priority]"
                value={Ecto.Changeset.get_field(@changeset, :priority)}
                class={input_class(@changeset, :priority)}
                placeholder="0"
                min="0"
              />
              <p class="text-xs text-base-content/50 mt-1">
                {gettext("0 = auto, 1+ = higher priority")}
              </p>
            </fieldset>

            <fieldset class="fieldset">
              <legend class="fieldset-legend font-semibold">{gettext("Size limit (MB)")}</legend>
              <.input
                type="number"
                name="bucket[max_size_mb]"
                value={Ecto.Changeset.get_field(@changeset, :max_size_mb)}
                class={input_class(@changeset, :max_size_mb)}
                placeholder={gettext("No limit")}
                min="1"
              />
              <p class="text-xs text-base-content/50 mt-1">
                {gettext("Stop storing new files here once it holds this much. Empty = no limit.")}
              </p>
            </fieldset>
          </div>

          <div class="fieldset">
            <.checkbox
              name="bucket[enabled]"
              checked={Ecto.Changeset.get_field(@changeset, :enabled)}
            >
              <span class="font-semibold">{gettext("Enable bucket")}</span>
              <:description>
                {gettext("Only enabled buckets receive new uploads")}
              </:description>
            </.checkbox>
          </div>

          <fieldset :if={@mode == :new} class="fieldset">
            <legend class="fieldset-legend font-semibold">{gettext("Storage profile")}</legend>
            <.select
              name="bucket[profile_uuid]"
              value={@profile_uuid}
              options={
                [{gettext("None: just add the bucket"), ""}] ++
                  Enum.map(@profiles, &{profile_label(&1), &1.uuid})
              }
            />
            <p class="text-xs text-base-content/50 mt-1">
              {if @profile_uuid in [nil, ""],
                do:
                  gettext(
                    "The bucket is only added to the system: it receives and serves nothing until a storage profile lists it (Storage profiles tab)."
                  ),
                else:
                  gettext(
                    "The bucket joins this profile as a primary (written and served), and the profile's files are placed again. Change its role there."
                  )}
            </p>
          </fieldset>

          <div :if={@usage != []} class="alert alert-info alert-soft text-sm" role="note">
            <.icon name="hero-lock-closed" class="w-5 h-5 shrink-0" />
            <div>
              <p class="font-semibold">{gettext("This bucket is in use")}</p>
              <p>
                {gettext(
                  "It is used by %{used_by}. It cannot be disabled or deleted until it is taken out of those storage profiles.",
                  used_by: BucketUsage.used_by_text(@usage)
                )}
              </p>
              <.pk_link navigate="/admin/settings/media?tab=profiles" class="link link-primary">
                {gettext("Open the storage profiles")}
              </.pk_link>
            </div>
          </div>
        </div>
      </div>

      <%!-- Actions --%>
      <div class="flex justify-end gap-3">
        <.link
          navigate={PhoenixKit.Utils.Routes.path("/admin/settings/media")}
          class="btn btn-ghost"
        >
          {gettext("Cancel")}
        </.link>
        <button
          type="submit"
          class="btn btn-primary"
          disabled={!@changeset.valid? || connection_missing?(@changeset, @bucket)}
        >
          <.icon name="hero-check" class="w-4 h-4" /> {gettext("Save Bucket")}
        </button>
      </div>
    </.form>
  </div>

  <%!-- Create Path Confirmation Modal --%>
  <%= if @show_create_path_modal do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold text-lg">{gettext("Create Storage Path")}</h3>
        <p class="py-4">
          {gettext("The storage path")}
          <code class="badge badge-ghost">{@missing_path}</code> {gettext("does not exist.")}
        </p>
        <p class="mb-6">{gettext("Would you like to create it now?")}</p>
        <div class="modal-action">
          <button phx-click="cancel_create_path" class="btn btn-ghost">
            {gettext("Cancel")}
          </button>
          <button
            phx-click="confirm_create_path"
            phx-value-path={@missing_path}
            class="btn btn-primary"
          >
            <.icon name="hero-plus" class="w-4 h-4" /> {gettext("Create Path")}
          </button>
        </div>
      </div>
    </div>
  <% end %>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
