<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_section={gettext("Settings")}
  page_section_path={PhoenixKit.Utils.Routes.path("/admin/settings")}
  page_crumbs={[
    %{label: gettext("Media"), path: PhoenixKit.Utils.Routes.path("/admin/settings/media")},
    %{
      label: gettext("Rendition profiles"),
      path: PhoenixKit.Utils.Routes.path("/admin/settings/media?tab=renditions")
    },
    %{
      label: @set.name,
      path: PhoenixKitWeb.Live.Modules.Storage.RenditionsComponent.set_path(@set)
    }
  ]}
  page_subtitle={gettext("Set up one rendition: its dimensions, quality and format")}
  current_path={@current_path}
  current_locale={@current_locale}
  project_title={@project_title}
>
  <div class="mx-auto px-4 py-8 max-w-3xl">
    <.form
      for={@changeset}
      id="dimension-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-6"
    >
      <%!-- Basic Information --%>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-lg">
            <.icon name="hero-tag" class="w-5 h-5" /> {gettext("Basic Information")}
          </h2>

          <fieldset class="fieldset">
            <legend class="fieldset-legend font-semibold">
              {gettext("Rendition name")} *
            </legend>
            <.input
              type="text"
              name="dimension[name]"
              phx-debounce="blur"
              value={get_field_value(@changeset, :name)}
              class={input_class(@changeset, :name)}
              placeholder={gettext("e.g., thumbnail, medium, 720p")}
              required
            />
            {render_error(@changeset, :name)}
            <p class="text-xs text-base-content/50 mt-1">
              {gettext("A unique name for this rendition")}
            </p>
          </fieldset>

          <input type="hidden" name="dimension[applies_to]" value={@dimension_type} />
        </div>
      </div>

      <%!-- Size Configuration --%>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-lg">
            <.icon name="hero-arrows-pointing-out" class="w-5 h-5" />
            {gettext("Size Configuration")}
          </h2>

          <%!-- Aspect Ratio Toggle --%>
          <div class="fieldset">
            <.checkbox
              name="dimension[maintain_aspect_ratio]"
              checked={get_field_value(@changeset, :maintain_aspect_ratio) != false}
            >
              <span class="font-semibold">{gettext("Maintain Aspect Ratio")}</span>
              <:description>
                <%= if get_field_value(@changeset, :maintain_aspect_ratio) != false do %>
                  {gettext("Only width is used, height is calculated automatically")}
                <% else %>
                  {gettext("Both width and height are used for fixed dimensions")}
                <% end %>
              </:description>
            </.checkbox>
          </div>

          <%!-- Which side a rendition that keeps proportions fixes --%>
          <% keeps? = get_field_value(@changeset, :maintain_aspect_ratio) != false %>
          <% fixed_height? =
            keeps? and @dimension_type != "video" and
              get_field_value(@changeset, :fit_by) == "height" %>
          <fieldset
            :if={keeps? and @dimension_type != "video"}
            id="dimension-fit-by"
            class="fieldset"
          >
            <legend class="fieldset-legend font-semibold">{gettext("Fixed side")}</legend>
            <.select
              name="dimension[fit_by]"
              value={get_field_value(@changeset, :fit_by) || "width"}
              class={input_class(@changeset, :fit_by)}
              options={[
                {gettext("Width: the height follows each photo"), "width"},
                {gettext("Height: the width follows each photo"), "height"}
              ]}
            />
            {render_error(@changeset, :fit_by)}
            <p class="text-xs text-base-content/50 mt-1">
              {gettext(
                "Width suits a column of photos, and a tall panorama as long as it needs to be. Height suits a row of photos, and a wide panorama. A photo smaller than the size is not enlarged."
              )}
            </p>
          </fieldset>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <fieldset :if={not fixed_height?} class="fieldset">
              <legend class="fieldset-legend font-semibold">
                <%= if keeps? do %>
                  {gettext("Target Width (px)")} *
                <% else %>
                  {gettext("Width (px)")} *
                <% end %>
              </legend>
              <.input
                type="number"
                name="dimension[width]"
                phx-debounce="blur"
                value={get_field_value(@changeset, :width)}
                class={input_class(@changeset, :width)}
                placeholder="800"
                min="1"
                required
              />
              {render_error(@changeset, :width)}
            </fieldset>

            <fieldset :if={not keeps? or fixed_height?} class="fieldset">
              <legend class="fieldset-legend font-semibold">
                <%= if fixed_height? do %>
                  {gettext("Target Height (px)")} *
                <% else %>
                  {gettext("Height (px)")} *
                <% end %>
              </legend>
              <.input
                type="number"
                name="dimension[height]"
                phx-debounce="blur"
                value={get_field_value(@changeset, :height)}
                class={input_class(@changeset, :height)}
                placeholder="600"
                min="1"
                required
              />
              {render_error(@changeset, :height)}
            </fieldset>
          </div>

          <%!-- How a fixed image box is cropped --%>
          <fieldset
            :if={
              @dimension_type != "video" and
                get_field_value(@changeset, :maintain_aspect_ratio) == false
            }
            id="dimension-crop-mode"
            class="fieldset"
          >
            <legend class="fieldset-legend font-semibold">{gettext("Crop")}</legend>
            <.select
              name="dimension[crop_mode]"
              value={get_field_value(@changeset, :crop_mode) || "center"}
              class={input_class(@changeset, :crop_mode)}
              options={[
                {gettext("Around the middle of the photo"), "center"},
                {gettext("Around the subject of the photo"), "focus"}
              ]}
            />
            <p class="text-xs text-base-content/50 mt-1">
              {gettext(
                "The photo is scaled to fill the box and the excess is cropped. Around the subject keeps what the photo is about in the frame, where the middle can cut it off. The subject is found automatically (needs libvips) and can be set by hand per photo; without it the crop is at the middle."
              )}
            </p>
          </fieldset>
        </div>
      </div>

      <%!-- Quality & Format --%>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-lg">
            <.icon name="hero-adjustments-horizontal" class="w-5 h-5" />
            {gettext("Quality & Format")}
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <fieldset class="fieldset">
              <legend class="fieldset-legend font-semibold">
                <%= if @dimension_type == "video" do %>
                  {gettext("Quality (CRF)")}
                <% else %>
                  {gettext("Quality")}
                <% end %>
              </legend>
              <.input
                type="number"
                name="dimension[quality]"
                phx-debounce="blur"
                value={get_field_value(@changeset, :quality)}
                class={input_class(@changeset, :quality)}
                placeholder={if @dimension_type == "video", do: "23", else: "85"}
                min={if @dimension_type == "video", do: "0", else: "1"}
                max={if @dimension_type == "video", do: "51", else: "100"}
              />
              {render_error(@changeset, :quality)}
              <p class="text-xs text-base-content/50 mt-1">
                <%= if @dimension_type == "video" do %>
                  {gettext("CRF 0-51, lower = higher quality. 18-28 recommended.")}
                <% else %>
                  {gettext("1-100, higher = better quality. 80-90 recommended.")}
                <% end %>
              </p>
            </fieldset>

            <fieldset class="fieldset">
              <legend class="fieldset-legend font-semibold">
                <%= if @dimension_type == "video" do %>
                  {gettext("Codec Override")}
                <% else %>
                  {gettext("Format Override")}
                <% end %>
              </legend>
              <% format_value = get_field_value(@changeset, :format) %>
              <.select
                name="dimension[format]"
                value={format_value}
                class={input_class(@changeset, :format)}
                prompt={gettext("Preserve original")}
                options={
                  if @dimension_type == "video" do
                    [{"MP4", "mp4"}]
                  else
                    [{"JPEG", "jpg"}, {"PNG", "png"}, {"WebP", "webp"}]
                  end
                }
              />
              {render_error(@changeset, :format)}
              <p class="text-xs text-base-content/50 mt-1">
                {gettext("Leave empty to preserve the original file format")}
              </p>
            </fieldset>
          </div>
        </div>
      </div>

      <%!-- Alternative Formats (image dimensions only) --%>
      <%= if @dimension_type != "video" do %>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <h2 class="card-title text-lg">
              <.icon name="hero-document-duplicate" class="w-5 h-5" />
              {gettext("Alternative Formats")}
            </h2>
            <p class="text-sm text-base-content/60">
              {gettext(
                "Generate additional format variants alongside the primary format. Modern formats like WebP and AVIF offer better compression."
              )}
            </p>

            <input type="hidden" name="dimension[alternative_formats][]" value="" />
            <div class="flex flex-wrap gap-4">
              <%= for {fmt, label} <- [{"webp", "WebP"}, {"avif", "AVIF"}, {"png", "PNG"}, {"jpg", "JPEG"}] do %>
                <%= if fmt != @primary_format do %>
                  <label class="label cursor-pointer gap-2">
                    <input
                      type="checkbox"
                      name="dimension[alternative_formats][]"
                      value={fmt}
                      checked={fmt in @current_alternatives}
                      class="checkbox checkbox-sm checkbox-primary"
                    />
                    <span class="fieldset-legend">{label}</span>
                  </label>
                <% end %>
              <% end %>
            </div>
            {render_error(@changeset, :alternative_formats)}
          </div>
        </div>
      <% end %>

      <%!-- Actions --%>
      <div class="flex justify-end gap-3">
        <.link
          navigate={PhoenixKitWeb.Live.Modules.Storage.RenditionsComponent.set_path(@set)}
          class="btn btn-ghost"
        >
          {gettext("Cancel")}
        </.link>
        <button type="submit" class="btn btn-primary" disabled={!@changeset.valid?}>
          <.icon name="hero-check" class="w-4 h-4" /> {@form_action}
        </button>
      </div>
    </.form>
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
