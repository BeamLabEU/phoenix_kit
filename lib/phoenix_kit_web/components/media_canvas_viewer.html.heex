<%!-- ViewerPaneFit corrects the stacked pane's shape from the bitmap the --%>
<%!-- browser actually paints. `pane_aspect/2` is the server's prediction    --%>
<%!-- and is right for the picture as uploaded, but the viewer opens on a    --%>
<%!-- burned copy wherever one exists, and a burn is not always composed at  --%>
<%!-- the picture's ratio — so the pane would hold a shape the picture does  --%>
<%!-- not have and leave bands of empty canvas down its sides. The element   --%>
<%!-- the hook measures is the one on screen, so it is right about rotation, --%>
<%!-- edits and whatever the burn did.                                       --%>
<div id={@id} class="contents" phx-hook="ViewerPaneFit">
  <%!-- A board (no file): an empty canvas with the drawing tools, nothing --%>
  <%!-- else — see the moduledoc's "A board instead of a file".            --%>
  <%= if @board do %>
    <.board_canvas
      board={@board}
      viewer_canvas={@viewer_canvas}
      etcher_colors={@etcher_colors}
      etcher_line_params={@etcher_line_params}
      can_annotate={@can_annotate}
      invert_two_finger_pan={@invert_two_finger_pan}
    />
  <% else %>
    <%!--                                                                          --%>
    <%!-- MediaCanvasViewer — rendered inside a parent's modal shell (a <dialog>   --%>
    <%!-- in MediaViewer, a <div class="modal"> in MediaBrowser). Owns the         --%>
    <%!-- per-file content: close button, prev/next chevrons, image canvas /      --%>
    <%!-- video / pdf / icon, composer popover, and sidebar (filename, Download,   --%>
    <%!-- metadata, comments thread).                                              --%>
    <%!--                                                                          --%>
    <%!-- All click events on the close + chevron buttons target the parent       --%>
    <%!-- LiveComponent (`phx-target={"#" <> @parent_id}`) — the parent owns      --%>
    <%!-- modal open/close state and file navigation, this component just         --%>
    <%!-- displays whichever file's been handed to it.                             --%>
    <%!--                                                                          --%>
    <%!-- No file and no (valid) board: nothing to show. --%>
    <%= if @file do %>
      <% f = @file %>
      <%!-- Close button — top-right of modal-box. Suppressed in viewer_only --%>
      <%!-- mode (standalone-page hosts provide their own back navigation).  --%>
      <button
        :if={not @viewer_only}
        type="button"
        phx-click="close_viewer"
        phx-target={"##{@parent_id}"}
        class="btn btn-ghost btn-sm btn-circle absolute top-3 right-3 z-30 bg-base-100 hover:bg-base-200 shadow-lg ring-1 ring-base-300"
        title={gettext("Close")}
      >
        <.icon name="hero-x-mark" class="w-4 h-4" />
      </button>

      <%!-- Side by side only when the popup is genuinely wider than it is  --%>
      <%!-- tall. `lg:` alone was the old rule, and it reads width only: a   --%>
      <%!-- tall window that happens to be ≥1024px — a portrait monitor, a   --%>
      <%!-- half-screen split — kept the side split and squeezed a landscape --%>
      <%!-- picture into what was left of a column beside a 280-416px panel. --%>
      <%!-- `landscape:` adds the shape test, so a portrait popup falls back --%>
      <%!-- to the stacked layout mobile already used: picture on top, the   --%>
      <%!-- details docked along the bottom, same collapse toggle. Every     --%>
      <%!-- `lg:landscape:` below is part of this one rule — keep them in    --%>
      <%!-- step or the halves disagree about which layout is running.       --%>
      <div class="flex flex-col lg:landscape:flex-row h-full overflow-hidden">
        <%!-- Viewer column (image / video / pdf / icon). Carries the         --%>
        <%!-- EtcherTooltipActions hook: Etcher re-dispatches tooltip action  --%>
        <%!-- buttons as a bubbling `etcher:tooltip-action` DOM event, and    --%>
        <%!-- this ancestor routes them — Reply to this LiveComponent, Edit   --%>
        <%!-- straight back into Etcher's label editor client-side.           --%>
        <%!-- Stacked, the pane takes the height the PICTURE needs, not a    --%>
        <%!-- share of the popup's. On a 1080×2840 window that share is       --%>
        <%!-- 1700px for a photograph that wants 480, and the rest was empty   --%>
        <%!-- canvas with the panel stranded at the bottom of it. `aspect-`    --%>
        <%!-- `[var(--pk-pane-aspect)]` is the picture's own ratio, handed     --%>
        <%!-- down as a custom property so the rule lives in the stylesheet    --%>
        <%!-- and only the number is per-file; the clamp keeps a panorama      --%>
        <%!-- from becoming a letterbox slot and a tall picture from taking    --%>
        <%!-- the whole popup. `flex-none` because a flex share and an aspect  --%>
        <%!-- cannot both decide the height — and in an auto-height popup a    --%>
        <%!-- `flex-[7]` with a zero basis collapses to nothing.               --%>
        <%!--                                                                  --%>
        <%!-- A picture always gets the aspect rule, even when nothing is on  --%>
        <%!-- file about its size: the browser knows the shape as soon as the  --%>
        <%!-- bitmap decodes and ViewerPaneFit writes it in, so an unprobed    --%>
        <%!-- upload ends up sized like every other picture. The 1.5 in the    --%>
        <%!-- fallback is only what the first paint uses until then. Anything  --%>
        <%!-- that is not a picture (a PDF, an audio file) has no bitmap to    --%>
        <%!-- measure and keeps the fixed 60vh every file got before.          --%>
        <%!--                                                                  --%>
        <%!-- Side by side is unchanged either way: there the popup's height   --%>
        <%!-- is definite and the pane fills it.                               --%>
        <% aspect = pane_aspect(f, @viewer_rotation) %>
        <div
          id={"pk-annotation-actions-" <> f.file_uuid}
          phx-hook="EtcherTooltipActions"
          data-viewer-pane
          style={pane_style(aspect, @viewer_only)}
          class={[
            "flex-[7] relative flex items-center justify-center bg-base-200 overflow-hidden p-0 lg:landscape:p-2 max-lg:min-h-[40vh]",
            "lg:portrait:flex-none lg:portrait:max-h-[60vh]",
            if(aspect || f.file_type == "image",
              do: "lg:portrait:aspect-[var(--pk-pane-aspect,1.5)] lg:portrait:min-h-[18rem]",
              else: "lg:portrait:h-[60vh]"
            )
          ]}
        >
          <%!-- Keeps a copy of the picture with the annotations drawn into  --%>
          <%!-- it, so a grid card and a list row carry the markup. Composes --%>
          <%!-- in the browser at the end of an editing session (Etcher off, --%>
          <%!-- or the viewer closing) and posts it; see AnnotationBurn.     --%>
          <%!--                                                              --%>
          <%!-- Stored as `thumbnail` and `burned`, never small/medium/large: --%>
          <%!-- those are the rungs this viewer paints, and a burn there     --%>
          <%!-- would draw every shape a second time under the live overlay. --%>
          <div
            :if={image_file?(f)}
            id={"pk-burn-" <> f.file_uuid}
            phx-hook="AnnotationBurn"
            phx-target={@myself}
            data-file-uuid={f.file_uuid}
            data-source-version={original_source_version(f)}
            data-burn-variants="thumbnail,burned,burned_large"
            data-burn-mode={to_string(@burn_mode and not is_nil(@burn_canvas))}
            data-can-annotate={to_string(@can_annotate)}
            data-auto-annotate={to_string(@auto_annotate)}
            data-has-burn={to_string(not is_nil(@burn_canvas))}
            data-etchings-hidden={to_string(@etchings_hidden)}
            data-fresco-id={
              cond do
                @etchings_hidden && @viewer_canvas ->
                  "media-plain-" <> f.file_uuid

                @burn_mode && @burn_canvas ->
                  "media-burn-" <> f.file_uuid <> "-" <> to_string(@burn_version || "0")

                true ->
                  "media-zoom-" <> f.file_uuid
              end
            }
            data-burn-fingerprint={Map.get(f, :burn_fingerprint)}
            class="hidden"
          />
          <%!-- "Loading full quality…" — shown while a sharper picture is   --%>
          <%!-- still arriving. The viewer opens on the small bitmap the grid --%>
          <%!-- already painted and Tessera climbs to a bigger one; on a slow --%>
          <%!-- line that climb took long enough that people sat looking at  --%>
          <%!-- a blurry photo with no idea anything was still coming. The   --%>
          <%!-- ViewerHiresLoading hook watches the pane's canvas image: a   --%>
          <%!-- new src that has not loaded yet shows this, its load (or     --%>
          <%!-- error) hides it. Any canvas — live, burned, clean original.  --%>
          <%!-- phx-update="ignore": the hook owns data-state and the       --%>
          <%!-- opacity. Inline opacity, not a Tailwind variant: a host      --%>
          <%!-- whose build does not reach into this package would drop the  --%>
          <%!-- variant and the pill would never appear (the instant         --%>
          <%!-- stand-in's blur is inline for the same reason). While the    --%>
          <%!-- stand-in is up it covers this pane, so it carries its own    --%>
          <%!-- copy of the pill (see InstantViewer).                        --%>
          <div
            :if={image_file?(f)}
            id={"pk-hires-loading-" <> f.file_uuid}
            phx-hook="ViewerHiresLoading"
            phx-update="ignore"
            data-state="idle"
            role="status"
            aria-hidden="true"
            style="opacity: 0; transition: opacity 300ms ease"
            class="pointer-events-none absolute left-3 bottom-3 z-20 flex items-center gap-2 rounded-full bg-base-100/90 px-2.5 py-1 text-xs font-medium text-base-content/80 shadow-md ring-1 ring-base-300"
          >
            <span class="loading loading-spinner loading-xs text-primary"></span>
            <span>{gettext("Loading full quality…")}</span>
          </div>
          <%!-- Previous / next: tabs joined to the pane's left and right     --%>
          <%!-- edges, halfway down. They used to be circles floating a few   --%>
          <%!-- px in from the edge, which read as loose chrome over the       --%>
          <%!-- picture and, on a small screen, landed on Fresco's buttons.    --%>
          <%!-- Flush with the edge and rounded only on the inside, they read --%>
          <%!-- as part of the popup. Plain buttons rather than daisyUI .btn:  --%>
          <%!-- its active state replaces `transform` with scale(0.97), which --%>
          <%!-- would undo the -translate-y-1/2 on the wrapper's child.        --%>
          <%!-- Bigger below lg, for a fingertip. See-through, so on a dark   --%>
          <%!-- theme a solid slab does not hide the picture under it; they   --%>
          <%!-- firm up on hover.                                             --%>
          <%!-- Swiping a fully zoomed-out picture steps too (ViewerSwipe). --%>
          <div
            :if={@has_prev or @has_next}
            id={"pk-viewer-swipe-" <> f.file_uuid}
            phx-hook="ViewerSwipe"
            data-target={"##{@parent_id}"}
            data-has-prev={to_string(@has_prev)}
            data-has-next={to_string(@has_next)}
            class="hidden"
          />
          <div :if={@has_prev} class="absolute left-0 top-1/2 -translate-y-1/2 z-10">
            <button
              type="button"
              phx-click="step_viewer"
              phx-value-dir="prev"
              phx-target={"##{@parent_id}"}
              class="flex items-center justify-center h-16 w-9 lg:h-14 lg:w-7 rounded-r-xl bg-base-100/45 hover:bg-base-100/85 backdrop-blur-sm text-base-content shadow-sm border border-l-0 border-base-content/10 cursor-pointer transition-colors"
              title={gettext("Previous (←)")}
              aria-label={gettext("Previous (←)")}
            >
              <.icon name="hero-chevron-left" class="w-4 h-4" />
            </button>
          </div>
          <div :if={@has_next} class="absolute right-0 top-1/2 -translate-y-1/2 z-10">
            <button
              type="button"
              phx-click="step_viewer"
              phx-value-dir="next"
              phx-target={"##{@parent_id}"}
              class="flex items-center justify-center h-16 w-9 lg:h-14 lg:w-7 rounded-l-xl bg-base-100/45 hover:bg-base-100/85 backdrop-blur-sm text-base-content shadow-sm border border-r-0 border-base-content/10 cursor-pointer transition-colors"
              title={gettext("Next (→)")}
              aria-label={gettext("Next (→)")}
            >
              <.icon name="hero-chevron-right" class="w-4 h-4" />
            </button>
          </div>

          <%= cond do %>
            <% is_binary(f.mime_type) and String.starts_with?(f.mime_type, "image/") -> %>
              <%!-- Fresco canvas + Etcher annotation layer + Tessera zoom layer.   --%>
              <%!--                                                                  --%>
              <%!-- - <Fresco.canvas> hosts the image at its base (medium)          --%>
              <%!--   resolution; the Canvas struct is built in                     --%>
              <%!--   build_viewer_canvas/2 with the file's annotations stuffed     --%>
              <%!--   into extensions.etcher — Etcher hydrates on mount via         --%>
              <%!--   handle.getExtension("etcher").                                 --%>
              <%!-- - <Etcher.layer> attaches via fresco_id; emits a single bulk    --%>
              <%!--   etcher:annotations-changed event the parent handles.          --%>
              <%!-- - <Tessera.layer> swaps medium → large → original as the user   --%>
              <%!--   zooms in, and (when urls["dzi"] is present) streams DZI tiles --%>
              <%!--   past the top raster for deep zoom on gigapixel images. Only   --%>
              <%!--   variants that exist on the file are included; tile + manifest --%>
              <%!--   fetches are lazy so unviewed regions never hit storage.       --%>
              <%!-- Opens on the burned copy: the picture with its markup      --%>
              <%!-- already in it, one flat image, nothing drawn over it. That --%>
              <%!-- is what someone came to look at and what they can          --%>
              <%!-- right-click and send on. The exception is a user who asked --%>
              <%!-- to open annotating (see maybe_open_annotating/3): they     --%>
              <%!-- start on the live layer with Etcher armed. The pencil      --%>
              <%!-- switches between the two; the eye hides the markup         --%>
              <%!-- entirely, from either of them.                             --%>
              <%= if @etchings_hidden and @viewer_canvas do %>
                <%!-- The eye, pressed: the original with nothing over it    --%>
                <%!-- and nothing burned into it — what someone hides the    --%>
                <%!-- etchings to see, or to right-click and copy clean.     --%>
                <%!-- Reachable from the burned view AND from the editor     --%>
                <%!-- (whose session the press ends), with or without a      --%>
                <%!-- burn on file. No Etcher layer mounts here (and         --%>
                <%!-- plain_canvas strips the extension), so no shape        --%>
                <%!-- reaches the DOM; the zoom ladder still runs, because   --%>
                <%!-- looking at the clean picture closely is the point of   --%>
                <%!-- asking for it.                                         --%>
                <% {plain_sources, plain_dzi} = tessera_ladder(f) %>
                <Fresco.canvas
                  id={"media-plain-" <> f.file_uuid}
                  canvas={plain_canvas(@viewer_canvas)}
                  class="w-full h-full lg:rounded"
                  invert_two_finger_pan={@invert_two_finger_pan}
                  nav_layout={:row}
                  nav_overflow={@nav_overflow}
                  nav_reverse
                  theme={:light}
                  initial_rotation={@viewer_rotation}
                  persist_rotation={@persist_rotation}
                />
                <%= if plain_sources != [] do %>
                  <Tessera.layer
                    fresco_id={"media-plain-" <> f.file_uuid}
                    sources={plain_sources}
                    dzi_url={plain_dzi}
                  />
                <% end %>
              <% else %>
                <%= if @burn_mode and @burn_canvas do %>
                  <%!-- theme={:light}: the burned copy is composed on white,   --%>
                  <%!-- so a dark viewer around it would make switching to the  --%>
                  <%!-- live layer a flash from white to black and back. Both   --%>
                  <%!-- canvases stay light whatever daisyUI theme the admin    --%>
                  <%!-- is wearing — the picture is the subject here, and a     --%>
                  <%!-- drawing surface that changes colour under the markup    --%>
                  <%!-- changes how the markup reads.                           --%>
                  <Fresco.canvas
                    id={"media-burn-" <> f.file_uuid <> "-" <> to_string(@burn_version || "0")}
                    canvas={@burn_canvas}
                    class="w-full h-full lg:rounded"
                    invert_two_finger_pan={@invert_two_finger_pan}
                    nav_layout={:row}
                    nav_overflow={@nav_overflow}
                    nav_reverse
                    theme={:light}
                    initial_rotation={@viewer_rotation}
                    persist_rotation={@persist_rotation}
                  />
                <% else %>
                  <%= if @viewer_canvas do %>
                    <%!-- Light for the same reason as the burn above: the two --%>
                    <%!-- are the same picture, and the pencil switches between --%>
                    <%!-- them.                                                 --%>
                    <Fresco.canvas
                      id={"media-zoom-" <> f.file_uuid}
                      canvas={@viewer_canvas}
                      class="w-full h-full lg:rounded"
                      invert_two_finger_pan={@invert_two_finger_pan}
                      nav_layout={:row}
                      nav_overflow={@nav_overflow}
                      nav_reverse
                      theme={:light}
                      initial_rotation={@viewer_rotation}
                      persist_rotation={@persist_rotation}
                    />
                    <%!-- connectors={:off} is the HARD form (Etcher 0.13): the      --%>
                    <%!-- soft default loses to the user's saved toggle, which is    --%>
                    <%!-- shared across every Etcher surface in the browser — a      --%>
                    <%!-- toggle flipped on a board followed people here, where the  --%>
                    <%!-- anchors point at nothing (no arrow tool below). Hard off   --%>
                    <%!-- also hides the toggle from the toolbar.                    --%>
                    <%!-- panel_toggle / panel_offset: the style panel's on/off  --%>
                    <%!-- switch joins Fresco's nav row; the panel itself docks  --%>
                    <%!-- top-right, just under the close and details buttons    --%>
                    <%!-- (top 12 + Etcher's 40 = 52px), and in from the edge by  --%>
                    <%!-- the next-file tab's width when there is one, so it     --%>
                    <%!-- never sits on it on a short screen (Etcher 0.21).       --%>
                    <%!-- tooltip_dock={:panel} moves a shape's tooltip into the  --%>
                    <%!-- style panel, under the stroke and colour controls: click --%>
                    <%!-- a shape and its label, comment and delete actions are    --%>
                    <%!-- there with everything else you can do to it; click away  --%>
                    <%!-- and the panel is just stroke and colour again. Nothing   --%>
                    <%!-- pops up over the photograph people came here to look at, --%>
                    <%!-- and with Etcher off the shapes are simply part of the    --%>
                    <%!-- image — no hover, no outline. Etcher's own default       --%>
                    <%!-- (beside the shape) is untouched for its other consumers. --%>
                    <%!-- nav_buttons: an annotator's eye is the AnnotationBurn    --%>
                    <%!-- hook's, not Etcher's — the press has to end the editing  --%>
                    <%!-- session (composing the burn while the overlay is still   --%>
                    <%!-- up) and swap to the clean original, which a client-side  --%>
                    <%!-- overlay toggle cannot do. Etcher's own :visibility stays --%>
                    <%!-- for read-only viewers, where there is no session to end  --%>
                    <%!-- and hiding the locked overlay IS the whole job. Both are --%>
                    <%!-- session-only: the next open starts with markup showing.  --%>
                    <Etcher.layer
                      fresco_id={"media-zoom-" <> f.file_uuid}
                      colors={@etcher_colors}
                      line_params={@etcher_line_params}
                      panel_offset={%{top: 12, right: if(@has_next, do: 40, else: 12)}}
                      panel_toggle={:nav}
                      tooltip_dock={:panel}
                      connectors={:off}
                      toolbar={@can_annotate}
                      nav_buttons={if @can_annotate, do: [:pencil], else: [:visibility]}
                      tools={
                        if @can_annotate,
                          do: [
                            :grabber,
                            :image,
                            :rectangle,
                            :circle,
                            :polygon,
                            :freehand,
                            :marker,
                            :highlighter,
                            :callout,
                            :text,
                            :textbox,
                            :dimension,
                            :arrow,
                            :line,
                            :eraser
                          ],
                          else: []
                      }
                    />
                    <%!-- Zoom ladder — see tessera_ladder/1 for why it opens on --%>
                    <%!-- `small` and tops out at `large` (DZI tiles past 4K).   --%>
                    <% {tessera_sources, tessera_dzi} = tessera_ladder(f) %>
                    <%= if tessera_sources != [] do %>
                      <Tessera.layer
                        fresco_id={"media-zoom-" <> f.file_uuid}
                        sources={tessera_sources}
                        dzi_url={tessera_dzi}
                      />
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% is_binary(f.mime_type) and String.starts_with?(f.mime_type, "video/") -> %>
              <%!-- w/h-full + object-contain, not max-w/h: max-* only caps, so a
               small-intrinsic video (or one whose metadata hasn't loaded —
               300×150 until then) rendered as a tiny box floating in the
               lightbox. Filling the column and letterboxing via
               object-contain sizes the player like the image viewer sizes
               images, whatever the source dimensions. --%>
              <video
                src={f.urls["original"]}
                controls
                class="w-full h-full object-contain rounded"
                preload="metadata"
              >
                {gettext("Your browser does not support the video tag.")}
              </video>
            <% f.mime_type == "application/pdf" -> %>
              <iframe
                src={f.urls["original"]}
                sandbox="allow-same-origin"
                class="w-full h-full rounded border-0"
                title={f.filename}
              ></iframe>
            <% audio?(f) -> %>
              <%!-- WaveformPlayer lazy-loads WaveSurfer (only when an audio file is
               open) and renders an interactive waveform driven by a single
               play/pause button. The hidden native <audio> is the playback
               source and the fallback (revealed) if the library can't load. --%>
              <%!-- max-w + mx-auto so the player sits centered as a card instead
               of the button/waveform stretching across the full lightbox
               width on large screens. --%>
              <div
                id={"waveform-" <> f.file_uuid}
                phx-hook="WaveformPlayer"
                class="flex flex-col gap-4 py-10 w-full max-w-3xl mx-auto px-8"
              >
                <div class="flex items-center gap-2">
                  <.icon name="hero-musical-note" class="w-5 h-5 text-base-content/50 shrink-0" />
                  <p class="text-sm font-semibold truncate">{f.filename}</p>
                </div>
                <div class="flex items-center gap-4">
                  <button
                    type="button"
                    data-waveform-toggle
                    class="btn btn-primary btn-circle shrink-0"
                    aria-label={gettext("Play / Pause")}
                  >
                    <span data-waveform-icon="play">
                      <.icon name="hero-play-solid" class="w-5 h-5" />
                    </span>
                    <span data-waveform-icon="pause" class="hidden">
                      <.icon name="hero-pause-solid" class="w-5 h-5" />
                    </span>
                  </button>
                  <div
                    id={"waveform-canvas-" <> f.file_uuid}
                    data-waveform
                    phx-update="ignore"
                    class="flex-1 min-h-[96px]"
                  >
                  </div>
                </div>
                <audio src={f.urls["original"]} preload="metadata" data-waveform-audio>
                  {gettext("Your browser does not support the audio tag.")}
                </audio>
              </div>
            <% true -> %>
              <div class="flex flex-col items-center justify-center text-base-content/50 py-12">
                <.icon name={file_icon(f.file_type)} class="w-32 h-32 mb-4" />
                <p class="text-2xl font-semibold">
                  {String.upcase(f.file_type || gettext("FILE"))}
                </p>
                <p class="text-sm text-base-content/70 mt-2">{f.mime_type}</p>
              </div>
          <% end %>

          <%!-- Sidebar collapse/expand toggle. On desktop with the sidebar    --%>
          <%!-- expanded the control lives on the seam itself (the zero-width  --%>
          <%!-- host between the columns, below) — this in-viewer copy serves  --%>
          <%!-- the states with no seam: collapsed (viewer spans the full      --%>
          <%!-- popup) and stacked mobile, where the modal's close button owns --%>
          <%!-- top-right, so the toggle shifts inward next to it (right-14).  --%>
          <%!-- The choice is persisted per-user (survives prev/next+reopen).  --%>
          <button
            :if={not @viewer_only}
            type="button"
            phx-click="toggle_viewer_sidebar"
            phx-target={@myself}
            class={[
              "btn btn-ghost btn-sm btn-circle absolute top-3 z-30 bg-base-100 hover:bg-base-200 shadow-lg ring-1 ring-base-300",
              if(@sidebar_collapsed, do: "right-14", else: "right-14 lg:landscape:hidden")
            ]}
            title={
              if @sidebar_collapsed, do: gettext("Show details"), else: gettext("Hide details")
            }
            aria-label={
              if @sidebar_collapsed, do: gettext("Show details"), else: gettext("Hide details")
            }
          >
            <.icon
              name={if @sidebar_collapsed, do: "hero-chevron-left", else: "hero-chevron-right"}
              class="w-4 h-4 rotate-90 lg:landscape:rotate-0"
            />
          </button>

          <%!-- Transient rotation save-status pill — persist_rotation writes  --%>
          <%!-- are otherwise invisible (indistinguishable from a view-only     --%>
          <%!-- rotation). Shown for a moment after each actual save / failure; --%>
          <%!-- auto-hidden by the :clear_rotation_status timer.                 --%>
          <div
            :if={@rotation_status}
            class={[
              "absolute bottom-4 left-1/2 -translate-x-1/2 z-20 badge shadow-lg gap-1",
              @rotation_status == :saved && "badge-success",
              @rotation_status == :error && "badge-error"
            ]}
          >
            <.icon
              name={
                if @rotation_status == :saved, do: "hero-check", else: "hero-exclamation-triangle"
              }
              class="w-3.5 h-3.5"
            />
            {if @rotation_status == :saved,
              do: gettext("Rotation saved"),
              else: gettext("Failed to save rotation")}
          </div>

          <%!-- Floating reply popup — opened by the tooltip's Reply button    --%>
          <%!-- (the etcher:tooltip-action bridge), positioned above its shape --%>
          <%!-- by the AnnotationComposerPosition JS hook (it parses the uuid  --%>
          <%!-- from the id suffix and looks the shape up via [data-uuid]).    --%>
          <%!-- Body-only: the shape's label is its title; this box is what    --%>
          <%!-- the user wants to SAY about it, threaded under the shape's     --%>
          <%!-- master comment. --%>
          <%= if @replying_annotation_uuid && @current_user do %>
            <div
              id={"annotation-composer-popover-" <> @replying_annotation_uuid}
              phx-hook="AnnotationComposerPosition"
              class="absolute z-30 w-80 max-w-[calc(100%-1rem)] bg-base-100 rounded-lg shadow-xl border border-base-300 p-3"
              style="left: 0px; top: 0px;"
            >
              <div class="flex items-center gap-2 text-sm font-medium mb-2">
                <.icon name="hero-chat-bubble-left-right" class="w-4 h-4 text-primary" />
                <span>{gettext("Reply to this annotation")}</span>
              </div>
              <.live_component
                module={PhoenixKitWeb.Components.AnnotationComposer}
                id={"annotation-composer-" <> @replying_annotation_uuid}
                annotation_uuid={@replying_annotation_uuid}
                mode={:reply}
                parent_uuid={@reply_parent_uuid}
                file_uuid={f.file_uuid}
                current_user={@current_user}
                parent_id={@id}
                parent_module={PhoenixKitWeb.Components.MediaCanvasViewer}
              />
            </div>
          <% end %>
        </div>

        <%!-- Seam host for the sidebar toggle: a zero-width flex column       --%>
        <%!-- exactly on the viewer/sidebar line, so the chevron straddles     --%>
        <%!-- the boundary it controls. It can't live in either neighbor —    --%>
        <%!-- the viewer clips (overflow-hidden) and the sidebar scrolls      --%>
        <%!-- (overflow-y-auto) — and it only exists where the seam does:     --%>
        <%!-- desktop, sidebar expanded. Collapsed and stacked-mobile keep    --%>
        <%!-- the in-viewer button above.                                     --%>
        <div
          :if={not @viewer_only and not @sidebar_collapsed}
          class="relative w-0 z-30 hidden lg:landscape:block"
        >
          <button
            type="button"
            data-sidebar-seam-toggle
            phx-click="toggle_viewer_sidebar"
            phx-target={@myself}
            class="btn btn-ghost btn-sm btn-circle absolute top-3 -translate-x-1/2 bg-base-100 hover:bg-base-200 shadow-lg ring-1 ring-base-300"
            title={gettext("Hide details")}
            aria-label={gettext("Hide details")}
          >
            <.icon name="hero-chevron-right" class="w-4 h-4" />
          </button>
        </div>

        <%!-- Sidebar: download + title + filename + file facts + comments. Suppressed --%>
        <%!-- in viewer_only mode — standalone-page hosts render their own  --%>
        <%!-- sidebar with admin actions / metadata editor / file details —  --%>
        <%!-- and while collapsed via the viewer-corner toggle above.        --%>
        <%!-- data-viewer-sidebar: read by the InstantViewer hook when this   --%>
        <%!-- viewer announces itself, so the next stand-in predicts the same --%>
        <%!-- image/sidebar split this open actually used — the server-       --%>
        <%!-- rendered pref only covers the first open of a session.          --%>
        <div
          :if={not @viewer_only and not @sidebar_collapsed}
          data-viewer-sidebar
          class="flex-[3] flex flex-col gap-3 p-4 overflow-y-auto lg:landscape:min-w-[280px] lg:landscape:max-w-[26rem] lg:portrait:flex-initial lg:portrait:max-h-[32vh] bg-base-100"
        >
          <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50 pr-10">
            {gettext("Media details")}
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <%= if f.urls["original"] do %>
              <a
                href={f.urls["original"]}
                download={f.filename}
                target="_blank"
                rel="noopener"
                class="btn btn-primary btn-sm gap-2"
              >
                <.icon name="hero-arrow-down-tray" class="w-4 h-4" /> {gettext("Download")}
              </a>
            <% end %>
            <details :if={download_variants(f.urls) != []} class="dropdown">
              <summary class="btn btn-ghost btn-sm">{gettext("Download")}</summary>
              <ul class="dropdown-content menu bg-base-100 rounded-box shadow-lg z-10 w-60">
                <li :for={{name, url} <- download_variants(f.urls)}>
                  <a href={download_url(url)} download={f.filename} target="_blank" rel="noopener">
                    {name}
                  </a>
                </li>
              </ul>
            </details>
            <button
              :if={
                @file_writable && @edit_target && f.file_type == "image" &&
                  PhoenixKit.Modules.Storage.ImageEditing.editable_mime?(f.mime_type)
              }
              type="button"
              phx-click="edit_image"
              phx-target={@myself}
              class="btn btn-ghost btn-sm gap-2"
            >
              <.icon name="hero-adjustments-horizontal" class="w-4 h-4" /> {gettext("Edit image")}
            </button>
            <%!-- See MediaBrowser's `:featured` attr. This component owns no
                  pointer of its own — the click goes straight to the parent
                  LiveComponent (`:parent_id`), same routing as close/prev/next.
                  A trashed file is never offered: the browser's three kebabs
                  gate the same action on `!@filter_trash`, and the viewer opens
                  on trashed files too (the trash listing's tiles click through
                  to it), so without this a file on its way out could still be
                  made the host's featured image. Read defensively — only a host
                  that opted into `:featured` gets here, and `@featured &&`
                  short-circuits for everyone else. --%>
            <button
              :if={@featured && f.file_type == "image" && Map.get(f, :status) != "trashed"}
              type="button"
              phx-click={
                if @featured.uuid == f.file_uuid, do: "unset_featured", else: "set_featured"
              }
              phx-target={"##{@parent_id}"}
              phx-value-file-uuid={f.file_uuid}
              class="btn btn-ghost btn-sm gap-2"
            >
              <.icon
                name={if @featured.uuid == f.file_uuid, do: "hero-star-solid", else: "hero-star"}
                class="w-4 h-4"
              />
              {if @featured.uuid == f.file_uuid,
                do: gettext("Unset featured"),
                else: gettext("Set as featured")}
            </button>
            <%!-- Admin-context hosts pass details_path — the file's storage page --%>
            <%!-- (renditions, checksums, the buckets holding each copy).         --%>
            <.link
              :if={@details_path}
              navigate={@details_path}
              class="btn btn-ghost btn-sm gap-2"
            >
              <.icon name="hero-circle-stack" class="w-4 h-4" /> {gettext("Storage")}
            </.link>
          </div>

          <%!-- Title & description — the file's own words about itself,      --%>
          <%!-- collapsible behind a chevron. The same text the admin detail   --%>
          <%!-- page's editor writes (Storage.FileDetails): a tab per language --%>
          <%!-- of the site, one Save.                                         --%>
          <%!-- Opens itself when there is something to see; editable in the   --%>
          <%!-- contexts that can already reach the metadata editor            --%>
          <%!-- (details_path / edit_target hosts), read-only elsewhere —      --%>
          <%!-- and hidden entirely when it is both empty and uneditable,      --%>
          <%!-- because an empty section nobody can fill is furniture.         --%>
          <% can_edit_meta = @file_writable and can_edit_media_meta?(@details_path, @edit_target) %>
          <div
            :if={
              Enum.any?(Map.values(@media_meta), &(&1 != "")) or @media_tags != [] or
                can_edit_meta
            }
            class="border-t border-base-300 pt-2"
          >
            <button
              type="button"
              phx-click="toggle_media_details"
              phx-target={@myself}
              class="flex items-center justify-between w-full text-left gap-2"
            >
              <span class="text-sm font-semibold text-base-content/70">
                {gettext("Title & description")}
              </span>
              <.icon
                name={if @media_details_open, do: "hero-chevron-up", else: "hero-chevron-down"}
                class="w-4 h-4 text-base-content/50 shrink-0"
              />
            </button>
            <%= if @media_details_open do %>
              <%= if can_edit_meta do %>
                <form
                  id={"media-meta-form-" <> f.file_uuid}
                  phx-submit="save_media_details"
                  phx-target={@myself}
                  class="mt-2 space-y-2"
                >
                  <PhoenixKitWeb.Components.Core.FileDetailsFields.file_details_fields
                    id={"media-meta-fields-" <> f.file_uuid}
                    languages={@media_meta_langs}
                    lang={@media_meta_lang || ""}
                    values={@media_meta_values}
                    placeholders={@media_meta_placeholders}
                    show_alt={f.file_type == "image"}
                    labels={false}
                  />
                  <input
                    type="text"
                    id={"media-meta-tags-" <> f.file_uuid}
                    name="tags"
                    value={Enum.join(@media_tags, ", ")}
                    aria-label={gettext("Tags (comma-separated)")}
                    placeholder={gettext("Tags (comma-separated)")}
                    class="input input-sm w-full"
                  />
                  <div class="flex items-center gap-2">
                    <button type="submit" class="btn btn-primary btn-xs">{gettext("Save")}</button>
                    <span :if={@media_meta_status == :saved} class="text-xs text-success">
                      {gettext("Saved")}
                    </span>
                    <span :if={@media_meta_status == :error} class="text-xs text-error">
                      {gettext("Could not save")}
                    </span>
                  </div>
                </form>
              <% else %>
                <div class="mt-2 space-y-1">
                  <p :if={@media_meta.title != ""} class="text-sm font-semibold break-words">
                    {@media_meta.title}
                  </p>
                  <p :if={@media_meta.alt != ""} class="text-xs text-base-content/60 break-words">
                    {gettext("Alt text")}: {@media_meta.alt}
                  </p>
                  <p
                    :if={@media_meta.description != ""}
                    class="text-sm text-base-content/70 whitespace-pre-wrap break-words"
                  >
                    {@media_meta.description}
                  </p>
                  <div :if={@media_tags != []} class="flex flex-wrap gap-1">
                    <span :for={tag <- @media_tags} class="badge badge-sm h-auto">{tag}</span>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>

          <h2 class="text-base font-bold break-all leading-tight">
            {f.filename}
          </h2>

          <div class="text-sm space-y-2 -mt-1">
            <div>
              <span class="text-base-content/60">{gettext("Type:")}</span>
              <span class="ml-1 badge badge-ghost">
                {String.upcase(f.file_type || gettext("FILE"))}
              </span>
            </div>
            <div class="break-all">
              <span class="text-base-content/60">{gettext("MIME:")}</span>
              <span class="ml-1 font-mono text-xs">{f.mime_type}</span>
            </div>
            <div>
              <span class="text-base-content/60">{gettext("Size:")}</span>
              <span class="ml-1">{format_file_size(f.size)}</span>
            </div>
            <div :if={f[:width] && f[:height]}>
              <span class="text-base-content/60">{gettext("Dimensions:")}</span>
              <span class="ml-1">
                {f.width} × {f.height} px · {PhoenixKit.Modules.Storage.Shape.megapixels(
                  f.width,
                  f.height
                )} MP
                <span :if={PhoenixKit.Modules.Storage.Shape.classify(f) == :wide}>
                  · {gettext("Panorama")}
                </span>
              </span>
            </div>
            <div :if={@file_row && @file_row.pages}>
              <span class="text-base-content/60">{gettext("Pages:")}</span>
              <span class="ml-1">{@file_row.pages}</span>
            </div>
            <div>
              <span class="text-base-content/60">{gettext("Uploaded:")}</span>
              <span class="ml-1">
                {PhoenixKit.Utils.Date.format_short_datetime(f.inserted_at)}
              </span>
            </div>
            <div :if={@file_row && @file_row.uploader} class="break-all">
              <span class="text-base-content/60">{gettext("Uploaded by:")}</span>
              <span class="ml-1">{@file_row.uploader}</span>
            </div>
            <div :if={changed_since_upload?(@file_row)}>
              <span class="text-base-content/60">{gettext("Updated:")}</span>
              <span class="ml-1">
                {PhoenixKit.Utils.Date.format_short_datetime(@file_row.updated_at)}
              </span>
            </div>
            <div :if={@file_row && (@file_row.status != "active" or @file_row.edited?)}>
              <span class="text-base-content/60">{gettext("Status:")}</span>
              <span
                :if={@file_row.status != "active"}
                class={[
                  "ml-1 badge badge-sm",
                  @file_row.status == "processing" && "badge-info",
                  @file_row.status == "failed" && "badge-error",
                  @file_row.status == "trashed" && "badge-warning"
                ]}
              >
                {status_label(@file_row.status)}
              </span>
              <span :if={@file_row.edited?} class="ml-1 badge badge-ghost badge-sm">
                {gettext("Edited")}
              </span>
            </div>
            <div :if={@file_row && @file_row.uuid} class="break-all">
              <span class="text-base-content/60">{gettext("File UUID:")}</span>
              <span class="ml-1 font-mono text-[10px] select-all">{@file_row.uuid}</span>
            </div>
          </div>

          <%!-- Removing a file: the browser that opened the viewer owns the --%>
          <%!-- scope and the trash, so these go to it (as "Set as featured") --%>
          <%!-- and it closes the viewer once the file is gone from the view. --%>
          <div
            :if={@edit_target && @file_writable && @parent_id}
            class="flex flex-wrap items-center gap-2 border-t border-base-300 pt-2"
          >
            <%= if @file_row && @file_row.status == "trashed" do %>
              <button
                type="button"
                phx-click="restore_file"
                phx-value-file-uuid={f.file_uuid}
                phx-target={"##{@parent_id}"}
                class="btn btn-success btn-outline btn-sm gap-2"
              >
                <.icon name="hero-arrow-uturn-left" class="w-4 h-4" /> {gettext("Restore")}
              </button>
              <button
                type="button"
                phx-click="delete_file"
                phx-value-file-uuid={f.file_uuid}
                phx-target={"##{@parent_id}"}
                data-confirm={gettext("Permanently delete this file? This cannot be undone.")}
                class="btn btn-error btn-outline btn-sm gap-2"
              >
                <.icon name="hero-trash" class="w-4 h-4" /> {gettext("Delete forever")}
              </button>
            <% else %>
              <button
                type="button"
                phx-click="trash_file"
                phx-value-file_uuid={f.file_uuid}
                phx-target={"##{@parent_id}"}
                class="btn btn-error btn-outline btn-sm gap-2"
              >
                <.icon name="hero-trash" class="w-4 h-4" /> {gettext("Move to trash")}
              </button>
            <% end %>
          </div>

          <%!-- The photo's EXIF: camera, exposure, dates and where it was      --%>
          <%!-- taken. Only where the title editor is offered — it tells where  --%>
          <%!-- a photo was taken, which a public lightbox must not.            --%>
          <div
            :if={f.file_type == "image" and can_edit_media_meta?(@details_path, @edit_target)}
            class="border-t border-base-300 pt-2"
          >
            <PhoenixKitWeb.Components.Core.FileExifPanel.file_exif_panel
              id={"media-exif-" <> f.file_uuid}
              exif={@file_exif}
              latitude={elem(@file_geo, 0)}
              longitude={elem(@file_geo, 1)}
              tags={@exif_tags}
              status={@exif_status}
              can_read={@file_writable}
              target={@myself}
            />
          </div>

          <%!-- Comments section — gated on the Comments module being     --%>
          <%!-- installed AND enabled, plus a logged-in user. Keyed by    --%>
          <%!-- file_uuid so prev/next remounts the component cleanly.    --%>
          <%!--                                                            --%>
          <%!-- The wrapper applies a compact-mode override: shrinks the  --%>
          <%!-- comments component's typography, paddings, and avatars    --%>
          <%!-- via descendant selectors so it fits inside the sidebar    --%>
          <%!-- without truncation. The component itself isn't modified.  --%>
          <%= if comments_enabled?() and @current_user do %>
            <div class="border-t border-base-300 pt-3 mt-3 leaf-comments-compact">
              <.live_component
                module={PhoenixKitComments.Web.CommentsComponent}
                id={"media-comments-" <> f.file_uuid}
                resource_type="file"
                resource_uuid={f.file_uuid}
                current_user={@current_user}
                show_likes={true}
                title={gettext("Comments")}
                comment_decorations={build_comment_decorations(@viewer_annotations)}
                parent_module={PhoenixKitWeb.Components.MediaCanvasViewer}
                parent_id={@id}
              />
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
