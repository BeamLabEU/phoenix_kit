<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={gettext("Modules")}
  page_subtitle={gettext("Manage modules")}
  current_path={@url_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <div class="flex flex-col px-4 py-6">
    <%!-- Dependency warnings --%>
    <div :if={@dep_warnings != []} class="mb-4 space-y-2">
      <div
        :for={w <- @dep_warnings}
        class="alert alert-warning flex items-center gap-2 py-2 text-sm"
      >
        <.icon name="hero-exclamation-triangle" class="w-4 h-4 shrink-0" />
        <span>
          <strong>{w.module_name}</strong>
          {gettext("requires the")} <strong>{w.requires_key}</strong>
          {gettext("module to be enabled. Some features may not work correctly.")}
        </span>
      </div>
    </div>

    <.nav_tabs
      active_tab={@modules_tab}
      on_change="switch_modules_tab"
      variant={:border}
      class="mb-6"
      tabs={[
        %{
          id: "active",
          label: gettext("Active"),
          icon: "hero-check-circle",
          badge: @modules_tab_counts.active
        },
        %{
          id: "disabled",
          label: gettext("Disabled"),
          icon: "hero-pause-circle",
          badge: @modules_tab_counts.disabled
        },
        %{
          id: "not_installed",
          label: gettext("Not Installed"),
          icon: "hero-cube-transparent",
          badge: @modules_tab_counts.not_installed
        }
      ]}
    />

    <div
      :if={
        @modules_tab in ["active", "disabled"] and
          Map.get(@modules_tab_counts, String.to_existing_atom(@modules_tab)) == 0
      }
      class="alert alert-info"
    >
      <.icon name="hero-information-circle" class="w-5 h-5" />
      <span :if={@modules_tab == "active"}>{gettext("No modules are currently enabled.")}</span>
      <span :if={@modules_tab == "disabled"}>{gettext("No modules are currently disabled.")}</span>
    </div>

    <div
      :if={@modules_tab in ["active", "disabled"]}
      class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"
    >
      <%!-- Crawlers Module --%>
      <%= if "crawlers" in @accessible_modules and modules_tab_match?(@modules_tab, module_enabled?(@module_configs["crawlers"] || %{})) do %>
        <% cfg = @module_configs["crawlers"] || %{} %>
        <PhoenixKitWeb.Components.Core.ModuleCard.module_card
          title={gettext("Crawlers")}
          description={
            gettext("Control how search engines and AI bots crawl and index this site")
          }
          icon="🕷️"
          enabled={cfg[:module_enabled]}
          toggle_event="toggle_module"
          toggle_key="crawlers"
        >
          <:status_badges>
            <span class={[
              "badge",
              if(cfg[:module_enabled], do: "badge-success", else: "badge-neutral")
            ]}>
              {if cfg[:module_enabled], do: gettext("Enabled"), else: gettext("Disabled")}
            </span>
          </:status_badges>

          <:action_buttons>
            <%= if cfg[:module_enabled] do %>
              <.link
                navigate={
                  PhoenixKit.Utils.Routes.locale_aware_path(
                    assigns,
                    "/admin/settings/crawlers"
                  )
                }
                class="btn btn-sm w-full btn-primary"
              >
                <.icon name="hero-cog-6-tooth" class="w-4 h-4 mr-1" /> {gettext("Configure")}
              </.link>
            <% else %>
              <span class="text-xs text-base-content/50 text-center">
                {gettext("Enable module to access settings")}
              </span>
            <% end %>
          </:action_buttons>

          <:stats>
            <div class="text-sm">
              <span class="text-base-content/70">{gettext("Noindex")}:</span>
              <span class="ml-2 font-medium">
                {if cfg[:no_index_enabled], do: gettext("On"), else: gettext("Off")}
              </span>
            </div>
            <div class="text-sm">
              <span class="text-base-content/70">{gettext("Blocked groups")}:</span>
              <span class="ml-2 font-medium">
                {length(cfg[:blocked_groups] || [])}
              </span>
            </div>
          </:stats>
        </PhoenixKitWeb.Components.Core.ModuleCard.module_card>
      <% end %>

      <%!-- Sitemap Module --%>
      <%= if "sitemap" in @accessible_modules and modules_tab_match?(@modules_tab, module_enabled?(@module_configs["sitemap"] || %{})) do %>
        <% cfg = @module_configs["sitemap"] || %{} %>
        <PhoenixKitWeb.Components.Core.ModuleCard.module_card
          title={gettext("Sitemap")}
          description={
            gettext("Generate XML sitemaps for search engines with styled browser display")
          }
          icon="🗺️"
          enabled={cfg[:enabled] || false}
          toggle_event="toggle_module"
          toggle_key="sitemap"
        >
          <:status_badges>
            <span class={[
              "badge",
              if(cfg[:enabled], do: "badge-success", else: "badge-neutral")
            ]}>
              {if cfg[:enabled], do: gettext("Enabled"), else: gettext("Disabled")}
            </span>
            <%= if cfg[:enabled] && cfg[:schedule_enabled] do %>
              <span class="badge badge-outline ml-2 whitespace-nowrap">
                {gettext("Auto-regenerate")}
              </span>
            <% end %>
          </:status_badges>

          <:action_buttons>
            <div class="flex flex-col gap-2 w-full">
              <%= if cfg[:enabled] do %>
                <.link
                  navigate={
                    PhoenixKit.Utils.Routes.path("/admin/settings/sitemap",
                      locale: :none
                    )
                  }
                  class="btn btn-sm btn-primary"
                >
                  <.icon name="hero-cog-6-tooth" class="w-4 h-4 mr-1" /> {gettext("Configure")}
                </.link>
                <.link
                  href={PhoenixKit.Utils.Routes.path("/sitemap.xml", locale: :none)}
                  target="_blank"
                  class="btn btn-outline btn-sm"
                >
                  <.icon name="hero-arrow-top-right-on-square" class="w-4 h-4 mr-1" /> {gettext(
                    "Sitemap"
                  )}
                </.link>
              <% else %>
                <span class="text-xs text-base-content/50 text-center">
                  {gettext("Enable module to access settings")}
                </span>
              <% end %>
            </div>
          </:action_buttons>

          <:stats>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div>
                <span class="text-base-content/70">{gettext("URLs")}:</span>
                <span class="font-medium">{cfg[:url_count]}</span>
              </div>
              <div>
                <span class="text-base-content/70">{gettext("Last gen")}:</span>
                <span class="font-medium">
                  {format_timestamp(cfg[:last_generated])}
                </span>
              </div>
            </div>
          </:stats>
        </PhoenixKitWeb.Components.Core.ModuleCard.module_card>
      <% end %>

      <%!-- Pages module remains disabled but code retained for future use --%>

      <%!-- Legal Module --%>
      <%!-- External Modules (auto-discovered) --%>
      <%= for ext <- @external_modules,
              ext.key in @accessible_modules,
              modules_tab_match?(@modules_tab, ext.enabled) do %>
        <PhoenixKitWeb.Components.Core.ModuleCard.module_card
          title={Gettext.gettext(PhoenixKitWeb.Gettext, ext.name)}
          description={Gettext.gettext(PhoenixKitWeb.Gettext, ext.description)}
          icon={ext.icon}
          enabled={ext.enabled}
          toggle_event="toggle_module"
          toggle_key={ext.key}
        >
          <:status_badges>
            <span class={[
              "badge",
              if(ext.enabled, do: "badge-success", else: "badge-neutral")
            ]}>
              {if ext.enabled, do: gettext("Enabled"), else: gettext("Disabled")}
            </span>
            <span class="badge badge-outline">v{ext.version}</span>
            <span class="badge badge-info badge-outline">{gettext("External")}</span>
            <%= for req_mod <- ext.required_modules do %>
              <%= unless module_enabled?(@module_configs[req_mod] || %{}) do %>
                <span class="badge badge-warning">
                  {gettext("Requires %{module}", module: String.capitalize(req_mod))}
                </span>
              <% end %>
            <% end %>
            <%!-- Module-specific badges from config --%>
            <%= if ext.enabled do %>
              <%= if Map.has_key?(ext.config, :save_body) do %>
                <span class="badge badge-outline whitespace-nowrap">
                  {if ext.config[:save_body],
                    do: gettext("Body Saved"),
                    else: gettext("Headers Only")}
                </span>
              <% end %>
            <% end %>
          </:status_badges>

          <:action_buttons>
            <div class="flex flex-col items-stretch space-y-2 w-full">
              <%= if ext.enabled do %>
                <%= if ext.settings_path do %>
                  <.link
                    navigate={PhoenixKit.Utils.Routes.path(ext.settings_path)}
                    class="btn btn-primary btn-sm"
                  >
                    <.icon name="hero-cog-6-tooth" class="w-4 h-4 mr-1" /> {gettext("Configure")}
                  </.link>
                <% end %>
                <%= if ext.admin_links != [] do %>
                  <div class="flex flex-wrap gap-2">
                    <%= for link <- ext.admin_links do %>
                      <.link
                        navigate={PhoenixKit.Utils.Routes.path(link.path)}
                        class="btn btn-outline btn-sm flex-1"
                      >
                        <%= if link.icon do %>
                          <.icon name={link.icon} class="w-4 h-4 mr-1" />
                        <% end %>
                        {link.label}
                      </.link>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <%= if ext.settings_path do %>
                  <.link
                    navigate={PhoenixKit.Utils.Routes.path(ext.settings_path)}
                    class="btn btn-outline btn-sm"
                  >
                    <.icon name="hero-cog-6-tooth" class="w-4 h-4 mr-1" /> {gettext("Configure")}
                  </.link>
                <% end %>
              <% end %>
            </div>
          </:action_buttons>

          <:stats :if={function_exported?(ext.module, :module_stats, 0)}>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <%= for stat <- ext.module.module_stats() do %>
                <div>
                  <span class="text-base-content/70">
                    {if is_binary(stat.label),
                      do: Gettext.gettext(PhoenixKitWeb.Gettext, stat.label),
                      else: to_string(stat.label)}:
                  </span>
                  <span class="font-medium">{stat.value}</span>
                </div>
              <% end %>
            </div>
          </:stats>
        </PhoenixKitWeb.Components.Core.ModuleCard.module_card>
      <% end %>
    </div>

    <div :if={@modules_tab == "not_installed"}>
      <%!-- Hex was unreachable. Rendered separately from the list below, because an
           empty list and "we could not ask" look identical to an operator and
           only one of them means there is nothing to install. --%>
      <div :if={@catalog_status == :unavailable} class="mb-8">
        <div class="alert alert-warning">
          <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
          <span>
            {gettext("Couldn't reach hex.pm, so the package list is unavailable right now.")}
            <a href={@hex_browse_url} target="_blank" rel="noopener" class="link">
              {gettext("Browse PhoenixKit packages on hex.pm")} →
            </a>
          </span>
        </div>
      </div>

      <%= if @not_installed_packages == [] do %>
        <div class="alert alert-info">
          <.icon name="hero-information-circle" class="w-5 h-5" />
          <span>{gettext("No additional PhoenixKit packages available to install right now.")}</span>
        </div>
      <% else %>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <%= for pkg <- @not_installed_packages do %>
            <div class="card bg-base-100 shadow border-2 border-dashed border-base-300">
              <div class="card-body">
                <div class="flex items-center gap-3">
                  <.icon name={pkg.icon} class="w-8 h-8 opacity-60" />
                  <div class="flex-1">
                    <h3 class="card-title text-base-content/70">
                      {Gettext.gettext(PhoenixKitWeb.Gettext, pkg.name)}
                    </h3>
                    <p class="text-sm text-base-content/50">
                      {Gettext.gettext(PhoenixKitWeb.Gettext, pkg.description)}
                    </p>
                  </div>
                </div>

                <div class="divider my-2"></div>

                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <span class="badge badge-ghost badge-outline">{gettext("Not installed")}</span>
                  <a
                    :if={pkg.hex_url}
                    href={pkg.hex_url}
                    target="_blank"
                    class="btn btn-xs btn-outline"
                  >
                    <.icon name="hero-arrow-top-right-on-square" class="w-3 h-3" /> Hex.pm
                  </a>
                </div>

                <div class="mt-2">
                  <p class="text-xs text-base-content/40 mb-1">{gettext("Add to mix.exs")}:</p>
                  <code class="block text-xs bg-base-200 rounded p-2 font-mono">
                    {~s|{:#{pkg.package}, "~> 0.1"}|}
                  </code>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%!-- Module Management Help --%>
    <div class="alert alert-info mt-6">
      <.icon name="hero-information-circle" class="w-5 h-5" />
      <div>
        <h3 class="font-bold">{gettext("Module Management")}</h3>
        <p class="text-sm">
          {gettext(
            "Each module can be enabled or disabled using the toggle switches above. Click \"Configure\" to access detailed settings for each module on dedicated pages."
          )}
        </p>
      </div>
    </div>
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
