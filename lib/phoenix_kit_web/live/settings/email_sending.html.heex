<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_subtitle={@page_subtitle}
  page_section={@page_section}
  page_section_path={@page_section_path}
  current_path={@current_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <div class="flex flex-col px-4 py-6 gap-6">
    <.nav_tabs
      active_tab={@active_tab}
      variant={:border}
      tabs={
        UrlTabs.patch_links(
          tabs(@mailbox_local?, @email_settings_sections),
          "/admin/settings/email-sending"
        )
      }
    />

    <div class={@active_tab != "identity" && "hidden"}>
      <.form_section
        title={gettext("Sender Identity")}
        icon="hero-identification"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext("Currently effective:")} {@effective_from_name} &lt;{@effective_from_email}&gt;
        </:subtitle>
        <%!-- A sender the tracking module cannot log is the one failure mode with
           no symptom: mail still goes out, the log stays empty, and nothing in
           the UI says why. Warn where the address is edited. --%>
        <div :if={!@sender_loggable?} class="alert alert-warning">
          <.icon name="hero-exclamation-triangle" class="w-5 h-5 shrink-0" />
          <div>
            <div class="font-semibold">
              {gettext("This sender address cannot be logged")}
            </div>
            <div class="text-sm">
              {gettext(
                "The email tracking module only records messages sent from a full address (name@domain.tld). With %{email} mail is still delivered, but nothing is written to the email log — silently.",
                email: @effective_from_email
              )}
            </div>
          </div>
        </div>

        <form id="sender-identity-form" phx-submit="save_sender_identity" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <.input
              name="from_name"
              type="text"
              value={@from_name}
              label={gettext("From name")}
              placeholder={@effective_from_name}
            />
            <.input
              name="from_email"
              type="email"
              value={@from_email}
              label={gettext("From email")}
              placeholder={@effective_from_email}
            />
          </div>
          <p class="text-xs text-base-content/50">
            {gettext(
              "Leave a field blank to fall back to the application config or built-in default."
            )}
          </p>
          <button type="submit" class="btn btn-primary btn-sm">
            {gettext("Save sender identity")}
          </button>
        </form>
      </.form_section>
    </div>

    <div id="email-branding-panel" class={@active_tab != "branding" && "hidden"}>
      <.form_section title={gettext("Branding")} icon="hero-swatch" body_class="space-y-6">
        <:subtitle>
          {gettext(
            "How emails look: the accent colour of buttons and links, and the logo in the header."
          )}
        </:subtitle>
        <:actions>
          <.pk_link_button
            id="email-preview-link"
            navigate="/admin/settings/email-sending/preview"
            variant="outline"
            class="btn-sm"
          >
            <.icon name="hero-eye" class="w-4 h-4" /> {gettext("Preview emails")}
          </.pk_link_button>
        </:actions>

        <form
          id="email-accent-color-form"
          phx-change="validate_accent_color"
          phx-submit="save_accent_color"
          class="space-y-3"
        >
          <div class="flex flex-col sm:flex-row gap-3 sm:items-end">
            <.input
              id="email-accent-color-input"
              name="accent_color"
              type="text"
              value={@accent_input}
              label={gettext("Accent colour")}
              placeholder={Branding.default_accent_color()}
              autocomplete="off"
              aria-invalid={@accent_error && "true"}
              aria-describedby={@accent_error && "email-accent-color-error"}
              wrapper_class="w-full max-w-xs"
            />
            <label class="flex items-center gap-2 pb-1">
              <span class="sr-only">{gettext("Pick a colour")}</span>
              <input
                id="email-accent-color-picker"
                type="color"
                name="accent_color_picker"
                value={@accent_preview}
                phx-debounce="150"
                class="w-10 h-10 cursor-pointer rounded border border-base-300 bg-transparent"
              />
            </label>
            <div class="flex items-center gap-2 pb-1">
              <span
                id="email-accent-color-swatch"
                class="inline-block w-24 h-10 rounded border border-base-300"
                style={"background-color: #{@accent_preview}"}
                aria-hidden="true"
              ></span>
              <span
                id="email-accent-color-sample"
                class="btn btn-sm border-0 pointer-events-none"
                style={"background-color: #{@accent_preview}; color: #{Branding.text_color_on(@accent_preview)}"}
                aria-hidden="true"
              >
                {gettext("Button")}
              </span>
            </div>
          </div>
          <p :if={@accent_error} id="email-accent-color-error" class="text-sm text-error">
            {accent_format_error()}
          </p>
          <p class="text-xs text-base-content/50">
            {accent_help_text()}
          </p>
          <button id="email-accent-color-save" type="submit" class="btn btn-primary btn-sm">
            {gettext("Save accent colour")}
          </button>
        </form>

        <div id="email-logo-info" class="space-y-2">
          <h4 class="font-medium text-sm">{gettext("Logo")}</h4>
          <%= if @email_logo_url != "" do %>
            <div class="flex items-center gap-3 p-2 bg-base-200 rounded-lg w-fit">
              <img
                id="email-logo-image"
                src={@email_logo_url}
                alt={@project_title}
                class="h-10 w-auto bg-white rounded"
              />
              <span class="text-sm text-base-content/70">
                {gettext("Shown in the header of every email.")}
              </span>
            </div>
          <% else %>
            <p id="email-logo-none" class="text-sm text-base-content/70">
              {gettext(
                "No logo is available to emails, so the header shows the site name. A logo stored in a private library is never used: an email outlives its link."
              )}
            </p>
          <% end %>
          <p class="text-sm">
            <.pk_link
              id="email-logo-settings-link"
              navigate="/admin/settings"
              class="link link-primary"
            >
              {gettext("Change the logo, site name or site URL in Settings → General")}
            </.pk_link>
          </p>
        </div>
      </.form_section>

      <.form_section
        title={gettext("Welcome email")}
        icon="hero-hand-raised"
        body_class="space-y-4"
        class="mt-6"
      >
        <:subtitle>
          {gettext(
            "Sent once to each user, after they confirm their own email address — by the confirmation link, a magic link, a sign-in with a provider that verified the address, or by correcting an address they had not confirmed yet. Not sent when an administrator confirms an account."
          )}
        </:subtitle>
        <:actions>
          <.pk_link_button
            id="email-welcome-preview-link"
            navigate="/admin/settings/email-sending/preview?email=welcome"
            variant="outline"
            class="btn-sm"
          >
            <.icon name="hero-eye" class="w-4 h-4" /> {gettext("Preview")}
          </.pk_link_button>
        </:actions>

        <form id="email-welcome-form" phx-change="toggle_welcome_email">
          <.checkbox
            id="email_welcome_enabled"
            name="enabled"
            checked={@welcome_email_enabled}
            label={gettext("Send a welcome email after an address is confirmed")}
          />
        </form>
      </.form_section>
    </div>

    <div class={@active_tab != "transport" && "hidden"}>
      <.form_section title={gettext("Transport")} icon="hero-server-stack" body_class="space-y-4">
        <:subtitle>
          {gettext("Used when no default transactional integration is selected below.")}
        </:subtitle>

        <div class={["alert", if(@mailer_adapter, do: "alert-success", else: "alert-warning")]}>
          <.icon name="hero-server-stack" class="w-5 h-5 shrink-0" />
          <div>
            <h3 class="font-bold flex items-center gap-2">
              <%= if @mailer_built_in? do %>
                {gettext("Static mailer: built-in PhoenixKit mailer")}
              <% else %>
                {gettext("Static mailer: parent app mailer (%{module})",
                  module: inspect(@mailer_module)
                )}
              <% end %>
              <span class={[
                "badge badge-sm",
                if(@mailer_adapter, do: "badge-success", else: "badge-warning")
              ]}>
                {if @mailer_adapter, do: gettext("Configured"), else: gettext("Not configured")}
              </span>
            </h3>
            <p :if={@mailer_adapter} class="text-sm mt-1">
              {gettext("adapter")}: {inspect(@mailer_adapter)}
            </p>
            <p :if={!@mailer_adapter} class="text-sm mt-1">
              {gettext(
                "No adapter configured for the static mailer. Set one in your application config, or connect an email-capable integration below and pick it as the default transactional integration."
              )}
            </p>
          </div>
        </div>

        <div>
          <h4 class="font-medium text-sm mb-2">{gettext("Email-capable integrations")}</h4>
          <%= if @email_connections == [] do %>
            <p class="text-sm text-base-content/60">
              {gettext("No email-capable integrations connected yet.")}
              <.pk_link
                navigate="/admin/settings/integrations/new"
                class="link link-primary"
              >
                {gettext("Add one")}
              </.pk_link>
            </p>
          <% else %>
            <.table_default variant="zebra" size="sm" class="w-full">
              <.table_default_header>
                <.table_default_row>
                  <.table_default_header_cell>{gettext("Service")}</.table_default_header_cell>
                  <.table_default_header_cell>{gettext("Name")}</.table_default_header_cell>
                  <.table_default_header_cell>{gettext("Status")}</.table_default_header_cell>
                </.table_default_row>
              </.table_default_header>
              <.table_default_body>
                <.table_default_row :for={conn <- @email_connections}>
                  <.table_default_cell>
                    <div class="flex items-center gap-2">
                      <.icon name={conn.provider.icon} class="w-4 h-4 text-base-content/60" />
                      <span>{conn.provider.name}</span>
                    </div>
                  </.table_default_cell>
                  <.table_default_cell>{conn.name}</.table_default_cell>
                  <.table_default_cell>
                    <% {badge_class, badge_text} = integration_status_badge(conn.data["status"]) %>
                    <span class={"badge badge-sm #{badge_class}"}>{badge_text}</span>
                    <% {note_class, _icon} = validation_note_style(conn.data["status"]) %>
                    <span
                      :if={conn.data["validation_status"] not in [nil, "", "ok"]}
                      class={["text-xs block mt-0.5", note_class]}
                    >
                      {conn.data["validation_status"]}
                    </span>
                  </.table_default_cell>
                </.table_default_row>
              </.table_default_body>
            </.table_default>
          <% end %>
        </div>
      </.form_section>
    </div>

    <div :if={@mailbox_local?} class={@active_tab != "mailbox" && "hidden"}>
      <.form_section
        title={gettext("Local dev mailbox")}
        icon="hero-inbox"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext(
            "Where development mail goes while the resolved transport is the local adapter."
          )}
        </:subtitle>

        <div :if={@dev_mailbox_enabled} class="alert alert-warning">
          <.icon name="hero-exclamation-triangle" class="w-5 h-5 shrink-0" />
          <div class="text-sm">
            {gettext(
              "Auth mail carries single-use tokens, and /dev/mailbox has no authentication — anyone who can reach this server can read them. Only for closed environments."
            )}
          </div>
        </div>
        <div :if={!@dev_mailbox_enabled} class="alert alert-info">
          <.icon name="hero-information-circle" class="w-5 h-5 shrink-0" />
          <div class="text-sm">
            {gettext("The mailbox is off: outgoing mail is written to the server log instead.")}
          </div>
        </div>

        <form id="dev-mailbox-form" phx-change="toggle_dev_mailbox">
          <.checkbox
            id="dev_mailbox_enabled"
            name="enabled"
            checked={@dev_mailbox_enabled}
            label={gettext("Deliver development mail to /dev/mailbox")}
          />
        </form>
      </.form_section>
    </div>

    <div class={@active_tab != "default_integration" && "hidden"}>
      <.form_section
        title={gettext("Default Transactional Integration")}
        icon="hero-paper-airplane"
      >
        <:subtitle>
          {gettext(
            "All outbound core mail — authentication, notifications — routes through this integration when set. Leave unset to use the static mailer above. For newsletter broadcasts, see"
          )}
          <.pk_link navigate="/admin/settings/emails-bulk" class="link link-primary">
            {gettext("Emails Bulk")}
          </.pk_link>.
        </:subtitle>
        <form id="default-integration-form" phx-change="select_default_integration">
          <.select
            name="integration_uuid"
            value={@default_integration_uuid}
            prompt={gettext("None — use the static mailer")}
            options={Enum.map(@email_connections, &{"#{&1.provider.name} — #{&1.name}", &1.uuid})}
            class="max-w-md"
          />
        </form>
      </.form_section>
    </div>

    <div class={@active_tab != "test_send" && "hidden"}>
      <.form_section title={gettext("Test Send")} icon="hero-paper-airplane">
        <form
          id="test-send-form"
          phx-submit="send_test_email"
          class="flex flex-col sm:flex-row gap-3 items-start sm:items-end"
        >
          <.input
            name="recipient"
            type="email"
            value=""
            label={gettext("Recipient")}
            placeholder="you@example.com"
            wrapper_class="w-full max-w-sm"
            required
          />
          <button type="submit" class="btn btn-outline btn-sm">
            {gettext("Send test email")}
          </button>
        </form>
      </.form_section>
    </div>

    <div
      :for={section <- @email_settings_sections}
      class={@active_tab != "module_#{section.id}" && "hidden"}
    >
      <.form_section title={section.title} icon="hero-puzzle-piece">
        <.live_component module={section.component} id={section.id} />
      </.form_section>
    </div>
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
