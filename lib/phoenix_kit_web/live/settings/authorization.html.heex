<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_subtitle={@page_subtitle}
  page_section={@page_section}
  page_section_path={@page_section_path}
  current_path={@url_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <div class="flex flex-col px-4 py-6">
    <%!-- Settings Form --%>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <.form
          :let={_form}
          for={@changeset}
          id="authorization_settings_form"
          phx-submit="save_settings"
          phx-change="validate_settings"
          class="space-y-6"
        >
          <%!-- Hidden fields for required settings from other pages --%>
          <%!-- General Settings --%>
          <input
            type="hidden"
            name="settings[project_title]"
            value={@saved_settings["project_title"]}
          />
          <input
            type="hidden"
            name="settings[site_url]"
            value={@saved_settings["site_url"]}
          />
          <input
            type="hidden"
            name="settings[week_start_day]"
            value={@saved_settings["week_start_day"]}
          />
          <input
            type="hidden"
            name="settings[time_zone]"
            value={@saved_settings["time_zone"]}
          />
          <input
            type="hidden"
            name="settings[date_format]"
            value={@saved_settings["date_format"]}
          />
          <input
            type="hidden"
            name="settings[time_format]"
            value={@saved_settings["time_format"]}
          />

          <%!-- Users Settings --%>
          <input
            type="hidden"
            name="settings[allow_registration]"
            value={@saved_settings["allow_registration"]}
          />
          <input
            type="hidden"
            name="settings[new_user_default_role]"
            value={@saved_settings["new_user_default_role"]}
          />
          <input
            type="hidden"
            name="settings[new_user_default_status]"
            value={@saved_settings["new_user_default_status"]}
          />
          <input
            type="hidden"
            name="settings[track_registration_geolocation]"
            value={@saved_settings["track_registration_geolocation"]}
          />

          <.nav_tabs
            active_tab={@active_tab}
            variant={:border}
            tabs={UrlTabs.patch_links(tabs(), "/admin/settings/authorization")}
          />

          <div class={if @active_tab != "branding", do: "hidden"}>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="fieldset w-full">
                <label class="label">
                  <span class="fieldset-legend text-base font-medium">
                    {gettext("Background Image (Desktop)")}
                  </span>
                </label>
                <input
                  type="hidden"
                  name="settings[auth_background_image_file_uuid]"
                  value={@settings["auth_background_image_file_uuid"]}
                />
                <%= if (@settings["auth_background_image_file_uuid"] || "") != "" do %>
                  <div class="flex items-center gap-4">
                    <img
                      src={
                        signed_preview_url(@settings["auth_background_image_file_uuid"], "medium")
                      }
                      alt={gettext("Background preview")}
                      class="h-16 w-28 object-cover rounded-lg ring-1 ring-base-300 shadow-sm"
                    />
                    <div class="flex flex-col gap-2">
                      <button
                        type="button"
                        class="btn btn-outline btn-sm"
                        phx-click="open_media_selector"
                        phx-value-target="background"
                      >
                        {gettext("Change image")}
                      </button>
                      <button
                        type="button"
                        class="btn btn-ghost btn-sm text-error"
                        phx-click="clear_branding_image"
                        phx-value-target="background"
                      >
                        {gettext("Remove")}
                      </button>
                    </div>
                  </div>
                <% else %>
                  <button
                    type="button"
                    class="h-16 w-28 rounded-lg border-2 border-dashed border-base-300 hover:border-primary hover:text-primary text-base-content/40 flex items-center justify-center transition-colors"
                    title={gettext("Select Image")}
                    phx-click="open_media_selector"
                    phx-value-target="background"
                  >
                    <.icon name="hero-photo" class="w-6 h-6" />
                  </button>
                <% end %>
                <div class="label">
                  <span class="fieldset-label text-xs text-base-content/50">
                    {gettext(
                      "Background image for auth pages on desktop screens (wider than 768px)."
                    )}
                  </span>
                </div>
                <.unsaved_hint dirty={
                  @settings["auth_background_image_file_uuid"] !=
                    @saved_settings["auth_background_image_file_uuid"]
                } />
              </div>

              <div class="fieldset w-full">
                <label class="label">
                  <span class="fieldset-legend text-base font-medium">
                    {gettext("Background Image (Mobile)")}
                  </span>
                </label>
                <input
                  type="hidden"
                  name="settings[auth_background_image_mobile_file_uuid]"
                  value={@settings["auth_background_image_mobile_file_uuid"]}
                />
                <%= if (@settings["auth_background_image_mobile_file_uuid"] || "") != "" do %>
                  <div class="flex items-center gap-4">
                    <img
                      src={
                        signed_preview_url(
                          @settings["auth_background_image_mobile_file_uuid"],
                          "medium"
                        )
                      }
                      alt={gettext("Mobile background preview")}
                      class="h-16 w-28 object-cover rounded-lg ring-1 ring-base-300 shadow-sm"
                    />
                    <div class="flex flex-col gap-2">
                      <button
                        type="button"
                        class="btn btn-outline btn-sm"
                        phx-click="open_media_selector"
                        phx-value-target="background_mobile"
                      >
                        {gettext("Change image")}
                      </button>
                      <button
                        type="button"
                        class="btn btn-ghost btn-sm text-error"
                        phx-click="clear_branding_image"
                        phx-value-target="background_mobile"
                      >
                        {gettext("Remove")}
                      </button>
                    </div>
                  </div>
                <% else %>
                  <button
                    type="button"
                    class="h-16 w-28 rounded-lg border-2 border-dashed border-base-300 hover:border-primary hover:text-primary text-base-content/40 flex items-center justify-center transition-colors"
                    title={gettext("Select Image")}
                    phx-click="open_media_selector"
                    phx-value-target="background_mobile"
                  >
                    <.icon name="hero-photo" class="w-6 h-6" />
                  </button>
                <% end %>
                <div class="label">
                  <span class="fieldset-label text-xs text-base-content/50">
                    {gettext(
                      "Background image for auth pages on mobile screens (768px and below). Falls back to desktop image if not set."
                    )}
                  </span>
                </div>
                <.unsaved_hint dirty={
                  @settings["auth_background_image_mobile_file_uuid"] !=
                    @saved_settings["auth_background_image_mobile_file_uuid"]
                } />
              </div>
            </div>

            <div class="fieldset w-full">
              <label class="label">
                <span class="fieldset-legend text-base font-medium">
                  {gettext("Background Color")}
                </span>
              </label>
              <.input
                name="settings[auth_background_color]"
                type="text"
                value={@settings["auth_background_color"]}
                class="focus:input-primary"
                placeholder={gettext("#1a1a2e or linear-gradient(135deg, #667eea, #764ba2)")}
                phx-debounce="500"
              />
              <div class="label">
                <span class="fieldset-label text-xs text-base-content/50">
                  {gettext(
                    "CSS color or gradient for auth page background. Ignored if a background image is set."
                  )}
                </span>
              </div>
              <.unsaved_hint
                dirty={
                  @settings["auth_background_color"] != @saved_settings["auth_background_color"]
                }
                saved={@saved_settings["auth_background_color"]}
              />
            </div>
          </div>

          <div class={if @active_tab != "methods", do: "hidden"}>
            <%!-- Authentication Methods Setting --%>
            <div class="fieldset w-full">
              <%!-- Magic Link Methods --%>
              <div class="mb-3">
                <div class="text-sm font-semibold text-base-content/70 mb-2">
                  {gettext("Magic Link")}
                </div>
                <.checkbox
                  name="settings[magic_link_login_enabled]"
                  checked={@settings["magic_link_login_enabled"] == "true"}
                  label={gettext("Enable Magic Link for login")}
                  wrapper_class="mb-2 ml-4"
                />
                <.checkbox
                  name="settings[magic_link_registration_enabled]"
                  checked={
                    @settings["magic_link_registration_enabled"] == "true" and
                      @settings["allow_registration"] == "true"
                  }
                  disabled={@settings["allow_registration"] != "true"}
                  wrapper_class="ml-4"
                >
                  {gettext("Enable Magic Link for registration")}
                  <%= if @settings["allow_registration"] != "true" do %>
                    <span class="text-xs italic">{gettext("(registration disabled)")}</span>
                  <% end %>
                </.checkbox>
              </div>

              <%!-- QR Code Sign-in --%>
              <div class="mb-3">
                <div class="text-sm font-semibold text-base-content/70 mb-2">
                  {gettext("QR Code")}
                </div>
                <div class="ml-4">
                  <.checkbox
                    name="settings[qr_login_enabled]"
                    checked={@settings["qr_login_enabled"] == "true"}
                    label={gettext("Enable QR code sign-in (scan from a signed-in phone)")}
                  />
                </div>
              </div>

              <%!-- Passkeys --%>
              <div class="mb-3">
                <div class="text-sm font-semibold text-base-content/70 mb-2">
                  {gettext("Passkeys")}
                </div>
                <.checkbox
                  name="settings[passkey_login_enabled]"
                  checked={@settings["passkey_login_enabled"] == "true"}
                  wrapper_class="ml-4"
                >
                  {gettext("Enable sign-in with a passkey (Face ID, Touch ID, Windows Hello)")}
                  <:description>
                    {gettext(
                      "A passkey works only on the domain it was made for: %{domain}. Moving the site to another domain makes every passkey stop working, and people sign in with their password or a magic link instead.",
                      domain: @passkey_domain
                    )}
                  </:description>
                </.checkbox>
              </div>

              <%!-- New Login Alerts --%>
              <div class="mb-3">
                <div class="text-sm font-semibold text-base-content/70 mb-2">
                  {gettext("Login Notifications")}
                </div>
                <.checkbox
                  name="settings[new_login_alert_enabled]"
                  checked={@settings["new_login_alert_enabled"] == "true"}
                  wrapper_class="ml-4"
                >
                  {gettext("Email users when their account is signed in from a new device")}
                </.checkbox>
                <.checkbox
                  name="settings[new_country_login_alert_enabled]"
                  checked={@settings["new_country_login_alert_enabled"] == "true"}
                  wrapper_class="ml-4 mt-2"
                >
                  {gettext("Email users when their account is signed in from a new country")}
                  <:description>
                    {gettext(
                      "Also for a browser they already use. The country comes from the IP address, so a VPN can set it off. An account's first sign-in after this is turned on only records its country."
                    )}
                  </:description>
                </.checkbox>
                <.checkbox
                  name="settings[failed_login_alert_enabled]"
                  checked={@settings["failed_login_alert_enabled"] == "true"}
                  wrapper_class="ml-4 mt-2"
                >
                  {gettext("Email users when failed sign-ins on their account cross a threshold")}
                  <:description>
                    {gettext(
                      "At most one email per account per 24 hours, so an attack cannot flood their inbox."
                    )}
                  </:description>
                </.checkbox>
                <div class="ml-8 mt-2 max-w-xs">
                  <.input
                    id="failed-login-alert-threshold"
                    type="number"
                    min="1"
                    max="10000"
                    name="settings[failed_login_alert_threshold]"
                    value={@settings["failed_login_alert_threshold"] || "10"}
                    label={gettext("Failures in one hour that trigger the email")}
                  />
                </div>
              </div>

              <%!-- OAuth Methods --%>
              <div>
                <div class="text-sm font-semibold text-base-content/70 mb-2">
                  {gettext("OAuth Providers")}
                </div>
                <.checkbox
                  name="settings[oauth_enabled]"
                  checked={@settings["oauth_enabled"] == "true"}
                  wrapper_class="mb-2 ml-4"
                >
                  <span class="font-semibold">{gettext("Enable OAuth (Master Switch)")}</span>
                </.checkbox>

                <%!-- Individual OAuth Providers (locked, not disabled, if master is off —
                   their real stored value must keep submitting so it isn't lost while
                   the master switch is toggled off and back on). --%>
                <div class={[
                  "ml-8 space-y-2",
                  if(@settings["oauth_enabled"] != "true", do: "opacity-50", else: "")
                ]}>
                  <% oauth_locked? = @settings["oauth_enabled"] != "true" %>
                  <.checkbox
                    name="settings[oauth_google_enabled]"
                    checked={@settings["oauth_google_enabled"] == "true"}
                    label={gettext("Google Sign-In")}
                    wrapper_class={oauth_locked? && "pointer-events-none"}
                  />
                  <.checkbox
                    name="settings[oauth_github_enabled]"
                    checked={@settings["oauth_github_enabled"] == "true"}
                    label={gettext("GitHub Sign-In")}
                    wrapper_class={oauth_locked? && "pointer-events-none"}
                  />
                  <.checkbox
                    name="settings[oauth_facebook_enabled]"
                    checked={@settings["oauth_facebook_enabled"] == "true"}
                    label={gettext("Facebook Sign-In")}
                    wrapper_class={oauth_locked? && "pointer-events-none"}
                  />
                </div>

                <%!-- The security decision behind provider sign-in, kept next to the
                   providers it governs so it is visible to whoever enables them. --%>
                <.checkbox
                  name="settings[oauth_require_verified_email]"
                  checked={@settings["oauth_require_verified_email"] != "false"}
                  wrapper_class="mt-4 ml-4"
                >
                  <span class="font-semibold">
                    {gettext("Require the provider to confirm the email address")}
                  </span>
                </.checkbox>
                <p class="text-sm text-base-content/70 ml-4 mt-1">
                  {gettext(
                    "When on, signing in with a provider can only join an existing account if the provider states it verified that address. Turning this off lets anyone who gets an address onto a provider account sign in as its owner — only do so for a provider that does not report verification."
                  )}
                </p>
              </div>

              <%!-- OAuth Provider Credential Forms --%>
              <%= if @settings["oauth_enabled"] == "true" do %>
                <%!-- Google OAuth Credentials --%>
                <div class={[
                  if(@settings["oauth_google_enabled"] != "true", do: "hidden", else: "")
                ]}>
                  <div class="card bg-base-200 p-4 mt-3">
                    <h3 class="font-semibold mb-3 flex items-center gap-2">
                      <PhoenixKitWeb.Components.Core.Icons.icon_google class="h-5 w-5" />
                      {gettext("Google OAuth Credentials")}
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                      <div class="fieldset">
                        <.input
                          type="text"
                          name="settings[oauth_google_client_id]"
                          value={@settings["oauth_google_client_id"] || ""}
                          label={gettext("Client ID")}
                          placeholder={gettext("Your Google OAuth Client ID")}
                        />
                      </div>

                      <div class="fieldset">
                        <.input
                          type="password"
                          name="settings[oauth_google_client_secret]"
                          value=""
                          label={gettext("Client Secret")}
                          placeholder={
                            oauth_secret_placeholder(
                              @settings["oauth_google_client_secret"],
                              gettext("Your Google OAuth Client Secret")
                            )
                          }
                        />
                      </div>
                    </div>

                    <button
                      type="button"
                      phx-click="test_oauth"
                      phx-value-provider="google"
                      class="btn btn-sm btn-outline mt-3 w-fit"
                      phx-disable-with={gettext("Testing…")}
                    >
                      {gettext("Test Credentials")}
                    </button>

                    <.oauth_setup_instructions
                      callback_url={get_oauth_callback_url(@settings, "google")}
                      copy_hint={gettext("Copy this URL to Google Cloud Console")}
                    >
                      <:steps>
                        <li>
                          {gettext("Visit")}
                          <a
                            href="https://console.cloud.google.com/apis/credentials"
                            target="_blank"
                            class="link link-primary"
                          >
                            Google Cloud Console
                          </a>
                        </li>
                        <li>{gettext("Create project or select existing one")}</li>
                        <li>
                          {gettext("Go to")} <strong>{gettext("Credentials")}</strong>
                          → <strong>{gettext("Create Credentials")}</strong>
                          → <strong>{gettext("OAuth client ID")}</strong>
                        </li>
                        <li>
                          {gettext("Select")}
                          <strong>{gettext("Web application")}</strong> {gettext("type")}
                        </li>
                        <li>
                          {gettext("Add callback URL above to")}
                          <strong>{gettext("Authorized redirect URIs")}</strong>
                        </li>
                        <li>{gettext("Copy Client ID and Secret to fields above")}</li>
                        <li>
                          {gettext("Click")}
                          <strong>{gettext("Test Credentials")}</strong> {gettext(
                            "to verify setup"
                          )}
                        </li>
                      </:steps>
                    </.oauth_setup_instructions>
                  </div>
                </div>

                <%!-- GitHub OAuth Credentials --%>
                <div class={[
                  "card bg-base-200 p-4 mt-3",
                  if(@settings["oauth_github_enabled"] != "true", do: "hidden", else: "")
                ]}>
                  <h3 class="font-semibold mb-3 flex items-center gap-2">
                    <PhoenixKitWeb.Components.Core.Icons.icon_github class="h-5 w-5" />
                    {gettext("GitHub OAuth Credentials")}
                  </h3>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="fieldset">
                      <.input
                        type="text"
                        name="settings[oauth_github_client_id]"
                        value={@settings["oauth_github_client_id"] || ""}
                        label={gettext("Client ID")}
                        placeholder={gettext("Your GitHub OAuth Client ID")}
                      />
                    </div>

                    <div class="fieldset">
                      <.input
                        type="password"
                        name="settings[oauth_github_client_secret]"
                        value=""
                        label={gettext("Client Secret")}
                        placeholder={
                          oauth_secret_placeholder(
                            @settings["oauth_github_client_secret"],
                            gettext("Your GitHub OAuth Client Secret")
                          )
                        }
                      />
                    </div>
                  </div>

                  <button
                    type="button"
                    phx-click="test_oauth"
                    phx-value-provider="github"
                    class="btn btn-sm btn-outline mt-3 w-fit"
                    phx-disable-with={gettext("Testing…")}
                  >
                    {gettext("Test Credentials")}
                  </button>

                  <.oauth_setup_instructions
                    callback_url={get_oauth_callback_url(@settings, "github")}
                    copy_hint={gettext("Copy this URL to GitHub OAuth Apps")}
                  >
                    <:steps>
                      <li>
                        {gettext("Visit")}
                        <a
                          href="https://github.com/settings/developers"
                          target="_blank"
                          class="link link-primary"
                        >
                          GitHub Developer Settings
                        </a>
                      </li>
                      <li>
                        {gettext("Go to")} <strong>{gettext("OAuth Apps")}</strong>
                        → <strong>{gettext("New OAuth App")}</strong>
                      </li>
                      <li>
                        {gettext("Enter")} <strong>{gettext("Application name")}</strong>
                        {gettext("and")} <strong>{gettext("Homepage URL")}</strong>
                      </li>
                      <li>
                        {gettext("Add callback URL above to")}
                        <strong>{gettext("Authorization callback URL")}</strong>
                      </li>
                      <li>
                        {gettext("Click")} <strong>{gettext("Register application")}</strong>
                      </li>
                      <li>
                        {gettext("Copy")} <strong>{gettext("Client ID")}</strong>
                        {gettext("and generate/copy")} <strong>{gettext("Client Secret")}</strong>
                      </li>
                      <li>
                        {gettext("Click")}
                        <strong>{gettext("Test Credentials")}</strong> {gettext("to verify setup")}
                      </li>
                    </:steps>
                  </.oauth_setup_instructions>
                </div>

                <%!-- Facebook OAuth Credentials --%>
                <div class={[
                  "card bg-base-200 p-4 mt-3",
                  if(@settings["oauth_facebook_enabled"] != "true", do: "hidden", else: "")
                ]}>
                  <h3 class="font-semibold mb-3 flex items-center gap-2">
                    <PhoenixKitWeb.Components.Core.Icons.icon_facebook class="h-5 w-5" />
                    {gettext("Facebook OAuth Credentials")}
                  </h3>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="fieldset">
                      <.input
                        type="text"
                        name="settings[oauth_facebook_app_id]"
                        value={@settings["oauth_facebook_app_id"] || ""}
                        label={gettext("App ID")}
                        placeholder={gettext("Your Facebook App ID")}
                      />
                    </div>

                    <div class="fieldset">
                      <.input
                        type="password"
                        name="settings[oauth_facebook_app_secret]"
                        value=""
                        label={gettext("App Secret")}
                        placeholder={
                          oauth_secret_placeholder(
                            @settings["oauth_facebook_app_secret"],
                            gettext("Your Facebook App Secret")
                          )
                        }
                      />
                    </div>
                  </div>

                  <button
                    type="button"
                    phx-click="test_oauth"
                    phx-value-provider="facebook"
                    class="btn btn-sm btn-outline mt-3 w-fit"
                    phx-disable-with={gettext("Testing…")}
                  >
                    {gettext("Test Credentials")}
                  </button>

                  <.oauth_setup_instructions
                    callback_url={get_oauth_callback_url(@settings, "facebook")}
                    copy_hint={gettext("Copy this URL to Facebook App Settings")}
                  >
                    <:steps>
                      <li>
                        {gettext("Visit")}
                        <a
                          href="https://developers.facebook.com/apps"
                          target="_blank"
                          class="link link-primary"
                        >
                          Facebook Developers Console
                        </a>
                      </li>
                      <li>
                        {gettext("Create a new app or select existing one")}
                      </li>
                      <li>
                        {gettext("Add")} <strong>Facebook Login</strong> {gettext("product")}
                      </li>
                      <li>
                        {gettext("Go to")} <strong>Facebook Login</strong>
                        → <strong>{gettext("Settings")}</strong>
                      </li>
                      <li>
                        {gettext("Add callback URL above to")}
                        <strong>{gettext("Valid OAuth Redirect URIs")}</strong>
                      </li>
                      <li>
                        {gettext("Go to")} <strong>{gettext("Settings")}</strong>
                        → <strong>{gettext("Basic")}</strong>
                      </li>
                      <li>
                        {gettext("Copy")} <strong>{gettext("App ID")}</strong>
                        {gettext("and")} <strong>{gettext("App Secret")}</strong>
                        {gettext("to fields above")}
                      </li>
                      <li>
                        {gettext("Switch app from")} <strong>{gettext("Development")}</strong>
                        {gettext("to")} <strong>{gettext("Live")}</strong>
                        {gettext("mode")}
                      </li>
                      <li>
                        {gettext("Click")}
                        <strong>{gettext("Test Credentials")}</strong> {gettext("to verify setup")}
                      </li>
                    </:steps>
                  </.oauth_setup_instructions>
                </div>

                <%!-- OAuth Configuration Notice --%>
                <div class="alert alert-info text-sm mt-3 max-w-prose">
                  <.icon name="hero-information-circle" class="stroke-current shrink-0 h-5 w-5" />
                  <div>
                    <div class="font-semibold">{gettext("OAuth Setup Instructions")}</div>
                    <div class="text-xs">
                      <p>{gettext("1. Enable the provider above and save settings")}</p>
                      <p>{gettext("2. Enter your OAuth credentials in the form that appears")}</p>
                      <p>{gettext("3. Save settings again to store credentials")}</p>
                      <p>{gettext("4. Click \"Test Credentials\" to verify configuration")}</p>
                      <p class="mt-1">
                        {gettext(
                          "Note: OAuth providers require ueberauth dependencies to be installed."
                        )}
                      </p>
                    </div>
                  </div>
                </div>

                <%!-- Reload OAuth Configuration Button --%>
                <button
                  type="button"
                  phx-click="reload_oauth_config"
                  class="btn btn-sm btn-outline btn-secondary mt-3"
                >
                  <PhoenixKitWeb.Components.Core.Icons.icon_refresh class="h-4 w-4" />
                  {gettext("Reload OAuth Configuration")}
                </button>
              <% end %>
            </div>
          </div>

          <div class={if @active_tab != "sessions", do: "hidden"}>
            <%!-- Multiple Sessions (account switcher) --%>
            <div class="fieldset w-full">
              <label class="label">
                <span class="fieldset-legend text-base font-medium">
                  {gettext("Multiple Sessions")}
                </span>
                <span class="fieldset-label text-sm text-base-content/60">
                  {gettext("Account switcher for signing in to several accounts at once")}
                </span>
              </label>
              <.checkbox
                name="settings[multi_session_enabled]"
                checked={@settings["multi_session_enabled"] == "true"}
                label={gettext("Enable multiple sessions")}
              >
                <:description>
                  {gettext(
                    "When on, any signed-in user can add other accounts (with their password) and switch between them from the user menu."
                  )}
                </:description>
              </.checkbox>
            </div>

            <div class="fieldset w-full mt-6">
              <label class="label">
                <span class="fieldset-legend text-base font-medium">
                  {gettext("Failed sign-ins")}
                </span>
                <span class="fieldset-label text-sm text-base-content/60">
                  {gettext("What is stored when a password sign-in does not succeed")}
                </span>
              </label>
              <.checkbox
                name="settings[login_attempt_logging_enabled]"
                checked={@settings["login_attempt_logging_enabled"] == "true"}
                label={gettext("Record failed sign-ins")}
              >
                <:description>
                  {gettext(
                    "Aggregated by identifier, network, and hour. Shown on the account holder's settings page and on Active Sessions."
                  )}
                </:description>
              </.checkbox>
              <div class="mt-3 max-w-xs">
                <.input
                  id="login-attempt-retention-days"
                  type="number"
                  min="1"
                  max="3650"
                  name="settings[login_attempt_retention_days]"
                  value={@settings["login_attempt_retention_days"] || "90"}
                  label={gettext("Keep records for (days)")}
                />
              </div>
            </div>
          </div>

          <%!-- Action Buttons --%>
          <div class={["flex gap-3 pt-4", @active_tab == "protection" && "hidden"]}>
            <button
              type="submit"
              class={[
                "btn btn-primary flex-1",
                if(@saving, do: "loading", else: "")
              ]}
              disabled={@saving}
            >
              <%= if @saving do %>
                {gettext("Saving...")}
              <% else %>
                {gettext("Save Authorization Settings")}
              <% end %>
            </button>
          </div>
        </.form>

        <%!-- Outside the settings form on purpose: the limits are read-only and
             Turnstile saves through its own form (its secret never goes into
             the settings changeset). --%>
        <div class={["mt-6", @active_tab != "protection" && "hidden"]}>
          <div class="fieldset w-full">
            <label class="label">
              <span class="fieldset-legend text-base font-medium">
                {gettext("Request limits")}
              </span>
              <span class="fieldset-label text-sm text-base-content/60">
                {gettext(
                  "How many requests the public sign-in and sign-up pages accept. A request is refused as soon as one of its limits is reached."
                )}
              </span>
            </label>

            <div class="overflow-x-auto">
              <table id="request-limits-table" class="table table-sm">
                <thead>
                  <tr>
                    <th>{gettext("Page")}</th>
                    <th>{gettext("Per email address")}</th>
                    <th>{gettext("Per network (IP)")}</th>
                    <th>{gettext("Whole site")}</th>
                    <th>{gettext("Used now")}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={row <- @request_limits} id={"request-limit-#{row.action}"}>
                    <td class="font-medium">{request_limit_label(row.action)}</td>
                    <td>{format_request_limit(row.address)}</td>
                    <td>{format_request_limit(row.ip)}</td>
                    <%= if row.site_wide do %>
                      <td>{format_request_limit(row.site_wide)}</td>
                      <td>
                        <div class="flex flex-wrap items-center gap-2">
                          <span class={[
                            "badge badge-sm",
                            if(row.site_wide.used >= row.site_wide.limit,
                              do: "badge-error",
                              else: "badge-ghost"
                            )
                          ]}>
                            <%= if row.site_wide.used >= row.site_wide.limit do %>
                              {gettext("Limit reached")}
                            <% else %>
                              {gettext("%{used} of %{limit}",
                                used: row.site_wide.used,
                                limit: row.site_wide.limit
                              )}
                            <% end %>
                          </span>
                          <span class="text-xs text-base-content/60">
                            {gettext("resets in %{time}",
                              time: format_limit_window(row.site_wide.resets_in_ms)
                            )}
                          </span>
                        </div>
                      </td>
                    <% else %>
                      <td class="text-base-content/60">{gettext("No limit")}</td>
                      <td class="text-base-content/60">—</td>
                    <% end %>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="mt-3 space-y-2 text-sm text-base-content/70">
              <p>
                {gettext(
                  "The whole-site limit is a circuit breaker. Once it is reached, that page refuses everyone until it resets, so raise it before a launch or anything else that sends many people to one of these pages at once."
                )}
              </p>
              <p>
                {gettext(
                  "The registration limit counts the public sign-up forms only. Sign-ups through a sign-in provider such as Google, and users an admin adds, are not counted."
                )}
              </p>
              <p>
                {gettext(
                  "The limits are set in the application's configuration and are counted separately on each server."
                )}
                <code class="text-xs">config :phoenix_kit, PhoenixKit.Users.RateLimiter</code>
              </p>
            </div>

            <div class="mt-3">
              <button
                type="button"
                phx-click="refresh_request_limits"
                class="btn btn-sm btn-outline"
              >
                <PhoenixKitWeb.Components.Core.Icons.icon_refresh class="h-4 w-4" />
                {gettext("Refresh")}
              </button>
            </div>
          </div>

          <form
            id="email-check-settings-form"
            phx-submit="save_email_check"
            class="fieldset w-full mt-8"
          >
            <label class="label">
              <span class="fieldset-legend text-base font-medium">
                {gettext("Email address check")}
              </span>
              <span class="fieldset-label text-sm text-base-content/60">
                {gettext("Stops sign-ups for addresses that can only bounce")}
              </span>
            </label>

            <.checkbox
              id="email-domain-check-enabled"
              name="email_check[enabled]"
              checked={@email_domain_check.enabled}
              label={gettext("Check the email address at sign-up")}
            >
              <:description>
                {gettext(
                  "On the sign-up and registration link forms: an address whose domain cannot receive mail is refused, and a likely typo (gmial.com) gets a \"Did you mean\" hint the person can accept or ignore. If the domain cannot be looked up in time, the address is accepted."
                )}
              </:description>
            </.checkbox>

            <p :if={@email_domain_check.overridden} class="mt-2 text-sm text-warning">
              {gettext(
                "Switched off in the application's configuration; this setting has no effect."
              )}
              <code class="text-xs">config :phoenix_kit, :email_domain_check, false</code>
            </p>

            <p class="mt-3 text-sm text-base-content/70">
              {gettext(
                "An account that has not confirmed its address gets only the mail its holder asks for (the confirmation, a password reset, a sign-in link): no notifications, digests or security alerts."
              )}
            </p>

            <div class="mt-3">
              <button
                type="submit"
                class="btn btn-primary btn-sm"
                phx-disable-with={gettext("Saving...")}
              >
                {gettext("Save email address check")}
              </button>
            </div>
          </form>

          <form
            id="turnstile-settings-form"
            phx-submit="save_turnstile"
            class="fieldset w-full mt-8"
            autocomplete="off"
          >
            <label class="label">
              <span class="fieldset-legend text-base font-medium">
                {gettext("Cloudflare Turnstile")}
              </span>
              <span class="fieldset-label text-sm text-base-content/60">
                {gettext("A check that the visitor is a person, before a form sends an email")}
              </span>
            </label>

            <.checkbox
              id="turnstile-enabled"
              name="turnstile[enabled]"
              checked={@turnstile.enabled}
              label={gettext("Enable Cloudflare Turnstile")}
            >
              <:description>
                {gettext(
                  "Shown on the sign-up, registration link, password reset, magic link and confirmation resend forms. A request without a passed check is refused before it counts against any limit above."
                )}
              </:description>
            </.checkbox>

            <div class="mt-3 grid gap-3 max-w-xl">
              <.input
                id="turnstile-site-key"
                type="text"
                name="turnstile[site_key]"
                value={@turnstile.site_key}
                label={gettext("Site key")}
                autocomplete="off"
              />
              <.input
                id="turnstile-secret-key"
                type="password"
                name="turnstile[secret_key]"
                value=""
                label={gettext("Secret key")}
                placeholder={
                  if @turnstile.secret_set?,
                    do: gettext("Saved. Leave blank to keep it"),
                    else: gettext("Not set")
                }
                autocomplete="new-password"
              />
            </div>

            <div class="mt-3 space-y-2 text-sm text-base-content/70">
              <p>
                {gettext(
                  "Both keys come from the Cloudflare dashboard: Turnstile, Add widget, with this site's domain. The secret key is checked with Cloudflare when you save and is never shown again."
                )}
              </p>
              <p>
                {gettext(
                  "If Cloudflare cannot be reached, the forms keep working on the request limits alone."
                )}
              </p>
            </div>

            <div class="mt-3">
              <button
                type="submit"
                class="btn btn-primary btn-sm"
                phx-disable-with={gettext("Saving...")}
              >
                {gettext("Save Turnstile settings")}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <.live_component
    :if={@show_media_selector}
    module={PhoenixKitWeb.Live.Components.MediaSelectorModal}
    id="authorization-media-selector"
    show={@show_media_selector}
    mode={:single}
    title={
      if @media_selection_target == :background,
        do: gettext("Select Background Image"),
        else: gettext("Select Logo")
    }
    selected_uuids={[]}
    phoenix_kit_current_user={assigns[:phoenix_kit_current_user]}
    scope_folder_id={@branding_scope_folder}
  />
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
