<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_subtitle={@page_subtitle}
  page_section={@page_section}
  page_section_path={@page_section_path}
  current_path={@current_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <div id="api-settings-page" class="flex flex-col px-4 py-6 gap-6">
    <.nav_tabs
      active_tab={@active_tab}
      variant={:border}
      tabs={UrlTabs.patch_links(tabs(), "/admin/settings/api")}
    />

    <div id="api-tab-access" class={["space-y-6", @active_tab != "access" && "hidden"]}>
      <%!-- Switches --%>
      <.form_section
        id="api-switches"
        title={gettext("Switches")}
        icon="hero-power"
        class="border border-base-200"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext(
            "Both sides are off until you switch them on. While a side is off, every address of it answers 404."
          )}
        </:subtitle>

        <div id="api-switch-admin-row" class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 id="api-switch-admin-title" class="font-medium">{gettext("Admin API")}</h3>
            <p id="api-switch-admin-text" class="text-sm text-base-content/70">
              {gettext(
                "Programs with an API key read and change the catalogue, prices and stock."
              )}
            </p>
          </div>
          <.checkbox
            id="api-switch-admin"
            name="api-switch-admin"
            variant="toggle"
            class="toggle-lg"
            wrapper_class="shrink-0 flex-row-reverse"
            label={if @admin_enabled, do: gettext("Enabled"), else: gettext("Disabled")}
            aria-labelledby="api-switch-admin-title"
            aria-describedby="api-switch-admin-text"
            checked={@admin_enabled}
            phx-click="toggle_switch"
            phx-value-switch="admin"
          />
        </div>

        <div id="api-switch-public-row" class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 id="api-switch-public-title" class="font-medium">{gettext("Public API")}</h3>
            <p id="api-switch-public-text" class="text-sm text-base-content/70">
              {gettext(
                "AI assistants and other programs use what the site offers, without a key."
              )}
            </p>
          </div>
          <.checkbox
            id="api-switch-public"
            name="api-switch-public"
            variant="toggle"
            class="toggle-lg"
            wrapper_class="shrink-0 flex-row-reverse"
            label={if @public_enabled, do: gettext("Enabled"), else: gettext("Disabled")}
            aria-labelledby="api-switch-public-title"
            aria-describedby="api-switch-public-text"
            checked={@public_enabled}
            phx-click="toggle_switch"
            phx-value-switch="public"
          />
        </div>
      </.form_section>

      <%!-- Modules --%>
      <.form_section
        id="api-modules-card"
        title={gettext("Modules")}
        icon="hero-puzzle-piece"
        class="border border-base-200"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext(
            "Each module below offers tools to the API. Switch a module off and all its tools answer as if they did not exist, for every key. Modules are on until you switch them off."
          )}
        </:subtitle>

        <p
          :if={Enum.any?(@api_modules, & &1.writes?)}
          id="api-modules-session-write-hint"
          class="text-sm text-base-content/70"
        >
          {gettext(
            "“Agent may act” lets an assistant that works in a person's signed-in session propose the module's changes; each change runs only after that person confirms it. It is off until you turn it on and does not change what API keys may do."
          )}
        </p>

        <div :if={@api_modules == []} id="api-modules-empty">
          <.empty_state
            variant="compact"
            icon="hero-puzzle-piece"
            title={gettext("No installed module offers tools to the API.")}
          />
        </div>

        <div
          :for={mod <- @api_modules}
          id={"api-module-row-#{mod.key}"}
          class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2"
        >
          <div class="min-w-0">
            <h3 class="font-medium">{mod.label}</h3>
            <p class="text-sm text-base-content/70">
              {gettext("Tools: %{count}", count: mod.tools)}
              <.status_badge
                :if={not mod.enabled?}
                status="inactive"
                label={gettext("Module disabled")}
                class="ml-1"
              />
            </p>
          </div>
          <div class="ml-auto flex min-w-0 max-w-full flex-col items-end gap-2">
            <.checkbox
              id={"api-module-switch-#{mod.key}"}
              name={"api-module-switch-#{mod.key}"}
              variant="toggle"
              class="toggle-lg"
              wrapper_class="shrink-0 flex-row-reverse"
              label={if mod.api_on?, do: gettext("API on"), else: gettext("API off")}
              aria-label={
                if mod.api_on?,
                  do: gettext("Switch the API of %{module} off", module: mod.label),
                  else: gettext("Switch the API of %{module} on", module: mod.label)
              }
              checked={mod.api_on?}
              phx-click="set_module_api"
              phx-value-module={mod.key}
              phx-value-state={if mod.api_on?, do: "off", else: "on"}
            />
            <.checkbox
              :if={mod.writes?}
              id={"api-module-session-write-#{mod.key}"}
              name={"api-module-session-write-#{mod.key}"}
              class="checkbox-sm"
              wrapper_class="flex-row-reverse"
              label={gettext("Agent may act")}
              aria-label={
                if mod.session_write?,
                  do: gettext("Stop the agent acting in %{module}", module: mod.label),
                  else: gettext("Let the agent act in %{module}", module: mod.label)
              }
              checked={mod.session_write?}
              disabled={not mod.api_on? and not mod.session_write?}
              phx-click="set_module_session_write"
              phx-value-module={mod.key}
              phx-value-state={if mod.session_write?, do: "off", else: "on"}
            />
          </div>
          <div :if={mod.assistant_tools != []} class="min-w-0 basis-full">
            <.accordion id={"api-module-tools-#{mod.key}"} class="min-w-0">
              <:title>
                {gettext("Tools for the assistant: %{available} of %{total} available",
                  available: available_count(mod.assistant_tools),
                  total: length(mod.assistant_tools)
                )}
              </:title>
              <:content>
                <p id={"api-module-tools-note-#{mod.key}"} class="text-sm text-base-content/70">
                  {gettext(
                    "What an assistant working in a person's signed-in session may call, by these settings alone. Rights are still checked for each person: a tool shown as available is refused to someone whose roles lack its permission."
                  )}
                </p>
                <ul class="mt-2 divide-y divide-base-200">
                  <li
                    :for={tool <- mod.assistant_tools}
                    id={"api-module-tool-#{tool.name}"}
                    data-status={if tool.status == :available, do: "available", else: "closed"}
                    class="min-w-0 space-y-1 py-2"
                  >
                    <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
                      <code class="min-w-0 break-all font-mono text-xs">{tool.name}</code>
                      <span
                        :if={tool.kind == :write}
                        class="badge badge-sm badge-warning h-auto"
                      >
                        {gettext("Writes")}
                      </span>
                      <span :if={tool.kind == :read} class="badge badge-sm badge-ghost h-auto">
                        {gettext("Read only")}
                      </span>
                    </div>
                    <p :if={tool.permission} class="break-all text-xs text-base-content/70">
                      {gettext("Permission: %{permission}", permission: tool.permission)}
                    </p>
                    <div class="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
                      <.status_badge
                        :if={tool.status == :available}
                        status="active"
                        label={gettext("Available")}
                      />
                      <.status_badge
                        :if={tool.status != :available}
                        status="inactive"
                        label={gettext("Closed")}
                      />
                      <span
                        :for={reason <- closed_reasons(tool)}
                        data-reason={reason}
                        class="min-w-0"
                      >
                        {closed_reason_text(reason)}
                      </span>
                    </div>
                  </li>
                </ul>
              </:content>
            </.accordion>
          </div>
        </div>
      </.form_section>

      <%!-- Personal API keys --%>
      <.form_section
        id="api-personal-keys-card"
        title={gettext("Personal API keys")}
        icon="hero-finger-print"
        class="border border-base-200"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext(
            "A person makes these keys for themselves on My API keys. The “Personal API keys” permission is given to roles (Users, Roles, or the permissions matrix); an Admin does not get it by itself."
          )}
        </:subtitle>

        <form id="api-personal-keys-form" phx-submit="save_personal_keys" class="space-y-4">
          <div
            :if={@personal_keys_errors != []}
            id="api-personal-keys-errors"
            class="alert alert-error text-sm"
          >
            <ul class="list-disc pl-4">
              <li :for={message <- @personal_keys_errors}>{message}</li>
            </ul>
          </div>

          <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-2">
            <.input
              id="api-personal-keys-max-days"
              name="personal_keys[max_days]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Longest lifetime of a personal key, in days (1 to 365)")}
              value={@personal_keys_params["max_days"]}
            />
            <.input
              id="api-personal-keys-max-count"
              name="personal_keys[max_count]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Personal keys one person may have (1 to 50)")}
              value={@personal_keys_params["max_count"]}
            />
          </div>

          <div class="flex justify-end">
            <.button type="submit" id="api-personal-keys-submit">
              {gettext("Save the settings")}
            </.button>
          </div>
        </form>
      </.form_section>
    </div>

    <div id="api-tab-keys" class={["space-y-6", @active_tab != "keys" && "hidden"]}>
      <%!-- Keys --%>
      <.form_section
        id="api-keys-card"
        wrap_actions
        title={gettext("API keys")}
        icon="hero-key"
        class="border border-base-200"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext(
            "A key acts with the rights of its owner, never with more. Removing a right from the owner takes it from the key at once."
          )}
        </:subtitle>
        <:actions>
          <.button id="api-new-key" type="button" size="sm" phx-click="open_create_key">
            <.icon name="hero-plus" class="w-4 h-4" /> {gettext("New key")}
          </.button>
        </:actions>

        <div :if={@keys != []} id="api-keys-table">
          <.table_default>
            <.table_default_header>
              <.table_default_row>
                <.table_default_header_cell>{gettext("Name")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Owner")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Scopes")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Status")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Last used")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Actions")}</.table_default_header_cell>
              </.table_default_row>
            </.table_default_header>

            <.table_default_body>
              <.table_default_row :for={key <- @keys} id={"api-key-#{key.uuid}"}>
                <.table_default_cell>
                  <div class="font-medium">{key.name}</div>
                  <div class="font-mono text-xs text-base-content/60">pk_{key.prefix}_…</div>
                  <.status_badge
                    :if={key.requires_approval}
                    status="pending_approval"
                    label={gettext("Needs approval")}
                    size={:xs}
                    class="mt-1"
                  />
                  <span :if={key.personal} class="badge badge-outline badge-xs mt-1">
                    {gettext("Personal key")}
                  </span>
                </.table_default_cell>
                <.table_default_cell class="text-sm">
                  {Map.get(@owner_labels, key.user_uuid)}
                </.table_default_cell>
                <.table_default_cell>
                  <div class="flex flex-wrap gap-1 max-w-xs">
                    <span
                      :for={scope <- Enum.take(key.scopes, 3)}
                      class="badge badge-ghost badge-xs font-mono"
                    >
                      {scope}
                    </span>
                    <span :if={length(key.scopes) > 3} class="badge badge-ghost badge-xs">
                      +{length(key.scopes) - 3}
                    </span>
                    <span :if={key.scopes == []} class="text-xs text-base-content/40">
                      {gettext("identity only")}
                    </span>
                  </div>
                </.table_default_cell>
                <.table_default_cell>
                  <%= if key.personal do %>
                    <.status_badge
                      status={PersonalKeyDisplay.badge_name(@personal_statuses[key.uuid])}
                      label={PersonalKeyDisplay.label(@personal_statuses[key.uuid])}
                    />
                    <div
                      :if={@personal_statuses[key.uuid] == :rotating}
                      class="text-xs text-base-content/60 mt-0.5"
                    >
                      {gettext("until %{time}",
                        time: PersonalKeyDisplay.moment(ends_at(key), @api_scope.user)
                      )}
                    </div>
                    <div
                      :if={
                        key.expires_at && PersonalKeyDisplay.live?(@personal_statuses[key.uuid]) &&
                          @personal_statuses[key.uuid] != :rotating
                      }
                      class="text-xs text-base-content/60 mt-0.5"
                    >
                      {gettext("Expires on %{date}",
                        date: PersonalKeyDisplay.expiry_date(key.expires_at, @api_scope.user)
                      )}
                    </div>
                  <% else %>
                    <.status_badge
                      status={Atom.to_string(key_status(key))}
                      label={status_label(key_status(key))}
                    />
                    <div
                      :if={key_status(key) == :ending}
                      class="text-xs text-base-content/60 mt-0.5"
                    >
                      {gettext("until %{time}",
                        time: Calendar.strftime(ends_at(key), "%Y-%m-%d %H:%M UTC")
                      )}
                    </div>
                  <% end %>
                </.table_default_cell>
                <.table_default_cell>
                  <%= if key.last_used_at do %>
                    <.time_ago datetime={key.last_used_at} id={"api-key-used-#{key.uuid}"} />
                  <% else %>
                    <span class="text-xs text-base-content/40">{gettext("Never")}</span>
                  <% end %>
                </.table_default_cell>
                <.table_default_cell class="relative z-10">
                  <.table_row_menu
                    :if={live?(key) and @key_access[key.uuid] != :none}
                    id={"api-key-menu-#{key.uuid}"}
                    mode="dropdown"
                    label={gettext("Actions")}
                  >
                    <%= if @key_access[key.uuid] == :manage do %>
                      <.table_row_menu_button
                        phx-click="request_edit_scopes"
                        phx-value-uuid={key.uuid}
                        icon="hero-adjustments-horizontal"
                        label={gettext("Edit scopes")}
                      />
                      <.table_row_menu_button
                        phx-click="request_rotate"
                        phx-value-uuid={key.uuid}
                        icon="hero-arrow-path"
                        label={gettext("Rotate")}
                      />
                    <% else %>
                      <.table_row_menu_button
                        phx-click="request_edit_scopes"
                        phx-value-uuid={key.uuid}
                        icon="hero-adjustments-horizontal"
                        label={gettext("Remove scopes")}
                      />
                    <% end %>
                    <.table_row_menu_button
                      phx-click="request_revoke"
                      phx-value-uuid={key.uuid}
                      icon="hero-no-symbol"
                      label={gettext("Revoke")}
                      variant="error"
                    />
                  </.table_row_menu>
                </.table_default_cell>
              </.table_default_row>
            </.table_default_body>
          </.table_default>
        </div>

        <div :if={@keys == []} id="api-keys-empty">
          <.empty_state
            variant="compact"
            icon="hero-key"
            title={gettext("No API keys yet")}
            description={
              gettext("Create a key, copy it once, and give it to the program that needs it.")
            }
          />
        </div>
      </.form_section>

      <%!-- Service users --%>
      <.form_section
        id="api-service-users-card"
        wrap_actions
        title={gettext("Service users")}
        icon="hero-cpu-chip"
        class="border border-base-200"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext(
            "A service user is an account for a program. It cannot sign in to the website, and it holds only the roles you give it, never more than you hold yourself."
          )}
        </:subtitle>
        <:actions>
          <.button
            id="api-new-service-user"
            type="button"
            size="sm"
            variant="outline"
            phx-click="open_service_user_form"
          >
            <.icon name="hero-plus" class="w-4 h-4" /> {gettext("New service user")}
          </.button>
        </:actions>

        <div :if={@service_users != []} id="api-service-users-table">
          <.table_default>
            <.table_default_header>
              <.table_default_row>
                <.table_default_header_cell>{gettext("Name")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Keys")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Created")}</.table_default_header_cell>
                <.table_default_header_cell>{gettext("Actions")}</.table_default_header_cell>
              </.table_default_row>
            </.table_default_header>

            <.table_default_body>
              <.table_default_row
                :for={service_user <- @service_users}
                id={"api-service-user-#{service_user.uuid}"}
              >
                <.table_default_cell>
                  <div class="font-medium">{user_label(service_user)}</div>
                  <div class="font-mono text-xs text-base-content/60">{service_user.email}</div>
                </.table_default_cell>
                <.table_default_cell class="text-sm">
                  {Map.get(@key_counts, service_user.uuid, 0)}
                </.table_default_cell>
                <.table_default_cell>
                  <.time_ago
                    datetime={service_user.inserted_at}
                    id={"api-service-user-made-#{service_user.uuid}"}
                  />
                </.table_default_cell>
                <.table_default_cell class="relative z-10">
                  <.table_row_menu
                    id={"api-service-user-menu-#{service_user.uuid}"}
                    mode="dropdown"
                    label={gettext("Actions")}
                  >
                    <.table_row_menu_button
                      phx-click="open_create_key"
                      phx-value-owner={service_user.uuid}
                      icon="hero-key"
                      label={gettext("New key")}
                    />
                  </.table_row_menu>
                </.table_default_cell>
              </.table_default_row>
            </.table_default_body>
          </.table_default>
        </div>

        <div :if={@service_users == []} id="api-service-users-empty">
          <.empty_state
            variant="compact"
            icon="hero-cpu-chip"
            title={gettext("No service users yet")}
            description={
              gettext(
                "Create one when a program should have a key that does not belong to a person."
              )
            }
          />
        </div>
      </.form_section>
    </div>

    <div id="api-tab-approvals" class={["space-y-6", @active_tab != "approvals" && "hidden"]}>
      <%!-- Pending approvals --%>
      <.form_section
        id="api-approvals-card"
        wrap_actions
        title={gettext("Pending approvals")}
        icon="hero-shield-check"
        class="border border-base-200"
      >
        <:subtitle>
          {gettext(
            "Operations from keys that need a person's approval wait here. Nothing runs until you approve it."
          )}
        </:subtitle>
        <:actions>
          <.button
            id="api-approvals-link"
            variant="outline"
            size="sm"
            navigate={Routes.path("/admin/approvals")}
          >
            {gettext("Review approvals")}
            <span
              :if={@pending_approvals > 0}
              id="api-approvals-count"
              class="badge badge-warning badge-sm"
            >
              {@pending_approvals}
            </span>
          </.button>
        </:actions>
      </.form_section>

      <%!-- Limits and advanced --%>
      <.form_section
        id="api-limits-card"
        title={gettext("Limits and advanced")}
        icon="hero-adjustments-horizontal"
        class="border border-base-200"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext(
            "Rate limits and the lists of hidden tools and allowed origins. Every change is kept in the history of the settings."
          )}
        </:subtitle>

        <form id="api-limits-form" phx-submit="save_limits" class="space-y-4">
          <div :if={@limits_errors != []} id="api-limits-errors" class="alert alert-error text-sm">
            <ul class="list-disc pl-4">
              <li :for={message <- @limits_errors}>{message}</li>
            </ul>
          </div>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <.textarea
              id="api-disabled-tools"
              name="limits[disabled_tools]"
              rows="4"
              spellcheck="false"
              class="font-mono text-sm"
              wrap_label
              label={gettext("Hidden tools (one per line)")}
              hint={gettext("A hidden tool answers as if it did not exist, for every key.")}
              value={@limits_params["disabled_tools"]}
            />
            <.textarea
              id="api-mcp-origins"
              name="limits[mcp_allowed_origins]"
              rows="4"
              spellcheck="false"
              class="font-mono text-sm"
              wrap_label
              label={gettext("Allowed MCP origins (one per line)")}
              hint={
                gettext(
                  "Web origins that may call the MCP endpoint besides the site itself, for example https://assistant.example.com"
                )
              }
              value={@limits_params["mcp_allowed_origins"]}
            />
          </div>

          <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-2">
            <.input
              id="api-limit-preauth-fail-per-min"
              name="limits[preauth_fail_per_min]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Failed sign-ins per minute, per address")}
              value={@limits_params["preauth_fail_per_min"]}
            />
            <.input
              id="api-limit-admin-per-min"
              name="limits[admin_per_min]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Calls per minute, per key (admin API)")}
              value={@limits_params["admin_per_min"]}
            />
            <.input
              id="api-limit-public-token-per-min"
              name="limits[public_token_per_min]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Calls per minute, per client token (public API)")}
              value={@limits_params["public_token_per_min"]}
            />
            <.input
              id="api-limit-public-ip-per-min"
              name="limits[public_ip_per_min]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Calls per minute, per address (public API)")}
              value={@limits_params["public_ip_per_min"]}
            />
          </div>

          <%!-- The two new-row limits share one subject: the legend names it for both. --%>
          <fieldset id="api-limits-new-rows" class="min-w-0">
            <legend id="api-limit-new-rows-help" class="mb-3 text-sm font-semibold">
              {gettext("Rows a module creates for callers without a key")}
            </legend>
            <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-2">
              <.input
                id="api-limit-new-rows-ip-hour"
                name="limits[new_rows_ip_hour]"
                type="text"
                inputmode="numeric"
                wrap_label
                label={gettext("New rows per hour, per address")}
                value={@limits_params["new_rows_ip_hour"]}
              />
              <.input
                id="api-limit-new-rows-global-hour"
                name="limits[new_rows_global_hour]"
                type="text"
                inputmode="numeric"
                wrap_label
                label={gettext("New rows per hour, all addresses")}
                value={@limits_params["new_rows_global_hour"]}
              />
            </div>
          </fieldset>

          <div class="flex justify-end">
            <.button type="submit" id="api-limits-submit">
              {gettext("Save the limits")}
            </.button>
          </div>
        </form>
      </.form_section>

      <%!-- Confirmation, approvals and repeats --%>
      <.form_section
        id="api-flow-card"
        title={gettext("Confirmation, approvals and repeats")}
        icon="hero-shield-check"
        class="border border-base-200"
        body_class="space-y-4"
      >
        <:subtitle>
          {gettext(
            "How long confirmation codes and approvals live, and when an operation counts as a big one. Every change is kept in the history of the settings."
          )}
        </:subtitle>

        <form id="api-flow-form" phx-submit="save_flow" class="space-y-4">
          <div :if={@flow_errors != []} id="api-flow-errors" class="alert alert-error text-sm">
            <ul class="list-disc pl-4">
              <li :for={message <- @flow_errors}>{message}</li>
            </ul>
          </div>

          <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-2 lg:grid-cols-3">
            <.input
              id="api-flow-confirm-batch-over"
              name="flow[confirm_batch_over]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Ask for confirmation above this many rows")}
              value={@flow_params["confirm_batch_over"]}
            />
            <.input
              id="api-flow-confirm-ttl-seconds"
              name="flow[confirm_ttl_seconds]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Confirmation code lifetime in seconds (10 to 600)")}
              value={@flow_params["confirm_ttl_seconds"]}
            />
            <.input
              id="api-flow-user-confirm-ttl-seconds"
              name="flow[user_confirm_ttl_seconds]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={
                gettext(
                  "Lifetime of a confirmation in a signed-in session, in seconds (60 to 86400)"
                )
              }
              value={@flow_params["user_confirm_ttl_seconds"]}
            />
            <.input
              id="api-flow-approval-ttl-hours"
              name="flow[approval_ttl_hours]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Approval lifetime in hours")}
              value={@flow_params["approval_ttl_hours"]}
            />
            <.input
              id="api-flow-approval-pending-max"
              name="flow[approval_pending_max]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Approvals one key may have waiting")}
              value={@flow_params["approval_pending_max"]}
            />
            <.input
              id="api-flow-idempotency-ttl-hours"
              name="flow[idempotency_ttl_hours]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Repeat protection lifetime in hours")}
              value={@flow_params["idempotency_ttl_hours"]}
            />
            <.input
              id="api-flow-idempotency-lease-seconds"
              name="flow[idempotency_lease_seconds]"
              type="text"
              inputmode="numeric"
              wrap_label
              label={gettext("Repeat protection lease in seconds")}
              value={@flow_params["idempotency_lease_seconds"]}
            />
          </div>

          <div class="flex justify-end">
            <.button type="submit" id="api-flow-submit">
              {gettext("Save the settings")}
            </.button>
          </div>
        </form>
      </.form_section>
    </div>

    <div id="api-tab-guide" class={@active_tab != "guide" && "hidden"}>
      <ApiGuidePanel.api_guide_panel :if={@guide} guide={@guide} />
    </div>
  </div>

  <%!-- Create key --%>
  <.modal
    show={@show_key_form}
    on_close="close_create_key"
    id="create-api-key-modal"
    actions_class="flex-wrap"
    max_width="2xl"
  >
    <:title>
      <.icon name="hero-key" class="w-5 h-5" /> {gettext("New API key")}
    </:title>

    <form
      id="create-api-key-form"
      phx-change="key_form_changed"
      phx-submit="create_key"
      class="space-y-4"
    >
      <div :if={@key_errors != []} id="create-api-key-errors" class="alert alert-error text-sm">
        <ul class="list-disc pl-4">
          <li :for={message <- @key_errors}>{message}</li>
        </ul>
      </div>

      <.input
        id="api-key-name"
        wrap_label
        name="key[name]"
        type="text"
        label={gettext("Name")}
        value={@key_params["name"]}
        placeholder={gettext("What the key is for, for example Stock sync")}
        required
      />

      <.select
        id="api-key-owner"
        wrap_label
        name="key[owner]"
        label={gettext("Owner")}
        value={@key_params["owner"]}
        options={owner_options(@service_users)}
      />

      <fieldset id="api-key-scopes" class="fieldset min-w-0">
        <legend class="fieldset-legend">{gettext("Scopes")}</legend>
        <p :if={@scope_options == []} class="text-sm text-base-content/60">
          {gettext(
            "No scopes are available to this owner. The key can still read its own identity."
          )}
        </p>
        <.checkbox
          :for={scope <- @scope_options}
          name="key[scopes][]"
          value={scope}
          unchecked_value={nil}
          checked={scope in @key_params["scopes"]}
          class="checkbox-sm"
          wrapper_class="py-1"
        >
          <span class="font-mono">{scope}</span>
          <:description>{Enum.join(Map.get(@scope_tools, scope, []), ", ")}</:description>
        </.checkbox>
      </fieldset>

      <.checkbox
        id="api-key-requires-approval"
        name="key[requires_approval]"
        checked={@key_params["requires_approval"] == true}
        class="checkbox-sm"
        label={gettext("Needs approval")}
      >
        <:description>
          {gettext(
            "Every write of this key waits in the approval queue until a person approves it, dangerous or not; reads run at once. Use it for keys given to AI agents."
          )}
          <span id="api-key-requires-approval-honest" class="block mt-1">
            {gettext(
              "Without this option a key confirms its own operations with a code. That protects against mistakes, not against whoever holds the key."
            )}
          </span>
        </:description>
      </.checkbox>

      <.input
        id="api-key-allowed-ips"
        wrap_label
        name="key[allowed_ips]"
        type="text"
        label={gettext("Allowed addresses (optional)")}
        value={@key_params["allowed_ips"]}
        placeholder="203.0.113.5, 10.0.0.0/8"
      />

      <.input
        id="api-key-expires-on"
        name="key[expires_on]"
        type="date"
        label={gettext("Expires on (optional)")}
        value={@key_params["expires_on"]}
      />
    </form>

    <:actions>
      <.button type="button" variant="ghost" phx-click="close_create_key">
        {gettext("Cancel")}
      </.button>
      <.button type="submit" form="create-api-key-form" id="create-api-key-submit">
        {gettext("Create the key")}
      </.button>
    </:actions>
  </.modal>

  <%!-- The new key, shown once --%>
  <.modal
    show={@new_token != nil}
    on_close="dismiss_token"
    id="new-api-token-modal"
    actions_class="flex-wrap"
    max_width="xl"
    closeable={false}
  >
    <:title>
      <.icon name="hero-key" class="w-5 h-5 text-success" /> {gettext("Copy your new key now")}
    </:title>

    <div class="space-y-4">
      <div class="alert alert-warning text-sm">
        <.icon name="hero-exclamation-triangle" class="w-5 h-5 shrink-0" />
        <span>
          {gettext(
            "This is the only time the key is shown. Keep it in a password manager or a secret store. If it is lost, revoke it and create a new one."
          )}
        </span>
      </div>

      <p :if={@new_token_name} class="text-sm">
        {gettext("Key: %{name}", name: @new_token_name)}
      </p>

      <%!-- No `name`: the key is in no form, so it is never sent back as a param. --%>
      <div class="flex items-center gap-2">
        <.input
          id="new-api-token"
          name={nil}
          type="text"
          readonly
          autocomplete="off"
          spellcheck="false"
          aria-label={gettext("New API key")}
          value={@new_token}
          class="font-mono text-sm"
          wrapper_class="min-w-0 grow"
        />
        <.button
          type="button"
          id="new-api-token-copy"
          size="sm"
          variant="outline"
          class="shrink-0"
          phx-hook="CopyToClipboard"
          data-copy-target="#new-api-token"
        >
          <span data-copy-idle>{gettext("Copy")}</span>
          <span data-copy-feedback class="hidden">{gettext("Copied!")}</span>
        </.button>
      </div>

      <p class="text-xs text-base-content/60">
        {gettext(
          "Send it only in the Authorization header, as Bearer and the key. A key in a web address is refused."
        )}
      </p>
    </div>

    <:actions>
      <.button id="new-api-token-done" type="button" phx-click="dismiss_token">
        {gettext("I have stored the key")}
      </.button>
    </:actions>
  </.modal>

  <%!-- Edit the scopes of a key --%>
  <.modal
    show={@scopes_form.show}
    on_close="cancel_edit_scopes"
    id="edit-key-scopes-modal"
    actions_class="flex-wrap"
    max_width="2xl"
  >
    <:title>
      <.icon name="hero-adjustments-horizontal" class="w-5 h-5" />
      {if Map.get(@scopes_form, :mode) == :narrow,
        do: gettext("Remove scopes from this key"),
        else: gettext("Edit the scopes of this key")}
    </:title>

    <form id="edit-key-scopes-form" phx-submit="save_key_scopes" class="space-y-4">
      <input type="hidden" name="key_scopes[present]" value="1" />
      <p :if={@scopes_form[:name]} class="font-medium">{@scopes_form[:name]}</p>
      <p
        :if={Map.get(@scopes_form, :mode) == :narrow}
        id="edit-key-scopes-narrow-note"
        class="text-sm text-base-content/70"
      >
        {gettext(
          "This is a personal key of another person. You can take scopes off it, but not add any. Untick what it should lose."
        )}
      </p>

      <div
        :if={Map.get(@scopes_form, :errors, []) != []}
        id="edit-key-scopes-errors"
        class="alert alert-error text-sm"
      >
        <ul class="list-disc pl-4">
          <li :for={message <- Map.get(@scopes_form, :errors, [])}>{message}</li>
        </ul>
      </div>

      <fieldset class="fieldset min-w-0">
        <legend class="fieldset-legend">{gettext("Scopes")}</legend>
        <p :if={Map.get(@scopes_form, :options, []) == []} class="text-sm text-base-content/60">
          {gettext(
            "No scopes are available to this owner. The key can still read its own identity."
          )}
        </p>
        <.checkbox
          :for={scope <- Map.get(@scopes_form, :options, [])}
          name="key_scopes[scopes][]"
          value={scope}
          unchecked_value={nil}
          checked={scope in Map.get(@scopes_form, :selected, [])}
          class="checkbox-sm"
          wrapper_class="py-1"
        >
          <span class="font-mono">{scope}</span>
          <span
            :if={
              Map.get(@scopes_form, :mode) == :narrow and
                scope in Map.get(@scopes_form, :inactive, [])
            }
            class="badge badge-ghost badge-xs ml-1"
          >
            {gettext("inactive")}
          </span>
          <:description>
            {Enum.join(Map.get(Map.get(@scopes_form, :tools, %{}), scope, []), ", ")}
          </:description>
        </.checkbox>
        <div
          :if={
            Map.get(@scopes_form, :inactive, []) != [] and
              Map.get(@scopes_form, :mode) != :narrow
          }
          id="edit-key-scopes-inactive"
          class="mt-2"
        >
          <p class="text-sm text-base-content/70">
            {gettext(
              "These scopes are inactive because the owner can no longer use them or their module's API is switched off. They stay on the key when you save."
            )}
          </p>
          <ul class="text-sm">
            <li
              :for={scope <- @scopes_form.inactive}
              data-scope={scope}
              class="font-mono opacity-60"
            >
              {scope}
            </li>
          </ul>
        </div>
      </fieldset>
    </form>

    <:actions>
      <.button type="button" variant="ghost" phx-click="cancel_edit_scopes">
        {gettext("Cancel")}
      </.button>
      <.button type="submit" form="edit-key-scopes-form" id="edit-key-scopes-submit">
        {if Map.get(@scopes_form, :mode) == :narrow,
          do: gettext("Remove the unticked scopes"),
          else: gettext("Save the scopes")}
      </.button>
    </:actions>
  </.modal>

  <%!-- Rotate --%>
  <.modal
    show={@rotate_form.show}
    on_close="cancel_rotate"
    id="rotate-api-key-modal"
    actions_class="flex-wrap"
    max_width="lg"
  >
    <:title>
      <.icon name="hero-arrow-path" class="w-5 h-5" /> {gettext("Rotate this key")}
    </:title>

    <form id="rotate-api-key-form" phx-submit="confirm_rotate" class="space-y-4">
      <p :if={@rotate_form[:name]} class="font-medium">{@rotate_form[:name]}</p>
      <p class="text-sm text-base-content/70">
        {gettext(
          "A new key is created with the same owner, scopes and limits. The old key keeps working for the grace period, then stops."
        )}
      </p>
      <div :if={@rotate_form[:error]} id="rotate-api-key-error" class="alert alert-error text-sm">
        {gettext("Give a whole number of hours from 0 to 24.")}
      </div>
      <.select
        id="rotate-grace-hours"
        wrap_label
        name="rotate[grace_hours]"
        label={gettext("Grace period in hours (0 to 24)")}
        value={@rotate_form[:hours]}
        options={grace_options()}
      />
      <div
        :if={Map.get(@rotate_form, :at_limit)}
        id="rotate-api-key-at-limit"
        class="alert alert-info text-sm"
      >
        {gettext(
          "You already have the largest number of keys allowed, so the old key cannot keep working next to the new one: the grace period starts at 0 and the old key stops at once. Revoke another key first if you need a longer overlap."
        )}
      </div>
    </form>

    <:actions>
      <.button type="button" variant="ghost" phx-click="cancel_rotate">
        {gettext("Cancel")}
      </.button>
      <.button type="submit" form="rotate-api-key-form" id="rotate-api-key-submit">
        {gettext("Rotate the key")}
      </.button>
    </:actions>
  </.modal>

  <%!-- New service user --%>
  <.modal
    show={@show_service_user_form}
    on_close="close_service_user_form"
    id="create-service-user-modal"
    actions_class="flex-wrap"
    max_width="lg"
  >
    <:title>
      <.icon name="hero-cpu-chip" class="w-5 h-5" /> {gettext("New service user")}
    </:title>

    <form id="create-service-user-form" phx-submit="create_service_user" class="space-y-4">
      <div
        :if={@service_user_errors != []}
        id="create-service-user-errors"
        class="alert alert-error text-sm"
      >
        <ul class="list-disc pl-4">
          <li :for={message <- @service_user_errors}>{message}</li>
        </ul>
      </div>

      <.input
        id="service-user-name"
        wrap_label
        name="service_user[name]"
        type="text"
        label={gettext("Name")}
        value={@service_user_params["name"]}
        placeholder={gettext("The program, for example Stock sync")}
      />

      <fieldset
        id="service-user-roles"
        class="fieldset min-w-0"
        aria-describedby="service-user-roles-help"
      >
        <legend class="fieldset-legend">{gettext("Roles")}</legend>
        <p :if={@allowed_roles == []} class="text-sm text-base-content/60">
          {gettext("There is no role you may hand out.")}
        </p>
        <.checkbox
          :for={role <- @allowed_roles}
          name="service_user[roles][]"
          value={role.name}
          unchecked_value={nil}
          checked={role.name in @service_user_params["roles"]}
          label={role.name}
          class="checkbox-sm"
          wrapper_class="py-1"
        />
        <p id="service-user-roles-help" class="mt-1 text-sm text-base-content/70">
          {gettext("Only roles that hold no more rights than you do are listed.")}
        </p>
      </fieldset>
    </form>

    <:actions>
      <.button type="button" variant="ghost" phx-click="close_service_user_form">
        {gettext("Cancel")}
      </.button>
      <%!-- The longest label of the page's dialogs (ru, uk): on a phone it wraps. --%>
      <.button
        type="submit"
        form="create-service-user-form"
        id="create-service-user-submit"
        class="h-auto min-h-10 shrink py-2"
      >
        {gettext("Create the service user")}
      </.button>
    </:actions>
  </.modal>

  <%!-- Revoke --%>
  <.confirm_modal
    show={@revoke_confirmation.show}
    on_confirm="confirm_revoke"
    on_cancel="cancel_revoke"
    title={gettext("Revoke this key?")}
    title_icon="hero-no-symbol"
    danger={true}
    confirm_text={gettext("Revoke")}
    messages={[
      {:warning,
       gettext("Programs that use this key stop working at once. This cannot be undone.")}
    ]}
  >
    <p :if={@revoke_confirmation[:name]} class="font-medium">{@revoke_confirmation[:name]}</p>
  </.confirm_modal>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
