<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_section={@header_section}
  page_section_path={@header_section && Routes.path("/admin/libraries")}
  page_title_switcher={@header_switcher}
  page_subtitle={
    if @library,
      do: role_label(@role),
      else: gettext("The libraries you own or are a member of")
  }
  current_path={@url_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <%= if @library do %>
    <div class="flex flex-col w-full h-[calc(100dvh-4rem)]">
      <.live_component
        module={PhoenixKitWeb.Components.MediaBrowser}
        id="library-browser"
        library_uuid={@library.uuid}
        phoenix_kit_current_user={assigns[:phoenix_kit_current_user]}
        readonly={readonly?(@role)}
        own_files_only={own_files_only(@role, @phoenix_kit_current_user)}
        fill_height={true}
        on_navigate={:navigate}
        initial_params={@initial_params}
        parent_uploads={@uploads}
      />
    </div>
  <% else %>
    <div class="max-w-5xl mx-auto px-4 py-6 flex flex-col gap-4">
      <div class="flex items-center justify-end">
        <.pk_link navigate="/profile/settings/media" class="btn btn-sm btn-outline">
          <.icon name="hero-cog-6-tooth" class="w-4 h-4" /> {gettext("Manage libraries")}
        </.pk_link>
      </div>

      <div
        :if={@libraries == [] and @others == []}
        id="libraries-empty"
        class="text-center text-base-content/60 py-12"
      >
        {gettext("You have no libraries yet.")}
      </div>

      <div id="libraries-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <.link
          :for={%{library: library, role: role} <- @libraries || []}
          id={"library-#{library.uuid}"}
          patch={library_path(library, @phoenix_kit_current_user.uuid)}
          class="card bg-base-100 border border-base-300 hover:border-primary transition-colors"
        >
          <div class="card-body p-4 gap-1">
            <div class="flex items-center gap-2">
              <.icon name="hero-rectangle-stack" class="w-5 h-5 text-primary shrink-0" />
              <span class="font-semibold truncate">{library.name}</span>
            </div>
            <div class="flex flex-wrap gap-1">
              <span class="badge badge-ghost badge-sm">{role_label(role)}</span>
              <span
                :if={library.is_default and role == :owner}
                class="badge badge-primary badge-sm"
              >
                {gettext("Default")}
              </span>
            </div>
          </div>
        </.link>
      </div>

      <div :if={@others != []} id="libraries-others" class="flex flex-col gap-2 mt-4">
        <h2 class="font-semibold">{gettext("Other users' libraries")}</h2>
        <p class="text-sm text-base-content/60">
          {gettext("Opening a user's library is recorded in the audit log.")}
        </p>
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>{gettext("Name")}</th>
                <th>{gettext("Owner")}</th>
                <th class="text-right">{gettext("Members")}</th>
                <th class="text-right">{gettext("Files")}</th>
                <th class="text-right">{gettext("Size")}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr :for={%{library: library} = row <- @others} id={"other-library-#{library.uuid}"}>
                <td>
                  <span class="font-medium">{library.name}</span>
                  <span :if={library.trashed_at} class="badge badge-sm badge-warning ml-2">
                    {gettext("Trashed")}
                  </span>
                </td>
                <td class="text-sm">{(library.owner && library.owner.email) || "—"}</td>
                <td class="text-right">{row.members}</td>
                <td class="text-right">{row.files}</td>
                <td class="text-right">{PhoenixKit.Utils.Format.bytes(row.bytes)}</td>
                <td class="text-right">
                  <.link
                    :if={is_nil(library.trashed_at)}
                    patch={library_path(library, @phoenix_kit_current_user.uuid)}
                    class="btn btn-xs btn-ghost"
                  >
                    <.icon name="hero-eye" class="w-4 h-4" /> {gettext("Open")}
                  </.link>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
