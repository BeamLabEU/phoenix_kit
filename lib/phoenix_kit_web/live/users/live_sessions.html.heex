<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={gettext("Live Sessions")}
  page_subtitle={gettext("Real-time monitoring of all active sessions with live updates.")}
  current_path={@url_path}
  project_title={@project_title}
>
  <div class="px-4 py-8">
    <%!-- Slim action bar: title/subtitle now live in the navbar; keep the
         live-updated timestamp and the live-monitoring controls. --%>
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4 sm:mb-6">
      <p class="text-sm text-base-content/60">
        {gettext("Last updated:")} {Calendar.strftime(@last_updated, "%H:%M:%S")}
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <%!-- Live Indicator --%>
        <div class="flex items-center gap-2 px-3 py-1 bg-success/10 text-success rounded-full">
          <div class="w-2 h-2 bg-success rounded-full animate-pulse"></div>
          <span class="text-xs font-medium">{gettext("LIVE")}</span>
        </div>
        <%!-- Auto-refresh toggle --%>
        <button
          phx-click="toggle_auto_refresh"
          class={[
            "btn btn-sm",
            if(@auto_refresh, do: "btn-success", else: "btn-outline")
          ]}
        >
          <%= if @auto_refresh do %>
            <.icon name="hero-pause-circle" class="w-5 h-5" /> {gettext("Auto-refresh ON")}
          <% else %>
            <.icon name="hero-play-circle" class="w-5 h-5" /> {gettext("Auto-refresh OFF")}
          <% end %>
        </button>
        <%!-- Manual refresh --%>
        <button phx-click="refresh_now" class="btn btn-sm btn-outline">
          <.icon name="hero-arrow-path" class="w-5 h-5" /> {gettext("Refresh")}
        </button>
      </div>
    </div>

    <%!-- Statistics Cards --%>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <%!-- Total Sessions --%>
      <PhoenixKitWeb.Components.Core.StatCard.stat_card
        compact={true}
        rounded="xl"
        value={@presence_stats.total_sessions}
        title={gettext("Total Sessions")}
        subtitle={gettext("Real-time connections")}
      >
        <:icon>
          <.icon name="hero-user-circle" class="w-5 h-5" />
        </:icon>
      </PhoenixKitWeb.Components.Core.StatCard.stat_card>

      <%!-- Anonymous Sessions --%>
      <PhoenixKitWeb.Components.Core.StatCard.stat_card
        compact={true}
        rounded="xl"
        value={@presence_stats.anonymous_sessions}
        title={gettext("Anonymous")}
        subtitle={gettext("Unregistered visitors")}
      >
        <:icon>
          <.icon name="hero-user" class="w-5 h-5" />
        </:icon>
      </PhoenixKitWeb.Components.Core.StatCard.stat_card>

      <%!-- Authenticated Sessions --%>
      <PhoenixKitWeb.Components.Core.StatCard.stat_card
        compact={true}
        rounded="xl"
        value={@presence_stats.authenticated_sessions}
        title={gettext("Authenticated")}
        subtitle={gettext("Logged in users")}
      >
        <:icon>
          <.icon name="hero-check-circle" class="w-5 h-5" />
        </:icon>
      </PhoenixKitWeb.Components.Core.StatCard.stat_card>

      <%!-- Unique Visitors --%>
      <PhoenixKitWeb.Components.Core.StatCard.stat_card
        compact={true}
        rounded="xl"
        value={@presence_stats.unique_anonymous_visitors}
        title={gettext("Unique Visitors")}
        subtitle={gettext("Individual connections")}
      >
        <:icon>
          <.icon name="hero-user-group" class="w-5 h-5" />
        </:icon>
      </PhoenixKitWeb.Components.Core.StatCard.stat_card>
    </div>

    <%!-- Sessions Table / Cards --%>
    <.table_default
      id="live-sessions-table"
      variant="zebra"
      toggleable={true}
      items={@sessions}
      card_fields={
        fn session ->
          [
            %{label: gettext("IP Address"), value: session.ip_address || gettext("Unknown")},
            %{label: gettext("Current Page"), value: session.current_page || "—"},
            %{
              label: gettext("Connected"),
              value: Calendar.strftime(session.connected_at, "%H:%M:%S %d/%m/%Y")
            },
            %{label: gettext("Status"), value: "● " <> gettext("Active")}
          ]
        end
      }
    >
      <:toolbar_title>
        <div class="flex flex-wrap items-center gap-2">
          <%!-- Search --%>
          <.search_toolbar
            value={@search_query}
            placeholder={gettext("Search by IP, User-Agent, email...")}
            class="w-40 sm:w-52 lg:w-64 min-w-0"
          />
          <%!-- Boxed (the default) is the original look: this was
               `tabs tabs-boxed tabs-sm`, and in daisyUI 4 `tabs-boxed` drew
               the frame. It was hand-rolled only because the component
               hardcodes phx-value-tab while this page's handler read
               phx-value-type — that handler now matches on "tab". --%>
          <.nav_tabs
            active_tab={@filter_type}
            on_change="filter_by"
            class="tabs-sm"
            tabs={[
              %{id: "all", label: "#{gettext("All")} (#{@total_sessions})"},
              %{
                id: "anonymous",
                label: "#{gettext("Anonymous")} (#{@presence_stats.anonymous_sessions})"
              },
              %{
                id: "authenticated",
                label: "#{gettext("Authenticated")} (#{@presence_stats.authenticated_sessions})"
              }
            ]}
          />
        </div>
      </:toolbar_title>
      <:card_header :let={session}>
        <div class="flex items-start justify-between gap-2">
          <%= if session.type == :authenticated do %>
            <% user = Map.get(@users_map, session.user_uuid) %>
            <div class="flex items-center gap-2 min-w-0">
              <.user_avatar user={user || %{email: session.user_email}} size="sm" peek />
              <div class="min-w-0">
                <div class="font-medium text-sm truncate">{session.user_email}</div>
                <div class="text-xs text-base-content/70 font-mono truncate">
                  {session.user_uuid}
                </div>
              </div>
            </div>
            <div class="badge badge-success badge-sm h-auto shrink-0">
              <.icon name="hero-shield-check" class="w-3 h-3 mr-1" /> {gettext("Auth")}
            </div>
          <% else %>
            <div class="flex items-center gap-2 min-w-0">
              <div class="w-8 h-8 bg-warning rounded-full flex shrink-0 items-center justify-center text-warning-content text-xs font-bold">
                ?
              </div>
              <div class="min-w-0">
                <div class="font-medium text-sm">{gettext("Anonymous User")}</div>
                <div class="text-xs text-base-content/70 font-mono truncate">
                  {session.session_id}
                </div>
              </div>
            </div>
            <div class="badge badge-warning badge-sm h-auto shrink-0">
              <.icon name="hero-user" class="w-3 h-3 mr-1" /> {gettext("Anon")}
            </div>
          <% end %>
        </div>
      </:card_header>
      <.table_default_header>
        <.table_default_row>
          <.sort_header_cell field={:type} sort={@sort}>{gettext("Type")}</.sort_header_cell>
          <.table_default_header_cell>{gettext("User/Session")}</.table_default_header_cell>
          <.table_default_header_cell>{gettext("IP Address")}</.table_default_header_cell>
          <.table_default_header_cell>{gettext("Current Page")}</.table_default_header_cell>
          <.sort_header_cell field={:connected_at} sort={@sort}>
            {gettext("Connected")}
          </.sort_header_cell>
          <.table_default_header_cell>{gettext("Status")}</.table_default_header_cell>
        </.table_default_row>
      </.table_default_header>
      <.table_default_body>
        <%= if Enum.empty?(@sessions) do %>
          <.table_default_row>
            <.table_default_cell colspan={6}>
              <.empty_state
                icon="hero-inbox"
                title={gettext("No active sessions")}
                description={gettext("There are currently no active sessions to display.")}
              />
            </.table_default_cell>
          </.table_default_row>
        <% else %>
          <%= for session <- @sessions do %>
            <.table_default_row>
              <.table_default_cell>
                <div class="flex items-center gap-2">
                  <%= if session.type == :authenticated do %>
                    <div class="badge badge-success badge-sm h-auto">
                      <.icon name="hero-shield-check" class="w-3 h-3 mr-1" /> {gettext("Auth")}
                    </div>
                  <% else %>
                    <div class="badge badge-warning badge-sm h-auto">
                      <.icon name="hero-user" class="w-3 h-3 mr-1" /> {gettext("Anon")}
                    </div>
                  <% end %>
                </div>
              </.table_default_cell>
              <.table_default_cell>
                <%= if session.type == :authenticated do %>
                  <% user = Map.get(@users_map, session.user_uuid) %>
                  <div class="flex items-center gap-2">
                    <.user_avatar user={user || %{email: session.user_email}} size="sm" peek />
                    <div>
                      <div class="font-medium text-sm">{session.user_email}</div>
                      <div class="text-xs text-base-content/70">ID: {session.user_uuid}</div>
                    </div>
                  </div>
                <% else %>
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-warning rounded-full flex items-center justify-center text-warning-content text-xs font-bold">
                      ?
                    </div>
                    <div>
                      <div class="font-medium text-sm">{gettext("Anonymous User")}</div>
                      <div class="text-xs text-base-content/70 font-mono">
                        {session.session_id}
                      </div>
                    </div>
                  </div>
                <% end %>
              </.table_default_cell>
              <.table_default_cell>
                <code class="text-xs bg-base-200 px-2 py-1 rounded">
                  {session.ip_address || gettext("Unknown")}
                </code>
              </.table_default_cell>
              <.table_default_cell>
                <%= if session.current_page do %>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded">
                    {session.current_page}
                  </code>
                <% else %>
                  <span class="text-base-content/50">—</span>
                <% end %>
              </.table_default_cell>
              <.table_default_cell>
                <.time_ago datetime={session.connected_at} />
              </.table_default_cell>
              <.table_default_cell>
                <div class="flex items-center gap-1">
                  <div class="w-2 h-2 bg-success rounded-full animate-pulse"></div>
                  <span class="text-xs text-success">{gettext("Active")}</span>
                </div>
              </.table_default_cell>
            </.table_default_row>
          <% end %>
        <% end %>
      </.table_default_body>
    </.table_default>

    <.pagination_bar
      id="live-sessions-pagination"
      page={@page}
      total_pages={@total_pages}
      total_count={@total_sessions}
      per_page={@per_page}
      auto={@auto_fit}
      table_id="live-sessions-table"
      noun_plural={gettext("sessions")}
      build_url={&url_state_path(assigns, page: &1)}
    />
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
