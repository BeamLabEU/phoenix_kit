<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_subtitle={gettext("Manage your account settings and preferences")}
  current_path={@url_path}
  project_title={@project_title}
  current_locale={assigns[:current_locale]}
>
  <div class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">
    <PhoenixKitWeb.Components.ProfileSettingsTabs.profile_tabs
      active={@tab}
      scope={assigns[:phoenix_kit_current_scope]}
    />
    <%!-- The media tab is offered to everyone (its annotation section     --%>
    <%!-- applies to anyone who can open the viewer); the libraries card   --%>
    <%!-- keeps the storage/user-libraries gate the tab itself used to     --%>
    <%!-- carry.                                                           --%>
    <div
      :if={@tab == "media" and Libraries.may_use_libraries?(@phoenix_kit_current_scope)}
      class="mb-8"
    >
      <.live_component
        module={PhoenixKitWeb.Live.Components.LibrarySettings}
        id="profile-library-settings"
        scope={@phoenix_kit_current_scope}
      />
    </div>
    <%!-- One component per tab: its sections load their data once, on mount. --%>
    <.live_component
      module={PhoenixKitWeb.Live.Components.UserSettings}
      id={"profile-user-settings-#{@tab}"}
      user={@phoenix_kit_current_user}
      sections={@sections}
      return_to={@url_path}
      current_session_token={@current_session_token}
      email_success_message={@email_success_message}
      email_error_message={@email_error_message}
    />
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
