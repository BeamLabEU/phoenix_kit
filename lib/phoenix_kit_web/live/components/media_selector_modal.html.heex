<dialog
  id={"media-selector-modal-backdrop-#{@id}"}
  class="fixed inset-0 z-[10001] m-0 h-full max-h-none w-full max-w-none overflow-y-auto border-0 bg-base-300/80 p-0 backdrop-blur-sm"
  phx-hook="PkDialog"
  data-show={to_string(@show)}
  data-close-event="close_modal"
  data-scope-folder={@scope_folder_id}
  phx-click="close_modal"
  phx-target={@myself}
  aria-labelledby={"media-selector-modal-title-#{@id}"}
>
  <%!-- Modal Container --%>
  <div class={container_class(@size)}>
    <%!-- Modal Content (click inside shouldn't close) --%>
    <div
      class={panel_class(@size)}
      phx-click="noop"
      phx-target={@myself}
    >
      <%!-- Header: title + hint left, Cancel/Confirm right. One row, no ✕ —
           Cancel IS the close (and Esc / backdrop-click still work via
           PkDialog), so a separate ✕ was the same action twice. On small
           screens the buttons wrap under the title, full-width. --%>
      <header class="border-b border-base-200 px-3 py-3 sm:px-6 sm:py-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2
              id={"media-selector-modal-title-#{@id}"}
              class="text-xl sm:text-2xl font-bold text-base-content"
            >
              {@title || default_title(assigns)}
            </h2>
            <p class="text-base-content/70 text-sm mt-1">
              {selection_hint(@mode, @file_type_filter)}
              <%= if @selected_uuids != [] do %>
                <span class="badge badge-primary ml-2">
                  <%= if @max_select && @mode == :multiple do %>
                    {gettext("%{count} of %{max} selected",
                      count: length(@selected_uuids),
                      max: @max_select
                    )}
                  <% else %>
                    {ngettext(
                      "%{count} selected",
                      "%{count} selected",
                      length(@selected_uuids),
                      count: length(@selected_uuids)
                    )}
                  <% end %>
                </span>
              <% end %>
              <%= if @limit_hit do %>
                <span class="badge badge-warning ml-2">
                  {gettext("Maximum %{count} files", count: @max_select)}
                </span>
              <% end %>
            </p>
          </div>
          <div class="flex gap-2 sm:shrink-0">
            <button
              type="button"
              phx-click="close_modal"
              phx-target={@myself}
              class="btn btn-outline btn-sm flex-1 sm:flex-none"
            >
              {gettext("Cancel")}
            </button>
            <button
              type="button"
              phx-click="confirm_selection"
              phx-target={@myself}
              class="btn btn-primary btn-sm flex-1 sm:flex-none"
              disabled={@selected_uuids == []}
            >
              <.icon name="hero-check" class="w-4 h-4" /> {gettext("Confirm")}
            </button>
          </div>
        </div>
      </header>
      <%!-- Scrollable Content Area --%>
      <div class="flex-1 overflow-y-auto px-3 py-3 sm:px-6 sm:py-4 space-y-4">
        <%!-- No Buckets Warning --%>
        <%= if !@has_buckets do %>
          <div class="alert alert-warning">
            <.icon name="hero-exclamation-triangle" class="stroke-current shrink-0 h-6 w-6" />
            <div>
              <h3 class="font-bold">{gettext("No Storage Buckets Configured")}</h3>
              <div class="text-sm mt-1">
                {gettext(
                  "You need to configure at least one storage bucket before you can upload files."
                )}
                <.link
                  navigate={PhoenixKit.Utils.Routes.path("/admin/settings/media")}
                  class="link link-primary font-semibold"
                >
                  {gettext("Configure Storage Buckets")}
                </.link>
              </div>
            </div>
          </div>
        <% end %>
        <%!-- Upload Section --%>
        <div class={[
          "card bg-base-200 shadow-md",
          !@has_buckets && "opacity-50 pointer-events-none"
        ]}>
          <div class="card-body p-4">
            <h3 class="font-semibold text-sm mb-3 flex items-center gap-2">
              <.icon name="hero-arrow-up-tray" class="w-4 h-4" /> {gettext("Upload New Files")}
            </h3>
            <%= if @has_buckets do %>
              <form
                id={"#{@id}-upload-form"}
                phx-change="validate"
                phx-submit="save"
                phx-target={@myself}
              >
                <%!-- Drag and Drop Zone --%>
                <div
                  class={[
                    "border-2 border-dashed border-base-300 rounded-lg p-3 sm:p-6 text-center transition-colors",
                    "cursor-pointer hover:border-primary hover:bg-primary/5"
                  ]}
                  phx-drop-target={@uploads.media_files.ref}
                >
                  <label for={@uploads.media_files.ref} class="cursor-pointer block">
                    <div class="flex flex-col items-center gap-2">
                      <.icon name="hero-cloud-arrow-up" class="w-8 h-8 text-primary" />
                      <div>
                        <p class="font-semibold text-base-content text-sm">
                          {gettext("Drag files here or click to browse")}
                        </p>
                        <p class="text-xs text-base-content/70 mt-1">
                          {accepted_types_hint(@file_type_filter)}
                        </p>
                      </div>
                    </div>
                  </label>
                  <.live_file_input upload={@uploads.media_files} class="hidden" />
                </div>

                <%!-- The upload queue: sends a few files at a time and lists each
                     with its own controls (pause, skip, cancel). --%>
                <.upload_manager
                  id={"#{@id}-upload-manager"}
                  upload={@uploads.media_files}
                  max_concurrent={PhoenixKit.Modules.Storage.max_concurrent_uploads()}
                  resumable={is_function(@uploads.media_files.external)}
                  dropzone={false}
                  layout={:inline}
                  scope="parent"
                  cancel_event="cancel_upload"
                  cancel_target={@myself}
                />
              </form>
            <% else %>
              <%!-- No buckets - show disabled upload area --%>
              <div class="border-2 border-dashed border-base-300 rounded-lg p-6 text-center opacity-50">
                <div class="flex flex-col items-center gap-2">
                  <.icon name="hero-cloud-arrow-up" class="w-8 h-8 text-base-content/50" />
                  <div>
                    <p class="font-semibold text-base-content/70 text-sm">
                      {gettext("Upload disabled")}
                    </p>
                    <p class="text-xs text-base-content/50 mt-1">
                      {gettext("Configure storage buckets to enable uploads")}
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <%!-- Library browse: search, type filter, grid, pagination. Hidden in
             upload-only mode (`browse: false`). NOT `class="contents"`: a
             display:contents box takes no margins, and the parent's
             `space-y-4` child selector can't reach through it — the grid sat
             flush against the search card. --%>
        <div :if={@browse} class="space-y-4">
          <%!-- Search and Filter Section. Hidden when it could do nothing:
               a locked picker over an empty, unsearched library has nothing
               to search and no filter to change. --%>
          <div :if={show_search_bar?(assigns)} class="card bg-base-200 shadow-md">
            <div class="card-body p-4">
              <div class="flex flex-col md:flex-row gap-3">
                <%!-- Search --%>
                <div class="flex-1">
                  <.form
                    for={%{}}
                    id={"media-selector-search-#{@id}"}
                    phx-submit="search"
                    phx-target={@myself}
                    class="w-full"
                  >
                    <div class="join w-full">
                      <.input
                        type="text"
                        name="search[query]"
                        value={@search_query}
                        placeholder={gettext("Search by filename...")}
                        class="input-sm join-item flex-1"
                        wrapper_class="contents"
                      />
                      <button
                        :if={@search_query != ""}
                        type="button"
                        phx-click="clear_search"
                        phx-target={@myself}
                        class="btn btn-ghost btn-sm join-item"
                        title={gettext("Clear search")}
                      >
                        <.icon name="hero-x-mark" class="w-4 h-4" />
                      </button>
                      <button type="submit" class="btn btn-primary btn-sm join-item">
                        <.icon name="hero-magnifying-glass" class="w-4 h-4" />
                      </button>
                    </div>
                  </.form>
                </div>
                <%!-- Filter by Type. Hidden when the picker is locked to one
                      type — a control whose only other options are refused
                      is worse than no control. --%>
                <div :if={not @lock_file_type} class="w-full md:w-40">
                  <.select
                    name="filter"
                    phx-change="filter_type"
                    phx-target={@myself}
                    value={@file_type_filter}
                    options={[
                      {gettext("All Files"), "all"},
                      {gettext("Images Only"), "image"},
                      {gettext("Videos Only"), "video"},
                      {gettext("Audio Only"), "audio"}
                    ]}
                    class="select-sm"
                  />
                </div>
              </div>
            </div>
          </div>
          <%!-- Media Grid. Two distinct empty states: a search that came up
               dry offers a way back (clear it); a genuinely empty library
               points at the dropzone instead of implying files are hiding
               behind better search terms. --%>
          <%= if Enum.empty?(@uploaded_files) do %>
            <%= if @search_query != "" do %>
              <div class="text-center py-10">
                <.icon
                  name="hero-magnifying-glass"
                  class="w-12 h-12 mx-auto mb-3 text-base-content/30"
                />
                <p class="text-sm text-base-content/70 mb-3">
                  {gettext("No results for “%{query}”", query: @search_query)}
                </p>
                <button
                  type="button"
                  phx-click="clear_search"
                  phx-target={@myself}
                  class="btn btn-ghost btn-sm"
                >
                  <.icon name="hero-x-mark" class="w-4 h-4" /> {gettext("Clear search")}
                </button>
              </div>
            <% else %>
              <div class="text-center py-10">
                <.icon
                  name={empty_icon(@file_type_filter)}
                  class="w-12 h-12 mx-auto mb-3 text-base-content/30"
                />
                <p class="text-sm text-base-content/70 mb-1">{empty_title(@file_type_filter)}</p>
                <p :if={@has_buckets} class="text-xs text-base-content/50">
                  {gettext("Upload your first one using the area above")}
                </p>
              </div>
            <% end %>
          <% else %>
            <%!-- One grid. With `group_by_folder` each folder's files follow a
                 heading tile in the same grid, so a small folder does not
                 leave the rest of its row empty; without it, just the files. --%>
            <div class={grid_class(@size)}>
              <%= for run <- file_runs(@uploaded_files, @current_page, @per_page) do %>
                <div
                  :if={run.group}
                  id={"media-selector-group-#{@id}-#{run.group.uuid}"}
                  data-media-group-heading={run.group.uuid}
                  class="rounded-lg border border-dashed border-base-300 bg-base-200/60 p-2 flex flex-col justify-center gap-1 min-w-0 min-h-24"
                >
                  <.icon name="hero-folder" class="w-5 h-5 text-base-content/50" />
                  <span class="text-xs font-semibold break-words" data-media-group-label>
                    {run.group.label}
                  </span>
                  <span class="text-[11px] text-base-content/60" data-media-group-count>
                    {ngettext("%{count} file", "%{count} files", run.group.count,
                      count: run.group.count
                    )}
                  </span>
                  <span
                    :if={run.continued?}
                    class="text-[11px] text-base-content/50"
                    data-continued
                  >
                    {gettext("continued")}
                  </span>
                </div>
                <%= for file <- run.files do %>
                  <% is_selected = file.file_uuid in @selected_uuids %>
                  <div
                    phx-click="toggle_selection"
                    phx-dblclick={@mode == :single && "quick_confirm"}
                    phx-value-file-uuid={file.file_uuid}
                    data-media-group={run.group && run.group.uuid}
                    phx-target={@myself}
                    class={[
                      "card bg-base-200 shadow-md cursor-pointer transition-all hover:shadow-lg",
                      is_selected && "ring-4 ring-primary"
                    ]}
                  >
                    <%!-- Card-size slot needs the card-tier variant: the
              default :small is the 150px thumbnail, and stretched
              across an aspect-square grid tile (~150-300px CSS,
              double on retina) it is the blur the boss reported
              (2026-08-31) — the same fix the media browser's grid
              already carries. --%>
                    <figure class="aspect-square bg-base-300 relative">
                      <.thumbnail_url :let={url} file={file} size={:card}>
                        <%= if url do %>
                          <img
                            src={url}
                            alt={Map.get(file, :alt) || file.filename}
                            class={["object-cover w-full h-full", rotation_class(file)]}
                          />
                        <% else %>
                          <div class="flex items-center justify-center w-full h-full">
                            <.icon name="hero-document" class="w-12 h-12 text-base-content/30" />
                          </div>
                        <% end %>
                      </.thumbnail_url>
                      <%!-- Selection Indicator --%>
                      <%= if is_selected do %>
                        <div class="absolute top-1 right-1 bg-primary text-primary-content rounded-full w-7 h-7 flex items-center justify-center">
                          <.icon name="hero-check" class="w-4 h-4" />
                        </div>
                      <% else %>
                        <div class="absolute top-1 right-1 bg-base-100/80 border-2 border-base-300 rounded-full w-7 h-7">
                        </div>
                      <% end %>
                      <%!-- File Type Badge --%>
                      <div class="absolute bottom-1 left-1">
                        <span class="badge badge-xs badge-neutral uppercase">
                          {file.file_type}
                        </span>
                      </div>
                    </figure>
                    <%!-- File Info --%>
                    <div class="card-body p-2">
                      <p class="text-xs font-semibold truncate" title={file.filename}>
                        {file.filename}
                      </p>
                      <div class="flex justify-between items-center text-[10px] text-base-content/60">
                        <span>{format_file_size(file.size)}</span>
                        <%= if file.width && file.height do %>
                          <span>{file.width}×{file.height}</span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
          <%!-- Pagination --%>
          <%= if @total_pages > 1 do %>
            <div class="flex justify-center pt-4">
              <div class="join">
                <%= if @current_page > 1 do %>
                  <button
                    type="button"
                    phx-click="change_page"
                    phx-value-page={@current_page - 1}
                    phx-target={@myself}
                    class="join-item btn btn-sm"
                  >
                    «
                  </button>
                <% else %>
                  <button class="join-item btn btn-sm btn-disabled">«</button>
                <% end %>

                <%= for page <- pagination_range(@current_page, @total_pages) do %>
                  <%= if page == :ellipsis do %>
                    <button class="join-item btn btn-sm btn-disabled">...</button>
                  <% else %>
                    <button
                      type="button"
                      phx-click="change_page"
                      phx-value-page={page}
                      phx-target={@myself}
                      class={[
                        "join-item btn btn-sm",
                        page == @current_page && "btn-active"
                      ]}
                    >
                      {page}
                    </button>
                  <% end %>
                <% end %>

                <%= if @current_page < @total_pages do %>
                  <button
                    type="button"
                    phx-click="change_page"
                    phx-value-page={@current_page + 1}
                    phx-target={@myself}
                    class="join-item btn btn-sm"
                  >
                    »
                  </button>
                <% else %>
                  <button class="join-item btn btn-sm btn-disabled">»</button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</dialog>
