<PhoenixKitWeb.Components.AuthPageWrapper.auth_page_wrapper
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  current_path={assigns[:url_path] || "/users/log-in"}
  dev_mailbox_message={gettext("confirmation emails")}
>
  <h1 class="text-2xl font-bold text-center mb-4">
    {gettext("Sign in to %{project_title}", project_title: @project_title)}
  </h1>

  <%!-- The other ways in, first: see `AuthMethods`. --%>
  <PhoenixKitWeb.Components.AuthMethods.auth_methods :if={
    @passkey_enabled or @magic_link_enabled or @qr_login_enabled or @oauth_providers != []
  }>
    <%!-- Passkey: the button for the browser's prompt. The same hook also
         starts the passkey suggestions in the email field as the page loads. --%>
    <div
      :if={@passkey_enabled}
      id="passkey-sign-in"
      phx-hook="PasskeySignIn"
      data-remember-me="#user_remember_me"
    >
      <button type="button" data-passkey-sign-in class="btn btn-outline w-full gap-2">
        <.icon name="hero-finger-print" class="w-5 h-5" />
        {gettext("Passkey")}
      </button>
    </div>
    <.link
      :if={@magic_link_enabled}
      navigate={Routes.path("/users/magic-link") <> Routes.return_to_query(@return_to)}
      class="btn btn-outline w-full gap-2"
    >
      <PhoenixKitWeb.Components.Core.Icons.icon_email class="w-5 h-5" />
      {gettext("Magic link")}
    </.link>
    <.link
      :if={@qr_login_enabled}
      navigate={Routes.path("/users/qr-login") <> Routes.return_to_query(@return_to)}
      class="btn btn-outline w-full gap-2"
    >
      <PhoenixKitWeb.Components.Core.Icons.icon_qr_code class="w-5 h-5" />
      {gettext("QR code")}
    </.link>
    <PhoenixKitWeb.Components.OAuthButtons.provider_links
      providers={@oauth_providers}
      return_to={@return_to}
    />
  </PhoenixKitWeb.Components.AuthMethods.auth_methods>

  <.form
    for={@form}
    id="login_form"
    action={Routes.path("/users/log-in")}
    phx-update="ignore"
  >
    <input :if={@return_to} type="hidden" name="user[return_to]" value={@return_to} />
    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend sr-only">{gettext("Login with Password")}</legend>

      <label class="label" for="user_email_or_username">
        <span class="fieldset-legend py-1">{gettext("Email or Username")}</span>
      </label>
      <.input
        type="text"
        id="user_email_or_username"
        name="user[email_or_username]"
        value={@form.params["email_or_username"] || ""}
        autocomplete={if @passkey_enabled, do: "username webauthn", else: "username"}
        required
      >
        <:icon>
          <PhoenixKitWeb.Components.Core.Icons.icon_user_profile class="h-[1em] w-[1em] opacity-50" />
        </:icon>
      </.input>

      <label class="label" for="user_password">
        <span class="fieldset-legend py-1">{gettext("Password")}</span>
      </label>
      <.input
        type="password"
        id="user_password"
        name="user[password]"
        value=""
        autocomplete="current-password"
        required
        password_toggle
      >
        <:icon>
          <PhoenixKitWeb.Components.Core.Icons.icon_lock class="h-[1em] w-[1em] opacity-50" />
        </:icon>
      </.input>

      <%!-- Checked by default (site-configurable); users can untick it for a
           session-only login, and the site can forbid persistence entirely. --%>
      <div :if={@remember_me_available} class="mt-1">
        <.checkbox
          id="user_remember_me"
          name="user[remember_me]"
          checked={@remember_me}
          label={gettext("Keep me logged in")}
        />
      </div>

      <div class="text-center mt-2">
        <.link
          navigate={Routes.path("/users/reset-password")}
          class="text-sm font-semibold text-primary hover:underline"
        >
          {gettext("Forgot your password?")}
        </.link>
      </div>

      <button
        type="submit"
        phx-disable-with={gettext("Logging in...")}
        class="btn btn-primary w-full mt-3 transition-all hover:scale-[1.02] active:scale-[0.98]"
      >
        <PhoenixKitWeb.Components.Core.Icons.icon_login class="w-5 h-5 mr-2" /> {gettext("Log in")}
        <span aria-hidden="true">→</span>
      </button>
    </fieldset>
  </.form>

  <%= if @allow_registration do %>
    <div class="text-center mt-3 text-sm">
      <span>{gettext("New to %{project_title}?", project_title: @project_title)}</span>
      <.link
        navigate={Routes.path("/users/register") <> Routes.return_to_query(@return_to)}
        class="font-semibold text-primary hover:underline"
      >
        {gettext("Create an account")}
      </.link>
    </div>
  <% end %>
</PhoenixKitWeb.Components.AuthPageWrapper.auth_page_wrapper>
