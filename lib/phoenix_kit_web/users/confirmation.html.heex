<PhoenixKitWeb.Components.AuthPageWrapper.auth_page_wrapper
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  current_path={assigns[:url_path] || "/users/confirm"}
>
  <%!-- Shown only until the LiveView connects: the account is confirmed on the
       connected mount and the visitor is sent on (see the module doc). --%>
  <div id="confirmation-pending" class="flex flex-col items-center gap-4 py-6" role="status">
    <span class="loading loading-spinner loading-lg text-primary" aria-hidden="true"></span>
    <p class="text-base-content/70">{gettext("Confirming...")}</p>
  </div>
</PhoenixKitWeb.Components.AuthPageWrapper.auth_page_wrapper>
