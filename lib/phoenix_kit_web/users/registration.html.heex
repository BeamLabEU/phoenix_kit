<PhoenixKitWeb.Components.AuthPageWrapper.auth_page_wrapper
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  current_path={assigns[:url_path] || "/users/register"}
  dev_mailbox_message={gettext("confirmation emails")}
>
  <h1 class="text-2xl font-bold text-center mb-4">
    {gettext("Join %{project_title} today", project_title: @project_title)}
  </h1>

  <%!-- Invitation banner: shown when user arrives via org invitation link --%>
  <%= if @pending_invitation do %>
    <div class="alert alert-info mb-4">
      <.icon name="hero-building-office-2" class="w-5 h-5 shrink-0" />
      <span>
        <%= if @pending_invitation.kind == :manager and @pending_invitation.relationship_type.can_manage do %>
          {gettext(
            "You've been invited to manage %{organization}. Create a personal account to accept the invitation.",
            organization: @pending_invitation.organization.organization_name
          )}
        <% else %>
          {gettext(
            "You've been invited to join %{organization}. Create an account to accept the invitation.",
            organization: @pending_invitation.organization.organization_name
          )}
        <% end %>
      </span>
    </div>
  <% end %>

  <%!-- The other ways in, first: see `AuthMethods`. --%>
  <% oauth_providers = PhoenixKitWeb.Components.OAuthButtons.enabled_providers() %>
  <PhoenixKitWeb.Components.AuthMethods.auth_methods :if={
    @magic_link_registration_enabled or oauth_providers != []
  }>
    <.link
      :if={@magic_link_registration_enabled}
      navigate={Routes.path("/users/register/magic-link") <> Routes.return_to_query(@return_to)}
      class="btn btn-outline w-full gap-2"
    >
      <PhoenixKitWeb.Components.Core.Icons.icon_email class="w-5 h-5" />
      {gettext("Magic link")}
    </.link>
    <PhoenixKitWeb.Components.OAuthButtons.provider_links
      providers={oauth_providers}
      return_to={@return_to}
    />
  </PhoenixKitWeb.Components.AuthMethods.auth_methods>

  <.form
    for={@form}
    id="registration_form"
    phx-submit="save"
    phx-change="validate"
    phx-trigger-action={@trigger_submit}
    action={Routes.path("/users/log-in?_action=registered")}
    method="post"
  >
    <input :if={@return_to} type="hidden" name="user[return_to]" value={@return_to} />

    <%!-- Silently captures the browser's UTC offset so new accounts start
         with a timezone instead of "Not set" — no UI, just a value the
         TimezoneOffset hook fills in before submit. Never overwrites an
         already-present value (e.g. a re-rendered form after a validation
         error), and users can always change it later in their settings. --%>
    <input
      type="hidden"
      name="user[user_timezone]"
      id="user_timezone_offset"
      phx-hook="TimezoneOffset"
      phx-update="ignore"
      value={Phoenix.HTML.Form.input_value(@form, :user_timezone)}
    />

    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend sr-only">{gettext("Account Information")}</legend>

      <div class={[
        @email_left && @email_errors != [] && "[&_label.input]:border-error"
      ]}>
        <label class="label" for="user_email">
          <span class="fieldset-legend py-1">{gettext("Email")}</span>
        </label>
        <%!-- Sent while typed, so the username below follows it live; its
             error waits until the person leaves the field (`email_left`):
             "must have the @ sign" while they are still typing it reads as a
             scolding. The error is rendered below, not by the input: see
             `email_field/1`. --%>
        <.input
          field={email_field(@form)}
          type="email"
          autocomplete="email"
          required
          phx-debounce="200"
          phx-blur="email_left"
        >
          <:icon>
            <PhoenixKitWeb.Components.Core.Icons.icon_email class="h-[1em] w-[1em] opacity-50" />
          </:icon>
        </.input>
        <div :if={@email_left} id="user_email-errors">
          <.error :for={msg <- @email_errors}>{msg}</.error>
        </div>
        <p :if={@email_suggestion && @email_left} id="email-suggestion" class="mt-1 text-sm">
          {gettext("Did you mean")}
          <button
            type="button"
            phx-click="use_email_suggestion"
            class="link link-primary font-medium break-all"
          >
            {@email_suggestion}
          </button>
          ?
        </p>
      </div>

      <%!-- Username Field (optional, controlled by admin setting) --%>
      <%= if @show_username do %>
        <div phx-feedback-for="user[username]">
          <label class="label" for="user_username">
            <span class="fieldset-legend py-1">{gettext("Username")}</span>
          </label>
          <.input field={@form[:username]} type="text" autocomplete="username">
            <:icon>
              <PhoenixKitWeb.Components.Core.Icons.icon_user_profile class="h-[1em] w-[1em] opacity-50" />
            </:icon>
          </.input>
        </div>
      <% end %>

      <%!-- Referral Code Field (shown when referral codes are enabled) --%>
      <%= if @referral_codes_enabled do %>
        <div phx-feedback-for="referral_code">
          <.label for="referral_code">
            {gettext("Referral Code")}
            <%= if @referral_codes_required do %>
              *
            <% end %>
          </.label>
          <input
            id="referral_code"
            name="referral_code"
            type="text"
            class={[
              "input w-full",
              (@referral_code_error ||
                 (@check_errors && @referral_codes_required &&
                    (is_nil(@referral_code) || @referral_code == ""))) && "input-error"
            ]}
            value={@referral_code || ""}
            required={@referral_codes_required}
          />
          <%= if @referral_code_error do %>
            <.error>{@referral_code_error}</.error>
          <% end %>
        </div>
      <% end %>

      <%!-- Account Type. Rendered only where there is a choice to make: the
           site can fix the type instead (organization accounts off, one of the
           single-type registration modes, or an organization invitation), and
           then the picker is one dead question. Hiding it is cosmetic — the
           type is fixed server-side in `enforce_registration_account_type/2`
           regardless of what the payload carries. --%>
      <%= if @account_type_selectable do %>
        <div phx-feedback-for="user[account_type]">
          <label class="label" for="user_account_type">
            <span class="fieldset-legend py-1">{gettext("Account Type")}</span>
          </label>
          <select
            id="user_account_type"
            name="user[account_type]"
            class="select w-full"
          >
            <option
              value="person"
              selected={Phoenix.HTML.Form.input_value(@form, :account_type) != "organization"}
            >
              {gettext("Personal")}
            </option>
            <option
              value="organization"
              selected={Phoenix.HTML.Form.input_value(@form, :account_type) == "organization"}
            >
              {gettext("Organization")}
            </option>
          </select>
        </div>
      <% end %>

      <%!-- Organization Name — asked whenever the account being created is an
           organization, whether the visitor picked that above or the site fixed
           it for them. --%>
      <%= if Phoenix.HTML.Form.input_value(@form, :account_type) == "organization" do %>
        <div phx-feedback-for="user[organization_name]">
          <label class="label" for="user_organization_name">
            <span class="fieldset-legend py-1">{gettext("Organization Name")}</span>
          </label>
          <.input field={@form[:organization_name]} type="text" required>
            <:icon>
              <.icon name="hero-building-office" class="h-[1em] w-[1em] opacity-50" />
            </:icon>
          </.input>
        </div>
      <% end %>

      <div phx-feedback-for="user[password]">
        <label class="label" for="user_password">
          <span class="fieldset-legend py-1">{gettext("Password")}</span>
        </label>
        <.input
          field={@form[:password]}
          type="password"
          autocomplete="new-password"
          required
          password_toggle
          phx-debounce="blur"
        >
          <:icon>
            <PhoenixKitWeb.Components.Core.Icons.icon_lock class="h-[1em] w-[1em] opacity-50" />
          </:icon>
        </.input>
      </div>

      <%!-- Checked by default so a new account stays signed in on this device;
           without the persistent cookie the session rides a browser-session
           cookie that phones drop overnight. Users can untick it, and the
           site can change the default (or forbid persistence) in settings. --%>
      <div :if={@remember_me_available} class="mt-3">
        <.checkbox
          id="user_remember_me"
          name="user[remember_me]"
          checked={@remember_me}
          label={gettext("Keep me logged in")}
        />
      </div>

      <.turnstile_widget id="registration-turnstile" class="mt-3" />

      <button
        type="submit"
        class="btn btn-primary w-full mt-3 transition-all hover:scale-[1.02] active:scale-[0.98]"
      >
        <PhoenixKitWeb.Components.Core.Icons.icon_user_add class="w-5 h-5 mr-2" /> {gettext(
          "Create account"
        )}
        <span aria-hidden="true">→</span>
      </button>
    </fieldset>
  </.form>

  <%!-- Login link --%>
  <div class="text-center mt-3 text-sm">
    <span>{gettext("Already have an account?")}</span>
    <.link
      navigate={Routes.path("/users/log-in") <> Routes.return_to_query(@return_to)}
      class="font-semibold text-primary hover:underline"
    >
      {gettext("Sign in")}
    </.link>
  </div>
</PhoenixKitWeb.Components.AuthPageWrapper.auth_page_wrapper>
